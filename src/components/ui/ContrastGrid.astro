---
import { 
  calculateContrastRatio,
  getAccessibilityLevel,
  getContrastRatioColor, 
  getContrastRatioBackground
} from '../../utils/contrast';
import type { ColorPalette } from '../../utils/palettes';

export interface Props {
  palette: ColorPalette;
  mode: 'light' | 'dark';
}

const { palette, mode } = Astro.props;

// Colors to test against background
const colorKeys = [
  'foreground', 'primary', 'secondary', 'accent', 
  'muted', 'mutedForeground', 'destructive', 'success', 'warning'
];

// Color labels for display
const colorLabels: Record<string, string> = {
  foreground: 'Main Text',
  primary: 'Primary',
  secondary: 'Secondary',
  accent: 'Accent',
  muted: 'Muted BG',
  mutedForeground: 'Muted Text',
  destructive: 'Error',
  success: 'Success',
  warning: 'Warning'
};

// Get colors for current mode
const colors = palette[mode];
const backgroundColor = colors.background;

// Calculate contrast for each color against background
const contrastResults = colorKeys
  .filter(key => colors[key])
  .map(key => {
    const color = colors[key];
    const ratio = calculateContrastRatio(backgroundColor, color);
    const result = getAccessibilityLevel(ratio);
    return {
      key,
      color,
      label: colorLabels[key] || key,
      ...result
    };
  });

// Get ADA compliance icon
function getADAIcon(rating: string): string {
  switch (rating) {
    case 'AAA': return '✓✓✓';
    case 'AA': return '✓✓';
    case 'Large Text Only': return '⚠️';
    case 'Fail': return '❌';
    default: return '?';
  }
}
---

<div class="contrast-grid">
  <div class="grid-header">
    <h4 class="grid-title">{mode} Mode - Colors on Background</h4>
    <div class="background-swatch">
      <div class="color-swatch" style={`background-color: ${backgroundColor}`}></div>
      <span class="background-label">Background: {backgroundColor}</span>
    </div>
  </div>

  <div class="contrast-list">
    {contrastResults.map(result => (
      <div 
        class={`contrast-item ${result.key === 'foreground' ? 'main-text-item' : ''}`}
        style={`
          background-color: ${getContrastRatioBackground(result.ratio)};
          border-color: ${getContrastRatioColor(result.ratio)};
        `}
      >
        <div class="color-info">
          <div class="color-swatch" style={`background-color: ${result.color}`}></div>
          <div class="color-details">
            <span class="color-name">{result.label}</span>
            <code class="color-hex">{result.color}</code>
          </div>
        </div>
        
        <div class="contrast-info">
          <div class="ada-compliance">
            <span class="ada-icon">{getADAIcon(result.rating)}</span>
            <span class="ada-level">{result.level}</span>
          </div>
          <div class="contrast-ratio" style={`color: ${getContrastRatioColor(result.ratio)}`}>
            {result.ratio}:1
          </div>
          <div class="rating-text" style={`color: ${getContrastRatioColor(result.ratio)}`}>
            {result.rating}
          </div>
        </div>

        <!-- Preview text sample -->
        <div 
          class="text-preview"
          style={`background-color: ${backgroundColor}; color: ${result.color}`}
        >
          <span class="preview-normal">Sample text</span>
          <span class="preview-large">Large text</span>
        </div>
      </div>
    ))}
  </div>

  <!-- Legend -->
  <div class="contrast-legend">
    <h5>ADA Compliance Levels</h5>
    <div class="legend-items">
      <div class="legend-item">
        <span class="legend-icon">✓✓✓</span>
        <span>AAA - Enhanced (7.0:1+)</span>
      </div>
      <div class="legend-item">
        <span class="legend-icon">✓✓</span>
        <span>AA - Standard (4.5:1+)</span>
      </div>
      <div class="legend-item">
        <span class="legend-icon">⚠️</span>
        <span>AA18 - Large text only (3.0:1+)</span>
      </div>
      <div class="legend-item">
        <span class="legend-icon">❌</span>
        <span>Fail - Does not meet ADA (&lt;3.0:1)</span>
      </div>
    </div>
    <div class="main-text-note">
      <strong>📝 Main Text:</strong> The highlighted item shows the primary text-on-background contrast ratio, which is critical for overall accessibility.
    </div>
  </div>
</div>

<style>
  .contrast-grid {
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 1rem;
    background: white;
    margin-bottom: 1rem;
  }

  .grid-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #e5e7eb;
  }

  .grid-title {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: #374151;
    text-transform: capitalize;
  }

  .background-swatch {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .background-label {
    font-size: 0.75rem;
    color: #6b7280;
    font-family: 'Monaco', 'Consolas', monospace;
  }

  .contrast-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .contrast-item {
    display: grid;
    grid-template-columns: 1fr auto 200px;
    gap: 1rem;
    align-items: center;
    padding: 0.75rem;
    border-radius: 6px;
    border: 2px solid;
    transition: all 0.2s ease;
  }

  .contrast-item:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  }

  .main-text-item {
    border-width: 3px;
    border-style: solid;
    border-color: #8b5cf6;
    box-shadow: 0 0 0 2px rgba(139, 92, 246, 0.2);
  }

  .main-text-item:hover {
    border-color: #7c3aed;
    box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.3);
  }

  .color-info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .color-swatch {
    width: 32px;
    height: 32px;
    border-radius: 6px;
    border: 1px solid #d1d5db;
    flex-shrink: 0;
  }

  .color-details {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .color-name {
    font-weight: 600;
    color: #374151;
    font-size: 0.875rem;
  }

  .color-hex {
    font-family: 'Monaco', 'Consolas', monospace;
    font-size: 0.75rem;
    color: #6b7280;
    background: #f3f4f6;
    padding: 0.125rem 0.25rem;
    border-radius: 3px;
  }

  .contrast-info {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    text-align: center;
  }

  .ada-compliance {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .ada-icon {
    font-size: 1rem;
    font-weight: 700;
  }

  .ada-level {
    font-size: 0.75rem;
    font-weight: 600;
    color: #374151;
  }

  .contrast-ratio {
    font-size: 0.875rem;
    font-weight: 700;
  }

  .rating-text {
    font-size: 0.75rem;
    font-weight: 500;
  }

  .text-preview {
    padding: 0.75rem;
    border-radius: 4px;
    border: 1px solid #d1d5db;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .preview-normal {
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .preview-large {
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .contrast-legend {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid #e5e7eb;
  }

  .contrast-legend h5 {
    margin: 0 0 0.5rem 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: #374151;
  }

  .legend-items {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
  }

  .legend-icon {
    font-weight: 700;
    width: 2rem;
    text-align: center;
  }

  .main-text-note {
    padding: 0.5rem;
    background: #f8fafc;
    border-left: 4px solid #8b5cf6;
    border-radius: 4px;
    font-size: 0.75rem;
    color: #374151;
  }

  @media (max-width: 768px) {
    .contrast-item {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    
    .text-preview {
      padding: 0.5rem;
    }
    
    .legend-items {
      grid-template-columns: 1fr;
    }
    
    .main-text-item {
      border-width: 2px;
    }
  }
</style>
