  /* Responsive adjustments */
  @media (max-width: 768px) {
    .grid-container {
      grid-template-columns: 100px repeat(4, 1fr);
      font-size: 0.8rem;
    }

    .bg-header {
      padding: 0.25rem;
    }

    .cell-content {
      min-height: 50px;
    }

    .sample-text {
      font-size: 0.75rem;
    }

    .rating-badge {
      font-size: 0.625rem;
