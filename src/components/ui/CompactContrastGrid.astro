  .button-contrast-demo:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  }

  .button-demo-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

