---
interface Props {
  position?: 'top-right' | 'top-left' | 'bottom-right' | 'bottom-left';
  minimized?: boolean;
  title?: string;
}

const { 
  position = 'top-right', 
  minimized = false,
  title = 'Design System Customizer'
} = Astro.props;

const positionClasses = {
  'top-right': 'top-4 right-4',
  'top-left': 'top-4 left-4', 
  'bottom-right': 'bottom-4 right-4',
  'bottom-left': 'bottom-4 left-4'
};
---

<!-- Toggle Button (always visible) -->
<button 
  id="color-customizer-toggle" 
  class={`fixed ${positionClasses[position]} z-50 bg-gradient-to-r from-purple-500 to-blue-500 hover:from-purple-600 hover:to-blue-600 text-white p-3 rounded-full shadow-lg transition-all duration-200 hover:scale-105`}
  title="Open Color Customizer"
>
  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zM21 5a2 2 0 00-2-2h-4a2 2 0 00-2 2v12a4 4 0 004 4h4a2 2 0 002-2V5z"/>
  </svg>
</button>

<!-- Customizer Panel -->
<div 
  id="color-customizer-panel" 
  class={`fixed top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 z-50 bg-white dark:bg-gray-800 rounded-xl shadow-2xl border border-gray-200 dark:border-gray-700 w-96 max-h-[80vh] overflow-hidden transition-all duration-300 ${minimized ? 'scale-0 opacity-0' : 'scale-100 opacity-100'}`}
  style="display: none;"
>
  <!-- Header -->
  <div class="flex items-center justify-between p-4 border-b border-gray-200 dark:border-gray-700 bg-gradient-to-r from-purple-50 to-blue-50 dark:from-gray-800 dark:to-gray-700">
    <h3 class="text-lg font-semibold text-gray-900 dark:text-white flex items-center">
      <svg class="w-5 h-5 mr-2 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zM21 5a2 2 0 00-2-2h-4a2 2 0 00-2 2v12a4 4 0 004 4h4a2 2 0 002-2V5z"/>
      </svg>
      {title}
    </h3>
    <button id="close-customizer" class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 p-1 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-600 transition-colors">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>
  
  <!-- Content -->
  <div class="p-4 space-y-4 overflow-y-auto max-h-[60vh]">
    <!-- Primary Colors -->
    <div class="space-y-3">
      <h4 class="text-sm font-semibold text-gray-700 dark:text-gray-300 flex items-center">
        <div class="w-3 h-3 bg-gradient-to-r from-purple-400 to-blue-400 rounded-full mr-2"></div>
        Core Colors
      </h4>
      
      <div class="grid grid-cols-1 gap-3">
        <div class="color-control" data-variable="--color-primary" data-default="#818cf9">
          <label class="block text-sm font-medium text-gray-600 dark:text-gray-400 mb-1">Primary</label>
          <div class="flex items-center space-x-2">
            <input type="color" class="color-picker w-10 h-8 rounded border-2 border-gray-200 dark:border-gray-600 cursor-pointer">
            <input type="text" class="hex-input flex-1 px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-purple-500 focus:border-transparent">
            <div class="color-preview w-8 h-8 rounded border-2 border-gray-200 dark:border-gray-600"></div>
          </div>
        </div>

        <div class="color-control" data-variable="--color-secondary" data-default="#2f3848">
          <label class="block text-sm font-medium text-gray-600 dark:text-gray-400 mb-1">Secondary</label>
          <div class="flex items-center space-x-2">
            <input type="color" class="color-picker w-10 h-8 rounded border-2 border-gray-200 dark:border-gray-600 cursor-pointer">
            <input type="text" class="hex-input flex-1 px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-purple-500 focus:border-transparent">
            <div class="color-preview w-8 h-8 rounded border-2 border-gray-200 dark:border-gray-600"></div>
          </div>
        </div>

        <div class="color-control" data-variable="--color-accent" data-default="#f14444">
          <label class="block text-sm font-medium text-gray-600 dark:text-gray-400 mb-1">Accent</label>
          <div class="flex items-center space-x-2">
            <input type="color" class="color-picker w-10 h-8 rounded border-2 border-gray-200 dark:border-gray-600 cursor-pointer">
            <input type="text" class="hex-input flex-1 px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-purple-500 focus:border-transparent">
            <div class="color-preview w-8 h-8 rounded border-2 border-gray-200 dark:border-gray-600"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Background Colors -->
    <div class="space-y-3 pt-4 border-t border-gray-200 dark:border-gray-700">
      <h4 class="text-sm font-semibold text-gray-700 dark:text-gray-300 flex items-center">
        <div class="w-3 h-3 bg-gradient-to-r from-gray-400 to-gray-600 rounded-full mr-2"></div>
        Surface Colors
      </h4>
      
      <div class="grid grid-cols-1 gap-3">
        <div class="color-control" data-variable="--color-background" data-default="#ffffff">
          <label class="block text-sm font-medium text-gray-600 dark:text-gray-400 mb-1">Background</label>
          <div class="flex items-center space-x-2">
            <input type="color" class="color-picker w-10 h-8 rounded border-2 border-gray-200 dark:border-gray-600 cursor-pointer">
            <input type="text" class="hex-input flex-1 px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-purple-500 focus:border-transparent">
            <div class="color-preview w-8 h-8 rounded border-2 border-gray-200 dark:border-gray-600"></div>
          </div>
        </div>

        <div class="color-control" data-variable="--color-foreground" data-default="#0f172a">
          <label class="block text-sm font-medium text-gray-600 dark:text-gray-400 mb-1">Foreground</label>
          <div class="flex items-center space-x-2">
            <input type="color" class="color-picker w-10 h-8 rounded border-2 border-gray-200 dark:border-gray-600 cursor-pointer">
            <input type="text" class="hex-input flex-1 px-3 py-2 text-sm border border-gray-200 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-purple-500 focus:border-transparent">
            <div class="color-preview w-8 h-8 rounded border-2 border-gray-200 dark:border-gray-600"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Actions -->
    <div class="pt-4 border-t border-gray-200 dark:border-gray-700 space-y-2">
      <button id="reset-colors" class="w-full px-4 py-2 text-sm bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-300 rounded-lg transition-colors font-medium">
        Reset to Defaults
      </button>
      
      <button id="export-colors" class="w-full px-4 py-2 text-sm bg-gradient-to-r from-purple-500 to-blue-500 hover:from-purple-600 hover:to-blue-600 text-white rounded-lg transition-all font-medium">
        Export CSS Variables
      </button>

      <button id="save-preset" class="w-full px-4 py-2 text-sm bg-green-100 hover:bg-green-200 dark:bg-green-800 dark:hover:bg-green-700 text-green-700 dark:text-green-300 rounded-lg transition-colors font-medium">
        Save as Preset
      </button>
    </div>

    <!-- Presets -->
    <div class="pt-4 border-t border-gray-200 dark:border-gray-700">
      <h4 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">Quick Presets</h4>
      <div class="grid grid-cols-2 gap-2">
        <button class="preset-btn p-2 rounded-lg border border-gray-200 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors" 
                data-preset='{"--color-primary": "#3b82f6", "--color-secondary": "#1e40af", "--color-accent": "#ef4444"}'>
          <div class="flex space-x-1 mb-1">
            <div class="w-3 h-3 rounded" style="background: #3b82f6;"></div>
            <div class="w-3 h-3 rounded" style="background: #1e40af;"></div>
            <div class="w-3 h-3 rounded" style="background: #ef4444;"></div>
          </div>
          <span class="text-xs text-gray-600 dark:text-gray-400">Blue Theme</span>
        </button>
        
        <button class="preset-btn p-2 rounded-lg border border-gray-200 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors"
                data-preset='{"--color-primary": "#10b981", "--color-secondary": "#047857", "--color-accent": "#f59e0b"}'>
          <div class="flex space-x-1 mb-1">
            <div class="w-3 h-3 rounded" style="background: #10b981;"></div>
            <div class="w-3 h-3 rounded" style="background: #047857;"></div>
            <div class="w-3 h-3 rounded" style="background: #f59e0b;"></div>
          </div>
          <span class="text-xs text-gray-600 dark:text-gray-400">Green Theme</span>
        </button>
        
        <button class="preset-btn p-2 rounded-lg border border-gray-200 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors"
                data-preset='{"--color-primary": "#8b5cf6", "--color-secondary": "#7c3aed", "--color-accent": "#ec4899"}'>
          <div class="flex space-x-1 mb-1">
            <div class="w-3 h-3 rounded" style="background: #8b5cf6;"></div>
            <div class="w-3 h-3 rounded" style="background: #7c3aed;"></div>
            <div class="w-3 h-3 rounded" style="background: #ec4899;"></div>
          </div>
          <span class="text-xs text-gray-600 dark:text-gray-400">Purple Theme</span>
        </button>
        
        <button class="preset-btn p-2 rounded-lg border border-gray-200 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors"
                data-preset='{"--color-primary": "#f97316", "--color-secondary": "#ea580c", "--color-accent": "#dc2626"}'>
          <div class="flex space-x-1 mb-1">
            <div class="w-3 h-3 rounded" style="background: #f97316;"></div>
            <div class="w-3 h-3 rounded" style="background: #ea580c;"></div>
            <div class="w-3 h-3 rounded" style="background: #dc2626;"></div>
          </div>
          <span class="text-xs text-gray-600 dark:text-gray-400">Orange Theme</span>
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Background overlay -->
<div id="customizer-overlay" class="fixed inset-0 bg-black bg-opacity-50 z-40 transition-opacity duration-300" style="display: none;"></div>

<style>
  .color-picker {
    -webkit-appearance: none;
    border: none;
    cursor: pointer;
  }
  
  .color-picker::-webkit-color-swatch-wrapper {
    padding: 0;
    border-radius: 4px;
  }
  
  .color-picker::-webkit-color-swatch {
    border: none;
    border-radius: 4px;
  }

  .color-preview {
    pointer-events: none;
  }
</style>

<script>
  interface ColorControl {
    element: HTMLElement;
    variable: string;
    default: string;
    colorPicker: HTMLInputElement;
    hexInput: HTMLInputElement;
    preview: HTMLElement;
  }

  class ColorCustomizer {
    private controls: ColorControl[] = [];
    private panel: HTMLElement | null = null;
    private overlay: HTMLElement | null = null;
    private isOpen = false;

    constructor() {
      this.init();
    }

    private init() {
      this.panel = document.getElementById('color-customizer-panel');
      this.overlay = document.getElementById('customizer-overlay');
      
      this.setupControls();
      this.setupEventListeners();
      this.loadFromLocalStorage();
    }

    private setupControls() {
      const controlElements = document.querySelectorAll('.color-control');
      
      controlElements.forEach((element) => {
        const variable = element.getAttribute('data-variable');
        const defaultValue = element.getAttribute('data-default');
        const colorPicker = element.querySelector('.color-picker') as HTMLInputElement;
        const hexInput = element.querySelector('.hex-input') as HTMLInputElement;
        const preview = element.querySelector('.color-preview') as HTMLElement;
        
        if (variable && defaultValue && colorPicker && hexInput && preview) {
          const control: ColorControl = {
            element: element as HTMLElement,
            variable,
            default: defaultValue,
            colorPicker,
            hexInput,
            preview
          };
          
          this.controls.push(control);
          this.initializeControl(control);
        }
      });
    }

    private initializeControl(control: ColorControl) {
      // Set initial values
      control.colorPicker.value = control.default;
      control.hexInput.value = control.default;
      control.preview.style.backgroundColor = control.default;
      
      // Color picker events
      control.colorPicker.addEventListener('input', (e) => {
        const value = (e.target as HTMLInputElement).value;
        control.hexInput.value = value;
        control.preview.style.backgroundColor = value;
        this.updateCSSVariable(control.variable, value);
        this.saveToLocalStorage();
      });

      // Hex input events
      control.hexInput.addEventListener('input', (e) => {
        const value = (e.target as HTMLInputElement).value;
        if (this.isValidHex(value)) {
          control.colorPicker.value = value;
          control.preview.style.backgroundColor = value;
          this.updateCSSVariable(control.variable, value);
          this.saveToLocalStorage();
        }
      });

      control.hexInput.addEventListener('blur', (e) => {
        const value = (e.target as HTMLInputElement).value;
        if (!this.isValidHex(value)) {
          control.hexInput.value = control.colorPicker.value;
        }
      });
    }

    private setupEventListeners() {
      // Toggle button
      const toggleBtn = document.getElementById('color-customizer-toggle');
      if (toggleBtn) {
        toggleBtn.addEventListener('click', () => this.toggle());
      }

      // Close button
      const closeBtn = document.getElementById('close-customizer');
      if (closeBtn) {
        closeBtn.addEventListener('click', () => this.close());
      }

      // Overlay click
      if (this.overlay) {
        this.overlay.addEventListener('click', () => this.close());
      }

      // Reset button
      const resetBtn = document.getElementById('reset-colors');
      if (resetBtn) {
        resetBtn.addEventListener('click', () => this.resetToDefaults());
      }

      // Export button
      const exportBtn = document.getElementById('export-colors');
      if (exportBtn) {
        exportBtn.addEventListener('click', () => this.exportColors());
      }

      // Save preset button
      const saveBtn = document.getElementById('save-preset');
      if (saveBtn) {
        saveBtn.addEventListener('click', () => this.savePreset());
      }

      // Preset buttons
      const presetBtns = document.querySelectorAll('.preset-btn');
      presetBtns.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const preset = (e.currentTarget as HTMLElement).getAttribute('data-preset');
          if (preset) {
            this.applyPreset(JSON.parse(preset));
          }
        });
      });

      // Escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && this.isOpen) {
          this.close();
        }
      });
    }

    private toggle() {
      if (this.isOpen) {
        this.close();
      } else {
        this.open();
      }
    }

    private open() {
      if (this.panel && this.overlay) {
        this.panel.style.display = 'block';
        this.overlay.style.display = 'block';
        
        // Trigger reflow for animation
        this.panel.offsetHeight;
        this.overlay.offsetHeight;
        
        this.panel.style.opacity = '1';
        this.panel.style.transform = 'translate(-50%, -50%) scale(1)';
        this.overlay.style.opacity = '1';
        
        this.isOpen = true;
        document.body.style.overflow = 'hidden';
      }
    }

    private close() {
      if (this.panel && this.overlay) {
        this.panel.style.opacity = '0';
        this.panel.style.transform = 'translate(-50%, -50%) scale(0.95)';
        this.overlay.style.opacity = '0';
        
        setTimeout(() => {
          if (this.panel && this.overlay) {
            this.panel.style.display = 'none';
            this.overlay.style.display = 'none';
          }
        }, 300);
        
        this.isOpen = false;
        document.body.style.overflow = '';
      }
    }

    private updateCSSVariable(variable: string, value: string) {
      document.documentElement.style.setProperty(variable, value);
    }

    private resetToDefaults() {
      this.controls.forEach((control) => {
        control.colorPicker.value = control.default;
        control.hexInput.value = control.default;
        control.preview.style.backgroundColor = control.default;
        this.updateCSSVariable(control.variable, control.default);
      });
      this.saveToLocalStorage();
    }

    private applyPreset(preset: Record<string, string>) {
      this.controls.forEach((control) => {
        const value = preset[control.variable] || control.default;
        control.colorPicker.value = value;
        control.hexInput.value = value;
        control.preview.style.backgroundColor = value;
        this.updateCSSVariable(control.variable, value);
      });
      this.saveToLocalStorage();
    }

    private exportColors() {
      const variables = this.controls.map((control) => 
        `    ${control.variable}: ${control.hexInput.value};`
      ).join('\n');
      
      const css = `:root {\n${variables}\n}`;
      
      navigator.clipboard.writeText(css).then(() => {
        const exportBtn = document.getElementById('export-colors');
        if (exportBtn) {
          const originalText = exportBtn.textContent;
          exportBtn.textContent = 'Copied!';
          setTimeout(() => {
            exportBtn.textContent = originalText;
          }, 2000);
        }
      });
    }

    private savePreset() {
      const name = prompt('Enter a name for this preset:');
      if (name) {
        const preset: Record<string, string> = {};
        this.controls.forEach((control) => {
          preset[control.variable] = control.hexInput.value;
        });
        
        const presets = JSON.parse(localStorage.getItem('color-presets') || '{}');
        presets[name] = preset;
        localStorage.setItem('color-presets', JSON.stringify(presets));
        
        alert(`Preset "${name}" saved!`);
      }
    }

    private saveToLocalStorage() {
      const colors: Record<string, string> = {};
      this.controls.forEach((control) => {
        colors[control.variable] = control.hexInput.value;
      });
      localStorage.setItem('custom-colors', JSON.stringify(colors));
    }

    private loadFromLocalStorage() {
      const saved = localStorage.getItem('custom-colors');
      if (saved) {
        try {
          const colors = JSON.parse(saved);
          this.controls.forEach((control) => {
            const savedValue = colors[control.variable];
            if (savedValue) {
              control.colorPicker.value = savedValue;
              control.hexInput.value = savedValue;
              control.preview.style.backgroundColor = savedValue;
              this.updateCSSVariable(control.variable, savedValue);
            }
          });
        } catch (e) {
          console.warn('Failed to load saved colors:', e);
        }
      }
    }

    private isValidHex(hex: string): boolean {
      return /^#[0-9A-F]{6}$/i.test(hex);
    }
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => new ColorCustomizer());
  } else {
    new ColorCustomizer();
  }
</script>
