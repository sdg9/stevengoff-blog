---
// Advanced Color Customizer Component
// Allows real-time customization of CSS custom properties from CustomStyles.astro
---

<!-- Toggle Button -->
<button
  id="advanced-color-toggle"
  class="fixed bottom-4 right-4 z-50 bg-blue-600 hover:bg-blue-700 text-white p-3 rounded-full shadow-lg transition-all duration-300 hover:scale-110"
  title="Open Color Customizer"
  aria-label="Open Advanced Color Customizer"
>
  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
    <path
      d="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9c.83 0 1.5-.67 1.5-1.5 0-.39-.15-.74-.39-1.01-.23-.26-.38-.61-.38-.99 0-.83.67-1.5 1.5-1.5H16c2.76 0 5-2.24 5-5 0-4.42-4.03-8-9-8zm-5.5 9c-.83 0-1.5-.67-1.5-1.5S5.67 9 6.5 9 8 9.67 8 10.5 7.33 12 6.5 12zm3-4C8.67 8 8 7.33 8 6.5S8.67 5 9.5 5s1.5.67 1.5 1.5S10.33 8 9.5 8zm5 0c-.83 0-1.5-.67-1.5-1.5S13.67 5 14.5 5s1.5.67 1.5 1.5S15.33 8 14.5 8zm3 4c-.83 0-1.5-.67-1.5-1.5S16.67 9 17.5 9s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"
    ></path>
  </svg>
</button>

<!-- Color Customizer Panel -->
<div
  id="advanced-color-panel"
  class="fixed inset-4 md:inset-auto md:top-1/2 md:left-1/2 md:-translate-x-1/2 md:-translate-y-1/2 z-50 bg-white dark:bg-gray-800 rounded-lg shadow-2xl border border-gray-200 dark:border-gray-700 opacity-0 pointer-events-none transition-all duration-300 max-w-full md:max-w-md w-auto md:w-96"
  style="transform: scale(0.8); transform-origin: center;"
>
  <!-- Header -->
  <div class="flex items-center justify-between p-4 border-b border-gray-200 dark:border-gray-700">
    <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Color Customizer</h3>
    <button
      id="advanced-color-close"
      class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors"
      aria-label="Close Color Customizer"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
        <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
        ></path>
      </svg>
    </button>
  </div>

  <!-- Content -->
  <div class="p-4 max-h-[calc(100vh-12rem)] md:max-h-[60vh] overflow-y-auto">
    <!-- Color Controls -->
    <div class="space-y-4">
      <!-- Primary Color -->
      <div class="space-y-2">
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Primary Color</label>
        <div class="flex gap-2 items-center">
          <input
            type="color"
            id="primary-color-picker"
            value="#2563eb"
            class="w-12 h-10 rounded border border-gray-300 dark:border-gray-600 cursor-pointer color-picker"
            data-color="primary"
            draggable="true"
          />
          <input
            type="text"
            id="primary-color-hex"
            value="#2563eb"
            placeholder="#2563eb"
            class="flex-1 px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md text-sm bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          />
          <button
            class="swap-mode-btn p-2 text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors rounded"
            data-color="primary"
            title="Click to enter swap mode for Primary color"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M6.99 11L3 15l3.99 4v-3H14v-2H6.99v-3zM21 9l-3.99-4v3H10v2h7.01v3L21 9z"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Secondary Color -->
      <div class="space-y-2">
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Secondary Color</label>
        <div class="flex gap-2 items-center">
          <input
            type="color"
            id="secondary-color-picker"
            value="#7c3aed"
            class="w-12 h-10 rounded border border-gray-300 dark:border-gray-600 cursor-pointer color-picker"
            data-color="secondary"
            draggable="true"
          />
          <input
            type="text"
            id="secondary-color-hex"
            value="#7c3aed"
            placeholder="#7c3aed"
            class="flex-1 px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md text-sm bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          />
          <button
            class="swap-mode-btn p-2 text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors rounded"
            data-color="secondary"
            title="Click to enter swap mode for Secondary color"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M6.99 11L3 15l3.99 4v-3H14v-2H6.99v-3zM21 9l-3.99-4v3H10v2h7.01v3L21 9z"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Accent Color -->
      <div class="space-y-2">
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Accent Color</label>
        <div class="flex gap-2 items-center">
          <input
            type="color"
            id="accent-color-picker"
            value="#059669"
            class="w-12 h-10 rounded border border-gray-300 dark:border-gray-600 cursor-pointer color-picker"
            data-color="accent"
            draggable="true"
          />
          <input
            type="text"
            id="accent-color-hex"
            value="#059669"
            placeholder="#059669"
            class="flex-1 px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md text-sm bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          />
          <button
            class="swap-mode-btn p-2 text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors rounded"
            data-color="accent"
            title="Click to enter swap mode for Accent color"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M6.99 11L3 15l3.99 4v-3H14v-2H6.99v-3zM21 9l-3.99-4v3H10v2h7.01v3L21 9z"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Background Color -->
      <div class="space-y-2">
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Background Color</label>
        <div class="flex gap-2 items-center">
          <input
            type="color"
            id="background-color-picker"
            value="#ffffff"
            class="w-12 h-10 rounded border border-gray-300 dark:border-gray-600 cursor-pointer color-picker"
            data-color="background"
            draggable="true"
          />
          <input
            type="text"
            id="background-color-hex"
            value="#ffffff"
            placeholder="#ffffff"
            class="flex-1 px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md text-sm bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          />
          <button
            class="swap-mode-btn p-2 text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors rounded"
            data-color="background"
            title="Click to enter swap mode for Background color"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M6.99 11L3 15l3.99 4v-3H14v-2H6.99v-3zM21 9l-3.99-4v3H10v2h7.01v3L21 9z"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Foreground Color -->
      <div class="space-y-2">
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Foreground Color</label>
        <div class="flex gap-2 items-center">
          <input
            type="color"
            id="foreground-color-picker"
            value="#1f2937"
            class="w-12 h-10 rounded border border-gray-300 dark:border-gray-600 cursor-pointer color-picker"
            data-color="foreground"
            draggable="true"
          />
          <input
            type="text"
            id="foreground-color-hex"
            value="#1f2937"
            placeholder="#1f2937"
            class="flex-1 px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md text-sm bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          />
          <button
            class="swap-mode-btn p-2 text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors rounded"
            data-color="foreground"
            title="Click to enter swap mode for Foreground color"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M6.99 11L3 15l3.99 4v-3H14v-2H6.99v-3zM21 9l-3.99-4v3H10v2h7.01v3L21 9z"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Swap Mode Indicator -->
    <div
      id="swap-mode-indicator"
      class="mt-4 p-3 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg hidden"
    >
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 bg-blue-500 rounded-full animate-pulse"></div>
          <span class="text-sm font-medium text-blue-800 dark:text-blue-200" id="swap-mode-text">
            Swap mode active: Click another color to swap
          </span>
        </div>
        <button
          id="cancel-swap-mode"
          class="text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-200 text-sm"
        >
          Cancel
        </button>
      </div>
    </div>

    <!-- Preset Themes -->
    <div class="mt-6">
      <h4 class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-3">Preset Themes</h4>
      <div class="grid grid-cols-2 gap-2">
        <button
          class="preset-theme px-3 py-2 text-sm bg-blue-100 hover:bg-blue-200 text-blue-800 rounded transition-colors"
          data-theme="blue"
        >
          Blue Theme
        </button>
        <button
          class="preset-theme px-3 py-2 text-sm bg-green-100 hover:bg-green-200 text-green-800 rounded transition-colors"
          data-theme="green"
        >
          Green Theme
        </button>
        <button
          class="preset-theme px-3 py-2 text-sm bg-purple-100 hover:bg-purple-200 text-purple-800 rounded transition-colors"
          data-theme="purple"
        >
          Purple Theme
        </button>
        <button
          class="preset-theme px-3 py-2 text-sm bg-orange-100 hover:bg-orange-200 text-orange-800 rounded transition-colors"
          data-theme="orange"
        >
          Orange Theme
        </button>
      </div>
    </div>

    <!-- Coolors Import -->
    <div class="mt-6">
      <h4 class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-3">Import from Coolors</h4>
      <div class="space-y-3">
        <input
          type="url"
          id="coolors-url"
          placeholder="https://coolors.co/palette/606c38-283618-fefae0-dda15e-bc6c25"
          class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md text-sm bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent"
        />
        <button
          id="import-coolors"
          class="w-full px-4 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-md transition-colors text-sm"
        >
          Import from Coolors
        </button>
      </div>
    </div>

    <!-- Quick Swaps -->
    <div class="mt-6">
      <h4 class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-3">Quick Swaps</h4>
      <div class="grid grid-cols-1 gap-2">
        <button
          class="quick-swap px-3 py-2 text-xs bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-300 rounded transition-colors"
          data-color1="background"
          data-color2="foreground"
        >
          🔄 Swap Background ↔ Foreground
        </button>
        <button
          class="quick-swap px-3 py-2 text-xs bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-300 rounded transition-colors"
          data-color1="primary"
          data-color2="secondary"
        >
          🔄 Swap Primary ↔ Secondary
        </button>
      </div>
      <p class="text-xs text-gray-500 dark:text-gray-400 mt-2">
        💡 Tip: Click the ⇄ icon next to any color to enter swap mode, then click another color to swap them.
      </p>
    </div>

    <!-- Action Buttons -->
    <div class="mt-6 space-y-3">
      <button
        id="reset-colors"
        class="w-full px-4 py-2 bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-300 rounded-md transition-colors text-sm"
      >
        Reset to Default
      </button>
      <button
        id="export-colors"
        class="w-full px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-md transition-colors text-sm"
      >
        Export CSS
      </button>
      <button
        id="test-swap"
        class="w-full px-4 py-2 bg-green-600 hover:bg-green-700 text-white rounded-md transition-colors text-sm"
      >
        Test Swap (Primary ↔ Accent)
      </button>
    </div>

    <!-- Live Preview -->
    <div class="mt-6 p-4 border border-gray-200 dark:border-gray-600 rounded-lg">
      <h4 class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Live Preview</h4>
      <div class="space-y-2">
        <div class="flex items-center gap-2">
          <div class="w-full h-4 rounded border border-gray-200" style="background-color: var(--color-primary);"></div>
          <span class="text-xs text-gray-500 min-w-[60px]">Primary</span>
        </div>
        <div class="flex items-center gap-2">
          <div class="w-full h-4 rounded border border-gray-200" style="background-color: var(--color-secondary);">
          </div>
          <span class="text-xs text-gray-500 min-w-[60px]">Secondary</span>
        </div>
        <div class="flex items-center gap-2">
          <div class="w-full h-4 rounded border border-gray-200" style="background-color: var(--color-accent);"></div>
          <span class="text-xs text-gray-500 min-w-[60px]">Accent</span>
        </div>
        <div class="flex items-center gap-2">
          <div class="w-full h-4 rounded border border-gray-200" style="background-color: var(--color-background);">
          </div>
          <span class="text-xs text-gray-500 min-w-[60px]">Background</span>
        </div>
        <div class="flex items-center gap-2">
          <div class="w-full h-4 rounded border border-gray-200" style="background-color: var(--color-foreground);">
          </div>
          <span class="text-xs text-gray-500 min-w-[60px]">Foreground</span>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Overlay -->
<div
  id="advanced-color-overlay"
  class="fixed inset-0 bg-black bg-opacity-50 z-40 opacity-0 pointer-events-none transition-opacity duration-300"
>
</div>

<style>
  /* Enhanced positioning for better mobile/desktop handling */
  #advanced-color-panel.open {
    opacity: 1;
    pointer-events: auto;
    transform: scale(1);
  }

  @media (min-width: 768px) {
    #advanced-color-panel.open {
      transform: translate(-50%, -50%) scale(1);
    }
  }

  #advanced-color-overlay.open {
    opacity: 1;
    pointer-events: auto;
  }

  /* Smooth color transitions for live preview */
  :root {
    transition:
      color 0.3s ease,
      background-color 0.3s ease;
  }

  /* Drag and drop styles */
  .color-picker {
    transition: all 0.2s ease;
  }

  .color-picker.dragging {
    opacity: 0.6;
    transform: scale(0.95);
    cursor: grabbing;
  }

  .color-picker.drag-over {
    border-color: #3b82f6;
    border-width: 2px;
    box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
  }

  .swap-mode-btn.active {
    background-color: #3b82f6;
    color: white;
  }

  .swap-mode-active .color-picker {
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .swap-mode-active .color-picker:hover {
    border-color: #3b82f6;
    box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
  }
</style>

<script>
  // Color Customizer Script
  (function () {
    'use strict';
    interface ColorTheme {
      primary: string;
      secondary: string;
      accent: string;
      background: string;
      foreground: string;
    }

    const defaultColors: ColorTheme = {
      primary: '#2563eb',
      secondary: '#7c3aed',
      accent: '#059669',
      background: '#ffffff',
      foreground: '#1f2937',
    };

    const presetThemes: Record<string, ColorTheme> = {
      blue: {
        primary: '#2563eb',
        secondary: '#1d4ed8',
        accent: '#0ea5e9',
        background: '#ffffff',
        foreground: '#1f2937',
      },
      green: {
        primary: '#059669',
        secondary: '#047857',
        accent: '#10b981',
        background: '#ffffff',
        foreground: '#1f2937',
      },
      purple: {
        primary: '#7c3aed',
        secondary: '#6d28d9',
        accent: '#8b5cf6',
        background: '#ffffff',
        foreground: '#1f2937',
      },
      orange: {
        primary: '#ea580c',
        secondary: '#dc2626',
        accent: '#f59e0b',
        background: '#ffffff',
        foreground: '#1f2937',
      },
    };

    function updateCSSVariable(property: string, value: string): void {
      console.log(`Updating CSS variable: ${property} = ${value}`);

      // Method 1: Use !important to override any static CSS on :root
      document.documentElement.style.setProperty(property, value, 'important');

      // Method 2: Create or update a dedicated style element for overrides
      // This handles both light and dark mode by overriding both :root and .dark
      let dynamicStyleEl = document.getElementById('dynamic-color-overrides') as HTMLStyleElement;
      if (!dynamicStyleEl) {
        dynamicStyleEl = document.createElement('style');
        dynamicStyleEl.id = 'dynamic-color-overrides';
        document.head.appendChild(dynamicStyleEl);
      }

      // Build CSS rules for both light and dark mode
      const existingText = dynamicStyleEl.textContent || '';
      const propertyRegex = new RegExp(`${property}:\\s*[^;]+;`, 'g');

      const newRules = `
:root { ${property}: ${value} !important; }
.dark { ${property}: ${value} !important; }
html.dark { ${property}: ${value} !important; }
body.dark { ${property}: ${value} !important; }
[data-theme="dark"] { ${property}: ${value} !important; }`;

      if (propertyRegex.test(existingText)) {
        // Replace existing rules for this property
        const lines = existingText.split('\n');
        const filteredLines = lines.filter((line) => !line.includes(property));
        dynamicStyleEl.textContent = filteredLines.join('\n') + newRules;
      } else {
        // Add new rules
        dynamicStyleEl.textContent = existingText + newRules;
      }

      // Verify the variable was set
      const applied = getComputedStyle(document.documentElement).getPropertyValue(property);
      console.log(`Verified CSS variable ${property}: ${applied.trim()}`);

      // Force a style recalculation
      void document.documentElement.offsetHeight;
    }

    function syncInputs(colorKey: keyof ColorTheme, value: string): void {
      const picker = document.getElementById(`${colorKey}-color-picker`) as HTMLInputElement;
      const hex = document.getElementById(`${colorKey}-color-hex`) as HTMLInputElement;

      console.log(`Syncing inputs for ${colorKey} to ${value}`);
      console.log(`Picker found: ${!!picker}, Hex found: ${!!hex}`);

      if (picker) {
        picker.value = value;
        console.log(`Updated ${colorKey} picker to: ${picker.value}`);
      } else {
        console.error(`Could not find picker for ${colorKey}`);
      }

      if (hex) {
        hex.value = value;
        console.log(`Updated ${colorKey} hex to: ${hex.value}`);
      } else {
        console.error(`Could not find hex input for ${colorKey}`);
      }
    }

    function applyColors(colors: ColorTheme): void {
      console.log('Applying colors:', colors);
      Object.entries(colors).forEach(([key, value]) => {
        const property = `--color-${key}`;
        console.log(`Setting ${property} to ${value}`);
        updateCSSVariable(property, value);
        syncInputs(key as keyof ColorTheme, value);
      });
    }

    function getCurrentColors(): ColorTheme {
      return {
        primary: (document.getElementById('primary-color-hex') as HTMLInputElement)?.value || defaultColors.primary,
        secondary:
          (document.getElementById('secondary-color-hex') as HTMLInputElement)?.value || defaultColors.secondary,
        accent: (document.getElementById('accent-color-hex') as HTMLInputElement)?.value || defaultColors.accent,
        background:
          (document.getElementById('background-color-hex') as HTMLInputElement)?.value || defaultColors.background,
        foreground:
          (document.getElementById('foreground-color-hex') as HTMLInputElement)?.value || defaultColors.foreground,
      };
    }

    function saveToLocalStorage(): void {
      const colors = getCurrentColors();
      localStorage.setItem('customColors', JSON.stringify(colors));
    }

    function loadFromLocalStorage(): ColorTheme | null {
      const saved = localStorage.getItem('customColors');
      return saved ? (JSON.parse(saved) as ColorTheme) : null;
    }

    function exportCSS(): void {
      const colors = getCurrentColors();
      const css = `:root {\n${Object.entries(colors)
        .map(([key, value]) => `  --color-${key}: ${value};`)
        .join('\n')}\n}`;

      // Copy to clipboard
      navigator.clipboard
        .writeText(css)
        .then(() => {
          // Show feedback
          const button = document.getElementById('export-colors');
          if (button) {
            const originalText = button.textContent;
            button.textContent = 'Copied!';
            button.classList.add('bg-green-600', 'hover:bg-green-700');
            button.classList.remove('bg-blue-600', 'hover:bg-blue-700');

            setTimeout(() => {
              button.textContent = originalText;
              button.classList.remove('bg-green-600', 'hover:bg-green-700');
              button.classList.add('bg-blue-600', 'hover:bg-blue-700');
            }, 2000);
          }
        })
        .catch(() => {
          console.error('Failed to copy CSS to clipboard');
        });
    }

    function parseCoolorsUrl(url: string): string[] | null {
      try {
        // Handle different Coolors URL formats
        // https://coolors.co/palette/606c38-283618-fefae0-dda15e-bc6c25
        // https://coolors.co/606c38-283618-fefae0-dda15e-bc6c25

        const urlObj = new URL(url);

        if (!urlObj.hostname.includes('coolors.co')) {
          return null;
        }

        let colorString = '';

        // Extract colors from path
        const pathParts = urlObj.pathname.split('/');

        // Find the part that contains colors (hex codes separated by dashes)
        for (const part of pathParts) {
          if (part && part.match(/^[a-fA-F0-9-]+$/)) {
            colorString = part;
            break;
          }
        }

        if (!colorString) {
          return null;
        }

        // Split by dashes and validate hex codes
        const colors = colorString
          .split('-')
          .filter((color) => color.match(/^[a-fA-F0-9]{6}$/))
          .map((color) => `#${color}`);

        return colors.length >= 3 ? colors : null;
      } catch (error) {
        console.error('Error parsing Coolors URL:', error);
        return null;
      }
    }

    function importFromCoolors(): void {
      const urlInput = document.getElementById('coolors-url') as HTMLInputElement;
      const importButton = document.getElementById('import-coolors');

      if (!urlInput || !importButton) {
        return;
      }

      const url = urlInput.value.trim();

      if (!url) {
        showImportFeedback(importButton, 'Please enter a Coolors URL', 'error');
        return;
      }

      const colors = parseCoolorsUrl(url);

      if (!colors || colors.length < 3) {
        showImportFeedback(importButton, 'Invalid Coolors URL or not enough colors', 'error');
        return;
      }

      // Map the imported colors to our theme structure
      // Use the first 5 colors, or repeat/modify if fewer available
      const importedTheme: ColorTheme = {
        primary: colors[0] || defaultColors.primary,
        secondary: colors[1] || defaultColors.secondary,
        accent: colors[2] || defaultColors.accent,
        background: colors[3] || '#ffffff', // Default to white if not provided
        foreground: colors[4] || '#1f2937', // Default to dark gray if not provided
      };

      // If we only have 3 colors, use smart defaults for background/foreground
      if (colors.length === 3) {
        importedTheme.background = '#ffffff';
        importedTheme.foreground = '#1f2937';
      } else if (colors.length === 4) {
        // Use the 4th color as background, keep default foreground
        importedTheme.background = colors[3];
        importedTheme.foreground = '#1f2937';
      }

      // Apply the imported theme
      applyColors(importedTheme);
      saveToLocalStorage();

      showImportFeedback(importButton, 'Colors imported successfully!', 'success');

      console.log('Imported colors from Coolors:', colors);
      console.log('Applied theme:', importedTheme);
    }

    function showImportFeedback(button: HTMLElement, message: string, type: 'success' | 'error'): void {
      const originalText = button.textContent;
      button.textContent = message;

      if (type === 'success') {
        button.classList.add('bg-green-600', 'hover:bg-green-700');
        button.classList.remove('bg-purple-600', 'hover:bg-purple-700');
      } else {
        button.classList.add('bg-red-600', 'hover:bg-red-700');
        button.classList.remove('bg-purple-600', 'hover:bg-purple-700');
      }

      setTimeout(() => {
        button.textContent = originalText;
        button.classList.remove('bg-green-600', 'hover:bg-green-700', 'bg-red-600', 'hover:bg-red-700');
        button.classList.add('bg-purple-600', 'hover:bg-purple-700');
      }, 3000);
    }

    function swapColors(color1Key: keyof ColorTheme, color2Key: keyof ColorTheme): void {
      if (color1Key === color2Key) {
        console.log('Cannot swap color with itself');
        return; // Can't swap a color with itself
      }

      console.log(`=== STARTING SWAP: ${color1Key} ↔ ${color2Key} ===`);

      const currentColors = getCurrentColors();
      console.log('Current colors before swap:', currentColors);

      // Store the values to swap
      const color1Value = currentColors[color1Key];
      const color2Value = currentColors[color2Key];

      console.log(`Values to swap: ${color1Key}="${color1Value}" ↔ ${color2Key}="${color2Value}"`);

      if (!color1Value || !color2Value) {
        console.error('One of the color values is missing!', { color1Value, color2Value });
        return;
      }

      // Get input elements
      const picker1 = document.getElementById(`${color1Key}-color-picker`) as HTMLInputElement;
      const hex1 = document.getElementById(`${color1Key}-color-hex`) as HTMLInputElement;
      const picker2 = document.getElementById(`${color2Key}-color-picker`) as HTMLInputElement;
      const hex2 = document.getElementById(`${color2Key}-color-hex`) as HTMLInputElement;

      console.log('Found elements:', {
        picker1: !!picker1,
        hex1: !!hex1,
        picker2: !!picker2,
        hex2: !!hex2,
      });

      // Update CSS variables immediately
      console.log('Updating CSS variables...');
      updateCSSVariable(`--color-${color1Key}`, color2Value);
      updateCSSVariable(`--color-${color2Key}`, color1Value);

      // Update input values directly
      console.log('Updating input values...');
      if (picker1) {
        picker1.value = color2Value;
        console.log(`Set ${color1Key} picker to: ${picker1.value}`);
      }
      if (hex1) {
        hex1.value = color2Value;
        console.log(`Set ${color1Key} hex to: ${hex1.value}`);
      }
      if (picker2) {
        picker2.value = color1Value;
        console.log(`Set ${color2Key} picker to: ${picker2.value}`);
      }
      if (hex2) {
        hex2.value = color1Value;
        console.log(`Set ${color2Key} hex to: ${hex2.value}`);
      }

      // Verify the swap worked
      setTimeout(() => {
        const newColors = getCurrentColors();
        console.log('Colors after swap:', newColors);
        console.log(`Verification: ${color1Key} is now "${newColors[color1Key]}" (should be "${color2Value}")`);
        console.log(`Verification: ${color2Key} is now "${newColors[color2Key]}" (should be "${color1Value}")`);

        // Save to localStorage
        saveToLocalStorage();
        console.log('=== SWAP COMPLETE ===');
      }, 50);
    }

    function setupDragAndDropSwap(): void {
      const colorPickers = document.querySelectorAll('.color-picker');
      let isSwapping = false; // Prevent duplicate swaps
      let swapTimeout: number | null = null;

      colorPickers.forEach((picker) => {
        const element = picker as HTMLInputElement;

        // Drag start
        element.addEventListener('dragstart', (e) => {
          const dragEvent = e as DragEvent;
          const colorKey = element.getAttribute('data-color');
          if (dragEvent.dataTransfer && colorKey) {
            dragEvent.dataTransfer.setData('text/plain', colorKey);
            element.classList.add('dragging');
            console.log(`Drag started for ${colorKey}`);
            isSwapping = false; // Reset swap flag
          }
        });

        // Drag end
        element.addEventListener('dragend', () => {
          element.classList.remove('dragging');
          console.log('Drag ended');

          // Reset swap flag after a delay to prevent immediate re-swaps
          setTimeout(() => {
            isSwapping = false;
          }, 200);
        });

        // Drag over
        element.addEventListener('dragover', (e) => {
          e.preventDefault();
          element.classList.add('drag-over');
        });

        // Drag leave
        element.addEventListener('dragleave', () => {
          element.classList.remove('drag-over');
        });

        // Drop
        element.addEventListener('drop', (e) => {
          e.preventDefault();
          e.stopPropagation();
          e.stopImmediatePropagation(); // Prevent other drop handlers
          const dragEvent = e as DragEvent;
          element.classList.remove('drag-over');

          // Prevent duplicate swaps
          if (isSwapping) {
            console.log('Swap already in progress, ignoring duplicate drop');
            return;
          }

          if (dragEvent.dataTransfer) {
            const sourceColor = dragEvent.dataTransfer.getData('text/plain') as keyof ColorTheme;
            const targetColor = element.getAttribute('data-color') as keyof ColorTheme;

            console.log(`Drop detected: ${sourceColor} -> ${targetColor}`);

            if (sourceColor && targetColor && sourceColor !== targetColor) {
              isSwapping = true; // Set swap flag

              // Clear any existing timeout
              if (swapTimeout) {
                window.clearTimeout(swapTimeout);
              }

              // Debounce the swap to prevent rapid fire
              swapTimeout = window.setTimeout(() => {
                // Prevent any color picker events during swap
                element.blur();
                document.getElementById(`${sourceColor}-color-picker`)?.blur();

                swapColors(sourceColor, targetColor);
                showSwapFeedback(sourceColor, targetColor);

                // Reset swap flag after swap is complete
                setTimeout(() => {
                  isSwapping = false;
                }, 100);
              }, 50);
            }
          }
        });

        // Prevent color picker from opening during drag operations
        element.addEventListener('click', (e) => {
          if (element.classList.contains('dragging') || isSwapping) {
            e.preventDefault();
            e.stopPropagation();
          }
        });
      });
    }

    function setupClickSwapMode(): void {
      let swapModeActive = false;
      let sourceColor: keyof ColorTheme | null = null;

      const swapModeIndicator = document.getElementById('swap-mode-indicator');
      const swapModeText = document.getElementById('swap-mode-text');
      const cancelSwapButton = document.getElementById('cancel-swap-mode');
      const panel = document.getElementById('advanced-color-panel');

      function exitSwapMode(): void {
        swapModeActive = false;
        sourceColor = null;
        swapModeIndicator?.classList.add('hidden');
        panel?.classList.remove('swap-mode-active');

        // Remove active state from all swap buttons
        document.querySelectorAll('.swap-mode-btn').forEach((btn) => {
          btn.classList.remove('active');
        });
      }

      function enterSwapMode(colorKey: keyof ColorTheme): void {
        swapModeActive = true;
        sourceColor = colorKey;
        swapModeIndicator?.classList.remove('hidden');
        panel?.classList.add('swap-mode-active');

        if (swapModeText) {
          swapModeText.textContent = `Swap mode: ${colorKey} selected. Click another color to swap.`;
        }

        // Highlight the active swap button
        document.querySelectorAll('.swap-mode-btn').forEach((btn) => {
          btn.classList.remove('active');
          if (btn.getAttribute('data-color') === colorKey) {
            btn.classList.add('active');
          }
        });
      }

      // Swap mode buttons
      document.querySelectorAll('.swap-mode-btn').forEach((button) => {
        button.addEventListener('click', (e) => {
          e.preventDefault();
          const colorKey = (e.target as HTMLElement)
            .closest('.swap-mode-btn')
            ?.getAttribute('data-color') as keyof ColorTheme;

          if (colorKey) {
            if (swapModeActive && sourceColor === colorKey) {
              // Clicking the same button exits swap mode
              exitSwapMode();
            } else {
              enterSwapMode(colorKey);
            }
          }
        });
      });

      // Color picker clicks in swap mode
      document.querySelectorAll('.color-picker').forEach((picker) => {
        picker.addEventListener('click', (e) => {
          if (swapModeActive) {
            e.preventDefault();
            e.stopPropagation();
            const targetColor = (e.target as HTMLElement).getAttribute('data-color') as keyof ColorTheme;

            if (targetColor && sourceColor && targetColor !== sourceColor) {
              // Blur the picker to prevent color picker dialog
              (e.target as HTMLInputElement).blur();

              swapColors(sourceColor, targetColor);
              showSwapFeedback(sourceColor, targetColor);
              exitSwapMode();
            }
          }
        });
      });

      // Cancel swap mode
      cancelSwapButton?.addEventListener('click', exitSwapMode);

      // Exit swap mode on escape
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && swapModeActive) {
          exitSwapMode();
        }
      });
    }

    function showSwapFeedback(color1: keyof ColorTheme, color2: keyof ColorTheme): void {
      // Create temporary feedback element
      const feedback = document.createElement('div');
      feedback.className =
        'fixed top-4 right-4 z-[60] bg-green-500 text-white px-4 py-2 rounded-lg shadow-lg transform transition-all duration-300';
      feedback.textContent = `✅ Swapped ${color1} ↔ ${color2}`;
      feedback.style.transform = 'translateX(100%)';

      document.body.appendChild(feedback);

      // Animate in
      setTimeout(() => {
        feedback.style.transform = 'translateX(0)';
      }, 10);

      // Animate out and remove
      setTimeout(() => {
        feedback.style.transform = 'translateX(100%)';
        setTimeout(() => {
          document.body.removeChild(feedback);
        }, 300);
      }, 2000);
    }

    function setupColorSwapper(): void {
      setupDragAndDropSwap();
      setupClickSwapMode();

      // Handle quick swap buttons
      document.querySelectorAll('.quick-swap').forEach((button) => {
        button.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          const color1 = target.getAttribute('data-color1') as keyof ColorTheme;
          const color2 = target.getAttribute('data-color2') as keyof ColorTheme;

          if (color1 && color2) {
            swapColors(color1, color2);
            showSwapFeedback(color1, color2);

            // Show feedback on button
            const originalText = target.textContent;
            target.textContent = '✅ Swapped!';
            target.classList.add('bg-green-100', 'hover:bg-green-200', 'text-green-800');
            target.classList.remove(
              'bg-gray-100',
              'hover:bg-gray-200',
              'dark:bg-gray-700',
              'dark:hover:bg-gray-600',
              'text-gray-700',
              'dark:text-gray-300'
            );

            setTimeout(() => {
              target.textContent = originalText;
              target.classList.remove('bg-green-100', 'hover:bg-green-200', 'text-green-800');
              target.classList.add(
                'bg-gray-100',
                'hover:bg-gray-200',
                'dark:bg-gray-700',
                'dark:hover:bg-gray-600',
                'text-gray-700',
                'dark:text-gray-300'
              );
            }, 1500);
          }
        });
      });
    }

    function openPanel(): void {
      console.log('Opening color panel...');
      const panel = document.getElementById('advanced-color-panel');
      const overlay = document.getElementById('advanced-color-overlay');

      console.log('Panel found:', !!panel);
      console.log('Overlay found:', !!overlay);

      if (panel && overlay) {
        panel.classList.add('open');
        overlay.classList.add('open');
        document.body.style.overflow = 'hidden';
        console.log('Panel opened successfully!');
      } else {
        console.error('Could not find panel or overlay elements');
      }
    }

    function closePanel(): void {
      const panel = document.getElementById('advanced-color-panel');
      const overlay = document.getElementById('advanced-color-overlay');

      if (panel && overlay) {
        panel.classList.remove('open');
        overlay.classList.remove('open');
        document.body.style.overflow = '';
      }
    }

    function setupColorInputs(): void {
      ['primary', 'secondary', 'accent', 'background', 'foreground'].forEach((colorKey) => {
        const picker = document.getElementById(`${colorKey}-color-picker`) as HTMLInputElement;
        const hex = document.getElementById(`${colorKey}-color-hex`) as HTMLInputElement;
        const property = `--color-${colorKey}`;

        if (picker) {
          picker.addEventListener('input', (e) => {
            const value = (e.target as HTMLInputElement).value;
            updateCSSVariable(property, value);
            if (hex) hex.value = value;
            saveToLocalStorage();
          });
        }

        if (hex) {
          hex.addEventListener('input', (e) => {
            const value = (e.target as HTMLInputElement).value;
            if (/^#[0-9A-F]{6}$/i.test(value)) {
              updateCSSVariable(property, value);
              if (picker) picker.value = value;
              saveToLocalStorage();
            }
          });
        }
      });
    }

    // Initialize when DOM is ready
    function initializeColorCustomizer() {
      console.log('Initializing Color Customizer...');

      // Load saved colors or apply defaults
      const savedColors = loadFromLocalStorage();
      if (savedColors) {
        applyColors(savedColors);
      } else {
        applyColors(defaultColors);
      }

      setupColorInputs();
      setupColorSwapper();

      // Event listeners
      const toggleButton = document.getElementById('advanced-color-toggle');
      const closeButton = document.getElementById('advanced-color-close');
      const overlay = document.getElementById('advanced-color-overlay');
      const resetButton = document.getElementById('reset-colors');
      const exportButton = document.getElementById('export-colors');
      const importButton = document.getElementById('import-coolors');

      console.log('Toggle button found:', !!toggleButton);

      if (toggleButton) {
        toggleButton.addEventListener('click', (e) => {
          console.log('Toggle button clicked!');
          e.preventDefault();
          openPanel();
        });
      } else {
        console.error('Toggle button not found!');
      }

      if (closeButton) {
        closeButton.addEventListener('click', closePanel);
      }

      if (overlay) {
        overlay.addEventListener('click', closePanel);
      }

      if (resetButton) {
        resetButton.addEventListener('click', () => {
          applyColors(defaultColors);
          localStorage.removeItem('customColors');
        });
      }

      if (exportButton) {
        exportButton.addEventListener('click', exportCSS);
      }

      if (importButton) {
        importButton.addEventListener('click', importFromCoolors);
      }

      // Test swap button
      const testButton = document.getElementById('test-swap');
      if (testButton) {
        testButton.addEventListener('click', () => {
          console.log('=== TESTING COLOR SWAP ===');
          console.log('Before swap - getting current colors...');
          const beforeColors = getCurrentColors();
          console.log('Before colors:', beforeColors);

          console.log('Performing swap: primary ↔ accent');
          swapColors('primary', 'accent');

          setTimeout(() => {
            console.log('After swap - getting current colors...');
            const afterColors = getCurrentColors();
            console.log('After colors:', afterColors);
            console.log('=== SWAP TEST COMPLETE ===');
          }, 100);
        });
      }

      // Add a simple color test button for debugging
      const simpleTestButton = document.createElement('button');
      simpleTestButton.textContent = 'Simple Color Test';
      simpleTestButton.className =
        'w-full px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-md transition-colors text-sm mt-2';
      simpleTestButton.addEventListener('click', () => {
        console.log('=== SIMPLE COLOR TEST ===');
        console.log('Setting primary to red...');
        updateCSSVariable('--color-primary', '#ff0000');

        const primaryPicker = document.getElementById('primary-color-picker') as HTMLInputElement;
        const primaryHex = document.getElementById('primary-color-hex') as HTMLInputElement;

        if (primaryPicker) {
          primaryPicker.value = '#ff0000';
          console.log('Updated primary picker to red');
        }

        if (primaryHex) {
          primaryHex.value = '#ff0000';
          console.log('Updated primary hex to red');
        }

        console.log('=== SIMPLE TEST COMPLETE ===');
      });

      // Add the test button to the action buttons area
      const testButtonContainer = document.getElementById('test-swap')?.parentNode;
      if (testButtonContainer) {
        testButtonContainer.appendChild(simpleTestButton);
      }

      // Remove the automatic color change test since it's confusing
      // setTimeout(() => {
      //   console.log('Testing direct color change to red...');
      //   updateCSSVariable('--color-primary', '#ff0000');
      //   ...
      // }, 2000);

      // Preset theme buttons
      document.querySelectorAll('.preset-theme').forEach((button) => {
        button.addEventListener('click', (e) => {
          const theme = (e.target as HTMLElement).getAttribute('data-theme');
          if (theme && presetThemes[theme]) {
            applyColors(presetThemes[theme]);
            saveToLocalStorage();
          }
        });
      });

      // Keyboard shortcuts
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          closePanel();
        }
      });

      console.log('Color Customizer initialized successfully!');
    }

    // Initialize immediately if DOM is already loaded, otherwise wait for DOMContentLoaded
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initializeColorCustomizer);
    } else {
      // DOM is already loaded
      initializeColorCustomizer();
    }

    // Also try initializing after a short delay to ensure all components are rendered
    setTimeout(initializeColorCustomizer, 100);
  })(); // End IIFE
</script>
