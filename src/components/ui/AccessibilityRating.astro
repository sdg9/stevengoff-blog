---
import { analyzePaletteAccessibility } from '../../utils/contrast';
import type { ColorPalette } from '../../utils/palettes';

export interface Props {
  palette: ColorPalette;
  showDetails?: boolean;
}

const { palette, showDetails = false } = Astro.props;

// Analyze the palette
const analysis = analyzePaletteAccessibility(palette);

// Get rating color
function getRatingColor(rating: string): string {
  switch (rating) {
    case 'Excellent':
      return '#16a34a';
    case 'Good':
      return '#2563eb';
    case 'Fair':
      return '#d97706';
    case 'Poor':
      return '#dc2626';
    case 'Critical':
      return '#991b1b';
    default:
      return '#6b7280';
  }
}

// Get rating background
function getRatingBackground(rating: string): string {
  switch (rating) {
    case 'Excellent':
      return '#dcfce7';
    case 'Good':
      return '#dbeafe';
    case 'Fair':
      return '#fed7aa';
    case 'Poor':
      return '#fecaca';
    case 'Critical':
      return '#fee2e2';
    default:
      return '#f3f4f6';
  }
}
---

<div class="accessibility-summary">
  <div class="summary-header">
    <div
      class="score-badge"
      style={`
      background-color: ${getRatingBackground(analysis.rating)};
      color: ${getRatingColor(analysis.rating)};
    `}
    >
      <span class="score-number">{analysis.overallScore}</span>
      <span class="score-label">/ 100</span>
    </div>
    <div class="rating-info">
      <h3 class="rating-title">{analysis.rating}</h3>
      <p class="rating-description">
        {analysis.rating === 'Excellent' && 'Outstanding accessibility with minimal issues'}
        {analysis.rating === 'Good' && 'Good accessibility with minor improvements needed'}
        {analysis.rating === 'Fair' && 'Acceptable accessibility but needs attention'}
        {analysis.rating === 'Poor' && 'Poor accessibility with several issues'}
        {analysis.rating === 'Critical' && 'Critical accessibility issues requiring immediate attention'}
      </p>
    </div>
  </div>

  {
    analysis.criticalIssues.length > 0 && (
      <div class="issues-section">
        <h4 class="issues-title">
          <span class="icon">⚠️</span>
          Critical Issues ({analysis.criticalIssues.length})
        </h4>
        <ul class="issues-list">
          {analysis.criticalIssues.map((issue) => (
            <li class="issue-item">{issue}</li>
          ))}
        </ul>
      </div>
    )
  }

  {
    showDetails && analysis.recommendations.length > 0 && (
      <div class="recommendations-section">
        <h4 class="recommendations-title">
          <span class="icon">💡</span>
          Recommendations
        </h4>
        <ul class="recommendations-list">
          {analysis.recommendations.map((rec) => (
            <li class="recommendation-item">{rec}</li>
          ))}
        </ul>
      </div>
    )
  }

  {
    showDetails && (
      <div class="quick-stats">
        <div class="stat-item">
          <span class="stat-label">Light Mode Issues:</span>
          <span class="stat-value">
            {analysis.criticalIssues.filter((issue) => issue.includes('light mode')).length}
          </span>
        </div>
        <div class="stat-item">
          <span class="stat-label">Dark Mode Issues:</span>
          <span class="stat-value">
            {analysis.criticalIssues.filter((issue) => issue.includes('dark mode')).length}
          </span>
        </div>
      </div>
    )
  }

  <!-- Main Text Contrast Summary -->
  <div class="main-text-summary">
    <h4 class="main-text-title">
      <span class="icon">📝</span>
      Main Text/Background Contrast
    </h4>
    <div class="contrast-modes">
      <div class="contrast-mode">
        <span class="mode-label">Light:</span>
        <div class="contrast-info">
          <span class="contrast-ratio">{analysis.contrastGrid.light.background?.foreground?.ratio || 'N/A'}:1</span>
          <span
            class={`contrast-badge ${analysis.contrastGrid.light.background?.foreground?.ratio >= 7 ? 'excellent' : analysis.contrastGrid.light.background?.foreground?.ratio >= 4.5 ? 'good' : 'poor'}`}
          >
            {
              analysis.contrastGrid.light.background?.foreground?.ratio >= 7
                ? '★★★ AAA'
                : analysis.contrastGrid.light.background?.foreground?.ratio >= 4.5
                  ? '✓✓ AA'
                  : '✗ Fail'
            }
          </span>
        </div>
      </div>
      <div class="contrast-mode">
        <span class="mode-label">Dark:</span>
        <div class="contrast-info">
          <span class="contrast-ratio">{analysis.contrastGrid.dark.background?.foreground?.ratio || 'N/A'}:1</span>
          <span
            class={`contrast-badge ${analysis.contrastGrid.dark.background?.foreground?.ratio >= 7 ? 'excellent' : analysis.contrastGrid.dark.background?.foreground?.ratio >= 4.5 ? 'good' : 'poor'}`}
          >
            {
              analysis.contrastGrid.dark.background?.foreground?.ratio >= 7
                ? '★★★ AAA'
                : analysis.contrastGrid.dark.background?.foreground?.ratio >= 4.5
                  ? '✓✓ AA'
                  : '✗ Fail'
            }
          </span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .accessibility-summary {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 1rem;
    margin-bottom: 1rem;
  }

  .summary-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .score-badge {
    padding: 0.75rem;
    border-radius: 8px;
    text-align: center;
    min-width: 80px;
    border: 2px solid currentColor;
  }

  .score-number {
    display: block;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1;
  }

  .score-label {
    font-size: 0.75rem;
    opacity: 0.8;
  }

  .rating-info {
    flex: 1;
  }

  .rating-title {
    margin: 0 0 0.25rem 0;
    font-size: 1.25rem;
    font-weight: 600;
    color: #374151;
  }

  .rating-description {
    margin: 0;
    color: #6b7280;
    font-size: 0.875rem;
  }

  .issues-section,
  .recommendations-section {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid #f3f4f6;
  }

  .issues-title,
  .recommendations-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.5rem 0;
    font-size: 1rem;
    font-weight: 600;
    color: #374151;
  }

  .icon {
    font-size: 1rem;
  }

  .issues-list,
  .recommendations-list {
    margin: 0;
    padding-left: 1.5rem;
    list-style: none;
  }

  .issue-item,
  .recommendation-item {
    position: relative;
    margin-bottom: 0.5rem;
    font-size: 0.875rem;
    color: #4b5563;
    line-height: 1.4;
  }

  .issue-item::before {
    content: '•';
    position: absolute;
    left: -1rem;
    color: #dc2626;
    font-weight: bold;
  }

  .recommendation-item::before {
    content: '•';
    position: absolute;
    left: -1rem;
    color: #2563eb;
    font-weight: bold;
  }

  .quick-stats {
    display: flex;
    gap: 2rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid #f3f4f6;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .stat-label {
    font-size: 0.75rem;
    color: #6b7280;
    font-weight: 500;
  }

  .stat-value {
    font-size: 1.25rem;
    font-weight: 600;
    color: #374151;
  }

  @media (max-width: 640px) {
    .summary-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .quick-stats {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>
