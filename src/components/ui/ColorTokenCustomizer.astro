---
// Simple inline color customizer that can be dropped into any Astro page
// Just add <ColorTokenCustomizer /> to any page and it will add a floating color picker
---

<div id="color-token-customizer" class="fixed bottom-4 right-4 z-50">
  <!-- Toggle Button -->
  <button 
    id="color-customizer-btn" 
    class="bg-gradient-to-r from-indigo-500 to-purple-500 hover:from-indigo-600 hover:to-purple-600 text-white p-3 rounded-full shadow-lg transition-all duration-200 hover:scale-105"
    title="Customize Design Tokens"
  >
    🎨
  </button>
  
  <!-- Customizer Panel -->
  <div 
    id="color-customizer-panel" 
    class="absolute bottom-16 right-0 bg-white dark:bg-gray-800 rounded-lg shadow-xl border border-gray-200 dark:border-gray-700 p-4 w-80 transform origin-bottom-right scale-0 transition-transform duration-200"
    style="display: none;"
  >
    <h3 class="text-lg font-semibold mb-4 text-gray-900 dark:text-white">🎨 Color Tokens</h3>
    
    <div class="space-y-3">
      <div class="flex items-center space-x-2">
        <label class="text-sm font-medium text-gray-700 dark:text-gray-300 w-20">Primary:</label>
        <input type="color" id="primary-color" value="#818cf9" class="w-8 h-8 rounded border">
        <input type="text" id="primary-hex" value="#818cf9" class="flex-1 px-2 py-1 text-xs border rounded">
      </div>
      
      <div class="flex items-center space-x-2">
        <label class="text-sm font-medium text-gray-700 dark:text-gray-300 w-20">Secondary:</label>
        <input type="color" id="secondary-color" value="#2f3848" class="w-8 h-8 rounded border">
        <input type="text" id="secondary-hex" value="#2f3848" class="flex-1 px-2 py-1 text-xs border rounded">
      </div>
      
      <div class="flex items-center space-x-2">
        <label class="text-sm font-medium text-gray-700 dark:text-gray-300 w-20">Accent:</label>
        <input type="color" id="accent-color" value="#f14444" class="w-8 h-8 rounded border">
        <input type="text" id="accent-hex" value="#f14444" class="flex-1 px-2 py-1 text-xs border rounded">
      </div>
    </div>
    
    <div class="mt-4 flex space-x-2">
      <button id="reset-tokens" class="flex-1 px-3 py-1 bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600 rounded text-xs">
        Reset
      </button>
      <button id="copy-css" class="flex-1 px-3 py-1 bg-blue-100 hover:bg-blue-200 dark:bg-blue-900 dark:hover:bg-blue-800 rounded text-xs">
        Copy CSS
      </button>
    </div>
  </div>
</div>

<script>
  // Simple color token customizer
  function initSimpleColorCustomizer() {
    const btn = document.getElementById('color-customizer-btn');
    const panel = document.getElementById('color-customizer-panel');
    let isOpen = false;

    // Token mappings
    const tokens = [
      { id: 'primary', cssVar: '--color-primary', default: '#818cf9' },
      { id: 'secondary', cssVar: '--color-secondary', default: '#2f3848' },
      { id: 'accent', cssVar: '--color-accent', default: '#f14444' }
    ];

    // Update CSS custom property
    function updateToken(cssVar: string, value: string) {
      document.documentElement.style.setProperty(cssVar, value);
    }

    // Setup token controls
    tokens.forEach(token => {
      const colorInput = document.getElementById(`${token.id}-color`) as HTMLInputElement;
      const hexInput = document.getElementById(`${token.id}-hex`) as HTMLInputElement;
      
      if (colorInput && hexInput) {
        colorInput.addEventListener('input', (e) => {
          const value = (e.target as HTMLInputElement).value;
          hexInput.value = value;
          updateToken(token.cssVar, value);
        });

        hexInput.addEventListener('input', (e) => {
          const value = (e.target as HTMLInputElement).value;
          if (/^#[0-9A-F]{6}$/i.test(value)) {
            colorInput.value = value;
            updateToken(token.cssVar, value);
          }
        });
      }
    });

    // Toggle panel
    if (btn && panel) {
      btn.addEventListener('click', () => {
        if (isOpen) {
          panel.style.display = 'none';
          panel.classList.remove('scale-100');
          panel.classList.add('scale-0');
        } else {
          panel.style.display = 'block';
          panel.classList.remove('scale-0');
          panel.classList.add('scale-100');
        }
        isOpen = !isOpen;
      });
    }

    // Reset tokens
    const resetBtn = document.getElementById('reset-tokens');
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        tokens.forEach(token => {
          const colorInput = document.getElementById(`${token.id}-color`) as HTMLInputElement;
          const hexInput = document.getElementById(`${token.id}-hex`) as HTMLInputElement;
          
          if (colorInput && hexInput) {
            colorInput.value = token.default;
            hexInput.value = token.default;
            updateToken(token.cssVar, token.default);
          }
        });
      });
    }

    // Copy CSS
    const copyBtn = document.getElementById('copy-css');
    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const css = tokens.map(token => {
          const hexInput = document.getElementById(`${token.id}-hex`) as HTMLInputElement;
          return `  ${token.cssVar}: ${hexInput?.value || token.default};`;
        }).join('\n');

        const cssOutput = `:root {\n${css}\n}`;
        
        navigator.clipboard.writeText(cssOutput).then(() => {
          const originalText = copyBtn.textContent;
          copyBtn.textContent = 'Copied!';
          setTimeout(() => {
            copyBtn.textContent = originalText;
          }, 1000);
        });
      });
    }

    // Close on outside click
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const customizer = document.getElementById('color-token-customizer');
      
      if (customizer && !customizer.contains(target) && isOpen) {
        panel!.style.display = 'none';
        panel!.classList.remove('scale-100');
        panel!.classList.add('scale-0');
        isOpen = false;
      }
    });
  }

  // Initialize
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSimpleColorCustomizer);
  } else {
    initSimpleColorCustomizer();
  }
</script>
