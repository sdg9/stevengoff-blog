---
import { Icon } from 'astro-icon/components';
import { SITE } from 'astrowind:config';
import { getHomePermalink } from '~/utils/permalinks';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links?: Array<Links>;
  secondaryLinks?: Array<Link>;
  socialLinks?: Array<Link>;
  footNote?: string;
  theme?: string;
  branding?: {
    tagline?: string;
  };
}

const { socialLinks = [], links = [], footNote = '', theme = 'dark', branding } = Astro.props;

// Default social links if none provided
const defaultSocialLinks = [
  { ariaLabel: 'Twitter', href: 'https://twitter.com/webtownhero', icon: 'tabler:brand-twitter' },
  { ariaLabel: 'Instagram', href: 'https://instagram.com/webtownhero', icon: 'tabler:brand-instagram' },
  { ariaLabel: 'LinkedIn', href: 'https://linkedin.com/company/webtownhero', icon: 'tabler:brand-linkedin' },
  { ariaLabel: 'Facebook', href: 'https://facebook.com/webtownhero', icon: 'tabler:brand-facebook' },
];

const finalSocialLinks = socialLinks.length > 0 ? socialLinks : defaultSocialLinks;
const tagline =
  branding?.tagline || 'Crafting performant, professional websites for local businesses at an affordable monthly rate.';
---

<footer class:list={[{ dark: theme === 'dark' }, 'relative border-t border-gray-200 dark:border-slate-800 not-prose']}>
  <div class="dark:bg-dark absolute inset-0 pointer-events-none" aria-hidden="true"></div>
  <div
    class="relative max-w-7xl mx-auto px-4 sm:px-6 dark:text-slate-300 intersect-once intersect-quarter intercept-no-queue motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
  >
    <!-- Professional Footer Layout with Branding Section Above -->

    <!-- Top Section: Branding, Description, and Social Links -->
    <div class="py-12 border-b border-gray-700">
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between">
        <!-- Left: Branding and Description -->
        <div class="mb-6 lg:mb-0 lg:flex-1">
          <div class="mb-4">
            <a class="inline-block font-bold text-xl text-white" href={getHomePermalink()}>
              {SITE?.name}
            </a>
          </div>
          <p class="text-sm text-gray-400 leading-relaxed max-w-md">
            {tagline}
          </p>
        </div>

        <!-- Right: Social Media Icons -->
        {
          finalSocialLinks?.length ? (
            <div class="flex space-x-3">
              {finalSocialLinks.map(({ ariaLabel, href, icon }) => (
                <a
                  class="text-gray-400 hover:text-white focus:outline-none focus:ring-2 focus:ring-white focus:ring-opacity-50 rounded-lg p-2 transition duration-150 ease-in-out"
                  aria-label={ariaLabel}
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {icon && <Icon name={icon} class="w-5 h-5" />}
                </a>
              ))}
            </div>
          ) : null
        }
      </div>
    </div>

    <!-- Bottom Section: 4-Column Navigation -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 py-8">
      {
        links.map(({ title, links: sectionLinks }) => (
          <div>
            <h3 class="text-white font-semibold mb-4">{title}</h3>
            {title === 'Contact Us' ? (
              <div class="flex items-center text-sm text-gray-400">
                <Icon name={sectionLinks[0]?.icon || 'tabler:mail'} class="w-4 h-4 mr-2 flex-shrink-0" />
                <a href={sectionLinks[0]?.href} class="hover:text-white transition duration-150 ease-in-out">
                  {sectionLinks[0]?.text}
                </a>
              </div>
            ) : (
              <ul class="space-y-3">
                {sectionLinks &&
                  sectionLinks.map(({ text, href }) => (
                    <li>
                      <a class="text-gray-400 hover:text-white transition duration-150 ease-in-out text-sm" href={href}>
                        {text}
                      </a>
                    </li>
                  ))}
              </ul>
            )}
          </div>
        ))
      }
    </div>

    <!-- Horizontal Divider -->
    <div class="border-t border-gray-700 pt-6 pb-6">
      <!-- Legal Footer Links and Copyright -->
      <div class="flex flex-col md:flex-row md:items-center md:justify-between">
        <div class="text-sm text-gray-400 mb-4 md:mb-0">
          {footNote || `© ${new Date().getFullYear()} ${SITE?.name}. All rights reserved.`}
        </div>

        <!-- Legal Links -->
        <div class="flex flex-wrap gap-6 text-sm">
          <a href="/privacy" class="text-gray-400 hover:text-white transition duration-150 ease-in-out"
            >Privacy Policy</a
          >
          <a href="/terms" class="text-gray-400 hover:text-white transition duration-150 ease-in-out"
            >Terms of Service</a
          >
          <a href="/sitemap-index.xml" class="text-gray-400 hover:text-white transition duration-150 ease-in-out"
            >Sitemap</a
          >
        </div>
      </div>
    </div>
  </div>
</footer>
