---
import Image from '~/components/common/Image.astro';
import { getFormattedDate } from '~/utils/utils';
import { getPermalink } from '~/utils/permalinks';
import type { Post } from '~/types';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const href = getPermalink(post.permalink, 'post');
---

<article class="group card card-hover flex flex-col overflow-hidden">
  {
    post.image ? (
      <div class="aspect-[16/9] overflow-hidden border-b border-border">
        <Image
          src={post.image}
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          widths={[400, 800]}
          sizes="(max-width: 768px) 100vw, 500px"
          alt={post.title}
          width={800}
          height={450}
          loading="lazy"
          decoding="async"
        />
      </div>
    ) : (
      <div
        class="relative aspect-[16/9] overflow-hidden border-b border-border bg-gradient-to-br from-primary/25 via-muted-bg to-secondary/20"
        aria-hidden="true"
      >
        <div class="bg-grid absolute inset-0 opacity-60"></div>
        <svg
          class="absolute inset-0 m-auto w-16 h-16 opacity-80 transition-transform duration-500 group-hover:scale-110 group-hover:rotate-6"
          viewBox="0 0 28 28"
        >
          <rect x="1" y="1" width="12" height="12" rx="3" fill="#8b9cff" />
          <rect x="15" y="1" width="12" height="12" rx="3" fill="#22d3ee" />
          <rect x="1" y="15" width="12" height="12" rx="3" fill="#f472b6" />
          <rect x="15" y="15" width="12" height="12" rx="3" fill="#facc15" />
        </svg>
      </div>
    )
  }
  <div class="flex flex-1 flex-col p-6">
    <div class="meta flex flex-wrap items-center gap-2 mb-3">
      {post.category && <span class="text-primary">{post.category.title}</span>}
      {post.category && <span aria-hidden="true">/</span>}
      <time datetime={String(post.publishDate)}>{getFormattedDate(post.publishDate)}</time>
      {post.readingTime && <span aria-hidden="true">/</span>}
      {post.readingTime && <span>{Math.ceil(post.readingTime)} min</span>}
    </div>
    <h2 class="text-xl font-bold leading-snug mb-2">
      <a href={href} class="after:absolute after:inset-0 group-hover:text-primary transition-colors">
        {post.title}
      </a>
    </h2>
    {post.excerpt && <p class="text-muted text-[0.95rem] leading-relaxed line-clamp-3">{post.excerpt}</p>}
    {
      post.tags && post.tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mt-auto pt-5">
          {post.tags.slice(0, 3).map((tag) => (
            <span class="chip">#{tag.title}</span>
          ))}
        </div>
      )
    }
  </div>
</article>
