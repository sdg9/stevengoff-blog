---
import Image from '~/components/common/Image.astro';
import { getFormattedDate } from '~/utils/utils';
import { getPermalink } from '~/utils/permalinks';
import type { Post } from '~/types';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<article class="group relative flex flex-col md:flex-row gap-6 border-b border-slate-200 dark:border-slate-700 pb-6">
  {
    post.image && (
      <a href={getPermalink(post.permalink, 'post')} class="shrink-0">
        <Image
          src={post.image}
          class="w-full md:w-48 h-48 object-cover rounded-lg bg-gray-400 dark:bg-slate-700 group-hover:opacity-90 transition-opacity"
          widths={[200, 400]}
          sizes="(max-width: 768px) 100vw, 200px"
          alt={post.title}
          width={200}
          height={200}
          loading="lazy"
          decoding="async"
        />
      </a>
    )
  }
  <div class="flex flex-col justify-center">
    <div class="flex flex-wrap items-center gap-2 text-sm text-muted mb-2">
      <time datetime={String(post.publishDate)}>{getFormattedDate(post.publishDate)}</time>
      {
        post.category && (
          <>
            <span>·</span>
            <span class="capitalize text-primary font-medium">{post.category?.title}</span>
          </>
        )
      }
      {
        post.readingTime && (
          <>
            <span>·</span>
            <span>{Math.ceil(post.readingTime)} min read</span>
          </>
        )
      }
    </div>
    <h2 class="text-xl md:text-2xl font-bold leading-tight mb-2">
      <a
        href={getPermalink(post.permalink, 'post')}
        class="hover:text-primary dark:hover:text-blue-400 transition-colors"
      >
        {post.title}
      </a>
    </h2>
    {post.excerpt && <p class="text-muted text-base line-clamp-2">{post.excerpt}</p>}
    {
      post.tags && post.tags.length > 0 && (
        <div class="flex flex-wrap gap-1 mt-3">
          {post.tags.slice(0, 3).map((tag) => (
            <span class="text-xs font-medium text-muted bg-gray-100 dark:bg-slate-700 px-2 py-1 rounded">
              #{tag.title}
            </span>
          ))}
        </div>
      )
    }
  </div>
</article>
