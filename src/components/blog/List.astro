---
import type { Page } from 'astro';
import type { Post } from '~/types';
import Pagination from '~/components/blog/Pagination.astro';
import PostItem from '~/components/blog/PostItem.astro';

export interface Props {
  page?: Page<Post>;
}

const { page } = Astro.props;
---

<section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
  <header class="mb-10 md:mb-16">
    <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading">Blog</h1>
    <p class="text-muted text-xl mt-2">Thoughts, stories, and ideas.</p>
  </header>
  <div class="grid gap-6 lg:gap-8">
    {page?.data?.map((post) => <PostItem post={post} />)}
  </div>
  <Pagination prevUrl={page?.url?.prev} nextUrl={page?.url?.next} />
</section>
