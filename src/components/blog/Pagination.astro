---
import { Icon } from 'astro-icon/components';

export interface Props {
  prevUrl?: string;
  nextUrl?: string;
}

const { prevUrl, nextUrl } = Astro.props;
---

{
  (prevUrl || nextUrl) && (
    <nav class="flex justify-between mt-12 pt-8 border-t border-border">
      <div>
        {prevUrl && (
          <a
            href={prevUrl}
            class="chip !text-sm !px-4 !py-2 hover:!text-foreground hover:border-primary/50 transition-colors"
          >
            <Icon name="tabler:arrow-left" class="w-5 h-5" />
            <span>Previous Page</span>
          </a>
        )}
      </div>
      <div>
        {nextUrl && (
          <a
            href={nextUrl}
            class="chip !text-sm !px-4 !py-2 hover:!text-foreground hover:border-primary/50 transition-colors"
          >
            <span>Next Page</span>
            <Icon name="tabler:arrow-right" class="w-5 h-5" />
          </a>
        )}
      </div>
    </nav>
  )
}
