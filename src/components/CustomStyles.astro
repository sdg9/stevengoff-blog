---
import '@fontsource-variable/inter';
import { colorPalettes, generatePaletteCSS } from '../utils/palettes';

// Available font options:
// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist

// ========================================
// PALETTE CONFIGURATION
// ========================================
// Change the palette name below to switch between different color schemes:
// Available palettes: 'default', 'ocean', 'forest', 'sunset', 'midnight', 'rose', 'monochrome'
// const ACTIVE_PALETTE = 'default';
const ACTIVE_PALETTE = 'test';

// Get the selected palette
const selectedPalette = colorPalettes[ACTIVE_PALETTE];
if (!selectedPalette) {
  throw new Error(
    `Palette "${ACTIVE_PALETTE}" not found. Available palettes: ${Object.keys(colorPalettes).join(', ')}`
  );
}

// Generate CSS for the selected palette
const paletteCSS = generatePaletteCSS(selectedPalette);
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';
  }
</style>

<style is:inline set:html={paletteCSS}></style>
