---
import { ANALYTICS } from 'astrowind:config';

const id = ANALYTICS?.vendors?.googleAnalytics?.id || '';
const useCookieConsent = ANALYTICS?.useCookieConsent ?? true;
---

<div hidden data-google-analytics data-id={id} data-consent={String(useCookieConsent)}></div>
<script>
  import { initializeGoogleAnalytics } from '~/utils/google-analytics.js';

  const config = document.querySelector<HTMLElement>('[data-google-analytics]');
  if (config) {
    initializeGoogleAnalytics({
      id: config.dataset.id,
      useCookieConsent: config.dataset.consent === 'false' ? false : true,
    });
  }
</script>
