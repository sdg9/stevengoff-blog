---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';

const metadata = {
  title: 'Physical Therapy - Community & Trust | Your Local Healing Partners',
  description:
    'Trusted by thousands in our community. Experience personalized physical therapy care with proven results and compassionate service.',
  robots: {
    index: true,
    follow: true,
  },
  openGraph: {
    type: 'website',
    title: 'Physical Therapy - Community & Trust',
    description: 'Trusted by thousands in our community. Experience personalized physical therapy care.',
  },
  twitter: {
    card: 'summary_large_image',
    title: 'Physical Therapy - Community & Trust',
    description: 'Trusted by thousands in our community. Experience personalized physical therapy care.',
  },
};
---

<PageLayout metadata={metadata}>
  <!-- Hero with Background Video Loop -->
  <Hero
    tagline="Community & Trust"
    title="Your Trusted Local Physical Therapy Experts"
    subtitle="For over 15 years, we've been helping our neighbors recover, heal, and thrive. Join thousands who have chosen us for their journey back to wellness."
    actions={[
      {
        text: 'Book Appointment',
        href: '#appointment',
        variant: 'primary',
      },
      {
        text: 'Meet Our Team',
        href: '#team',
        variant: 'secondary',
      },
    ]}
  >
    <div
      slot="bg"
      class="absolute inset-0 bg-gradient-to-r from-[var(--color-bg-page)]/90 to-[var(--color-bg-page)]/70 z-10"
    >
    </div>
    <div
      slot="bg"
      class="absolute inset-0 bg-cover bg-center opacity-30"
      style="background-image: url('https://images.unsplash.com/photo-1559757148-5c350d0d3c56?ixlib=rb-4.0.3')"
    >
    </div>
  </Hero>

  <!-- Animated Stats Row -->
  <section class="py-16 bg-[var(--color-primary)] text-white animate-on-scroll">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
        <div>
          <div class="text-4xl md:text-5xl font-bold mb-2 counter" data-target="15">0</div>
          <div class="text-lg opacity-90">Years Serving Our Community</div>
        </div>
        <div>
          <div class="text-4xl md:text-5xl font-bold mb-2 counter" data-target="8500">0</div>
          <div class="text-lg opacity-90">Patients Helped</div>
        </div>
        <div>
          <div class="text-4xl md:text-5xl font-bold mb-2 counter" data-target="4.9">0</div>
          <div class="text-lg opacity-90">Average Star Rating</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Categories Accordion -->
  <section class="py-16 animate-on-scroll">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-text-heading)] mb-4">Where Does It Hurt?</h2>
        <p class="text-lg text-[var(--color-text-muted)] max-w-2xl mx-auto">
          Our specialized treatment approaches target your specific condition with proven, evidence-based care.
        </p>
      </div>

      <div class="max-w-4xl mx-auto space-y-4">
        <div class="border border-gray-200 rounded-lg overflow-hidden">
          <button
            class="w-full px-6 py-4 text-left bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] accordion-button"
          >
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-4">
                <div class="w-12 h-12 bg-[var(--color-primary)]/10 rounded-lg flex items-center justify-center">
                  <span class="text-2xl">🦴</span>
                </div>
                <div>
                  <h3 class="text-lg font-semibold text-[var(--color-text-heading)]">Musculoskeletal Conditions</h3>
                  <p class="text-sm text-[var(--color-text-muted)]">Back pain, neck pain, joint injuries</p>
                </div>
              </div>
              <span class="text-2xl transform transition-transform accordion-icon">+</span>
            </div>
          </button>
          <div class="accordion-content hidden px-6 pb-4">
            <div class="flex items-start space-x-4">
              <img
                src="https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?ixlib=rb-4.0.3&auto=format&fit=crop&w=300&q=80"
                alt="Musculoskeletal therapy"
                class="w-24 h-24 rounded-lg object-cover"
              />
              <div>
                <p class="text-[var(--color-text-default)] mb-3">
                  Comprehensive treatment for spine, joint, and muscle conditions using manual therapy, exercise
                  prescription, and movement education.
                </p>
                <ul class="text-sm text-[var(--color-text-muted)] space-y-1">
                  <li>• Lower back pain and sciatica</li>
                  <li>• Neck pain and headaches</li>
                  <li>• Shoulder and hip dysfunction</li>
                </ul>
              </div>
            </div>
          </div>
        </div>

        <div class="border border-gray-200 rounded-lg overflow-hidden">
          <button
            class="w-full px-6 py-4 text-left bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] accordion-button"
          >
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-4">
                <div class="w-12 h-12 bg-[var(--color-primary)]/10 rounded-lg flex items-center justify-center">
                  <span class="text-2xl">🧠</span>
                </div>
                <div>
                  <h3 class="text-lg font-semibold text-[var(--color-text-heading)]">Neurological Rehabilitation</h3>
                  <p class="text-sm text-[var(--color-text-muted)]">Stroke recovery, balance disorders</p>
                </div>
              </div>
              <span class="text-2xl transform transition-transform accordion-icon">+</span>
            </div>
          </button>
          <div class="accordion-content hidden px-6 pb-4">
            <div class="flex items-start space-x-4">
              <img
                src="https://images.unsplash.com/photo-1576091160399-112ba8d25d1f?ixlib=rb-4.0.3&auto=format&fit=crop&w=300&q=80"
                alt="Neurological therapy"
                class="w-24 h-24 rounded-lg object-cover"
              />
              <div>
                <p class="text-[var(--color-text-default)] mb-3">
                  Specialized care for neurological conditions focusing on movement retraining, balance, and functional
                  independence.
                </p>
                <ul class="text-sm text-[var(--color-text-muted)] space-y-1">
                  <li>• Post-stroke rehabilitation</li>
                  <li>• Parkinson's disease management</li>
                  <li>• Balance and fall prevention</li>
                </ul>
              </div>
            </div>
          </div>
        </div>

        <div class="border border-gray-200 rounded-lg overflow-hidden">
          <button
            class="w-full px-6 py-4 text-left bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] accordion-button"
          >
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-4">
                <div class="w-12 h-12 bg-[var(--color-primary)]/10 rounded-lg flex items-center justify-center">
                  <span class="text-2xl">👩</span>
                </div>
                <div>
                  <h3 class="text-lg font-semibold text-[var(--color-text-heading)]">Women's Health</h3>
                  <p class="text-sm text-[var(--color-text-muted)]">Pelvic floor, prenatal, postpartum care</p>
                </div>
              </div>
              <span class="text-2xl transform transition-transform accordion-icon">+</span>
            </div>
          </button>
          <div class="accordion-content hidden px-6 pb-4">
            <div class="flex items-start space-x-4">
              <img
                src="https://images.unsplash.com/photo-1544027993-37dbfe43562a?ixlib=rb-4.0.3&auto=format&fit=crop&w=300&q=80"
                alt="Women's health therapy"
                class="w-24 h-24 rounded-lg object-cover"
              />
              <div>
                <p class="text-[var(--color-text-default)] mb-3">
                  Compassionate, specialized care for women's unique health needs throughout all life stages.
                </p>
                <ul class="text-sm text-[var(--color-text-muted)] space-y-1">
                  <li>• Pelvic floor dysfunction</li>
                  <li>• Prenatal and postpartum care</li>
                  <li>• Incontinence management</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Patient Stories Masonry -->
  <Testimonials
    title="Real Stories from Real People"
    subtitle="See how we've helped members of our community get back to living their best lives"
    testimonials={[
      {
        testimonial:
          'I was skeptical at first, but after 6 weeks here, my chronic shoulder pain is completely gone. The staff genuinely cares about your progress.',
        name: 'Maria Santos',
        job: 'Local Teacher',
        image: {
          src: 'https://images.unsplash.com/photo-1494790108755-2616b612b786?ixlib=rb-4.0.3&auto=format&fit=crop&w=300&q=80',
          alt: 'Maria Santos',
        },
      },
      {
        testimonial:
          "After my stroke, I thought I'd never walk normally again. This team helped me not just walk, but dance at my daughter's wedding.",
        name: 'Robert Kim',
        job: 'Retired Engineer',
        image: {
          src: 'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?ixlib=rb-4.0.3&auto=format&fit=crop&w=300&q=80',
          alt: 'Robert Kim',
        },
      },
      {
        testimonial:
          'They worked with my insurance and made appointments around my work schedule. Professional and accommodating.',
        name: 'Jessica Miller',
        job: 'Nurse',
        image: {
          src: 'https://images.unsplash.com/photo-1438761681033-6461ffad8d80?ixlib=rb-4.0.3&auto=format&fit=crop&w=300&q=80',
          alt: 'Jessica Miller',
        },
      },
    ]}
    classes={{
      container: 'animate-on-scroll bg-gray-50',
    }}
  />

  <!-- Blog Tease -->
  <BlogLatestPosts
    title="Health & Wellness Resources"
    information="Stay informed with the latest insights on physical therapy, injury prevention, and wellness from our expert team."
    classes={{
      container: 'animate-on-scroll',
    }}
  />

  <!-- Full-width CTA Banner -->
  <CallToAction
    title="Move Better Today"
    subtitle="Don't let pain hold you back another day. Take the first step toward recovery and join thousands of satisfied patients who trust us with their care."
    actions={[
      {
        variant: 'primary',
        text: 'Schedule Consultation',
        href: '#appointment',
      },
      {
        variant: 'secondary',
        text: 'Call (123) 456-7890',
        href: 'tel:+1234567890',
      },
    ]}
    classes={{
      container:
        'bg-gradient-to-r from-[var(--color-secondary)] to-[var(--color-accent)] text-white animate-on-scroll full-width',
    }}
  />

  <style>
    .animate-on-scroll {
      opacity: 0;
      transform: translateY(20px);
      transition:
        opacity 0.6s ease-out,
        transform 0.6s ease-out;
    }

    .animate-on-scroll.visible {
      opacity: 1;
      transform: translateY(0);
    }

    .accordion-content {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease-out;
    }

    .accordion-content.expanded {
      max-height: 200px;
    }

    .accordion-icon {
      transition: transform 0.3s ease;
    }

    .accordion-icon.rotated {
      transform: rotate(45deg);
    }

    .full-width {
      width: 100vw;
      margin-left: calc(-50vw + 50%);
    }

    @media (prefers-reduced-motion: reduce) {
      .animate-on-scroll {
        opacity: 1;
        transform: none;
        transition: none;
      }
      .counter {
        animation: none;
      }
    }
  </style>

  <script>
    // Intersection Observer for scroll animations
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px',
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          // Trigger counter animation for stats
          if (entry.target.querySelector('.counter')) {
            animateCounters();
          }
        }
      });
    }, observerOptions);

    // Observe all elements with animate-on-scroll class
    document.querySelectorAll('.animate-on-scroll').forEach((el) => {
      observer.observe(el);
    });

    // Counter animation
    function animateCounters() {
      const counters = document.querySelectorAll('.counter');
      counters.forEach((counter) => {
        const target = parseInt(counter.getAttribute('data-target'));
        const increment = target / 100;
        let current = 0;

        const timer = setInterval(() => {
          current += increment;
          if (current >= target) {
            counter.textContent = target === 4.9 ? '4.9' : target.toLocaleString();
            clearInterval(timer);
          } else {
            counter.textContent = target === 4.9 ? current.toFixed(1) : Math.floor(current).toLocaleString();
          }
        }, 20);
      });
    }

    // Accordion functionality
    document.querySelectorAll('.accordion-button').forEach((button) => {
      button.addEventListener('click', () => {
        const content = button.nextElementSibling;
        const icon = button.querySelector('.accordion-icon');

        // Close other accordions
        document.querySelectorAll('.accordion-content').forEach((otherContent) => {
          if (otherContent !== content) {
            otherContent.classList.remove('expanded');
            otherContent.previousElementSibling.querySelector('.accordion-icon').classList.remove('rotated');
          }
        });

        // Toggle current accordion
        content.classList.toggle('expanded');
        icon.classList.toggle('rotated');
      });
    });
  </script>
</PageLayout>
