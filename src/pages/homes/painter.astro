---
import PageLayout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Features from '~/components/widgets/Features.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import Steps from '~/components/widgets/Steps.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Contact from '~/components/widgets/Contact.astro';
import Stats from '~/components/widgets/Stats.astro';

const metadata = {
  title: 'One Coat Painters - Professional Painting Services | Vernon Hills',
  description:
    'Transform your space with One Coat Painters. Professional interior and exterior painting services in Vernon Hills. Licensed, insured, and committed to quality. Get your free quote today.',
  ignoreTitleTemplate: true,
};
---

<PageLayout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    id="hero"
    title="One Coat Painters of Vernon Hills"
    tagline="Professional Painting Services"
    actions={[
      { variant: 'primary', text: 'Get Free Quote', href: '#contact' },
      { text: 'View Our Work', href: '#portfolio' },
    ]}
  >
    <Fragment slot="subtitle">
      Transform your home or business with professional painting services that deliver lasting beauty and protection.
      Our experienced team brings quality craftsmanship to every project, big or small.
      <br /><br />
      <span class="text-sm font-medium">✓ Licensed & Insured</span> •
      <span class="text-sm font-medium">✓ Free Estimates</span> •
      <span class="text-sm font-medium">✓ Quality Guarantee</span>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0">
        <img
          class="w-full h-full object-cover"
          src="https://images.unsplash.com/photo-1562259949-e8e7689d7828?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&h=1080&q=80"
          alt="Modern interior with fresh paint"
        />
        <div class="absolute inset-0 bg-gray-900/50"></div>
      </div>
    </Fragment>
  </Hero>

  <!-- Content Widget **************** -->

  <Content
    id="about"
    tagline="About One Coat Painters"
    title="Locations Served"
    items={[
      {
        title: 'Vernon Hills',
        description: 'Our home base, serving all residential and commercial properties.',
      },
      {
        title: 'Lake County',
        description: 'Comprehensive coverage throughout Lake County communities.',
      },
      {
        title: 'Surrounding Areas',
        description: 'Extended service area including nearby municipalities.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1581858726788-75bc0f6a952d?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80',
      alt: 'Professional painter at work',
      loading: 'eager',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">One Coat Painters Services</h2>
      <p>
        One Coat Painters is a nationally-trusted painting company that has made its mark as one of the most dependable
        painting service providers in the country. We bring years of experience and a commitment to excellence to every
        project.
      </p>
      <br />
      <p>
        Our team of professional painters is dedicated to transforming your space with premium paints, expert
        techniques, and meticulous attention to detail. From color consultation to final cleanup, we handle every aspect
        of your painting project.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-slate-800"></div>
    </Fragment>
  </Content>

  <!-- Features Widget *************** -->

  <Features
    id="services"
    tagline="Our Services"
    title="One Coat Painters Services"
    subtitle="One Coat Painters is a nationally-trusted painting company that has made its mark as one of the most dependable painting service providers in the country."
    items={[
      {
        title: 'Interior Painting',
        description: 'Transform your indoor spaces with premium paints and expert application techniques.',
        icon: 'tabler:home',
      },
      {
        title: 'Exterior Painting',
        description: "Protect and beautify your home's exterior with weather-resistant coatings.",
        icon: 'tabler:building',
      },
      {
        title: 'Cabinet Painting',
        description: 'Give your kitchen or bathroom a fresh new look with professional cabinet refinishing.',
        icon: 'tabler:tools-kitchen-2',
      },
      {
        title: 'Drywall Repair',
        description: 'Complete drywall repair and preparation services for a flawless finish.',
        icon: 'tabler:wall',
      },
      {
        title: 'Color Consulting',
        description: 'Expert guidance in selecting the perfect colors for your space.',
        icon: 'tabler:palette',
      },
      {
        title: 'Pressure Washing',
        description: 'Prepare surfaces properly with our professional pressure washing services.',
        icon: 'tabler:wash',
      },
    ]}
  />

  <!-- Steps Widget ****************** -->

  <Steps
    id="process"
    title="The One Coat Painters Process"
    items={[
      {
        title: 'Step 1: <span class="font-medium">Free Consultation</span>',
        description:
          "Contact us for a free, no-obligation estimate. We'll assess your project and provide detailed pricing.",
        icon: 'tabler:package',
      },
      {
        title: 'Step 2: <span class="font-medium">Color Selection</span>',
        description: 'Work with our color experts to choose the perfect palette that matches your vision and style.',
        icon: 'tabler:letter-case',
      },
      {
        title: 'Step 3: <span class="font-medium">Surface Preparation</span>',
        description: 'Thorough cleaning, repairs, and priming to ensure the longest-lasting, most beautiful results.',
        icon: 'tabler:paint',
      },
      {
        title: 'Step 4: <span class="font-medium">Professional Application</span>',
        description: 'Expert application using premium paints and proven techniques for a flawless finish.',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1589939705384-5185137a7f0f?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80',
      alt: 'Painting process steps',
    }}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    id="features"
    title="From Start to Finish"
    subtitle="Residential Interior Painting"
    columns={2}
    items={[
      {
        title: 'Living Rooms',
        description: 'Create the perfect atmosphere for relaxation and entertainment.',
        icon: 'tabler:sofa',
      },
      {
        title: 'Bedrooms',
        description: 'Design peaceful retreats with colors that promote rest and tranquility.',
        icon: 'tabler:bed',
      },
      {
        title: 'Kitchens',
        description: 'Bright, clean finishes that complement your culinary space.',
        icon: 'tabler:chef-hat',
      },
      {
        title: 'Bathrooms',
        description: 'Moisture-resistant paints perfect for high-humidity environments.',
        icon: 'tabler:bath',
      },
      {
        title: 'Home Offices',
        description: 'Inspiring colors that boost productivity and creativity.',
        icon: 'tabler:briefcase',
      },
      {
        title: 'Trim & Doors',
        description: 'Crisp, clean lines that add the perfect finishing touch.',
        icon: 'tabler:door',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1586023492125-27b2c045efd7?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80',
      alt: 'Beautiful modern interior',
    }}
  />

  <!-- Another Features3 Widget for Exterior -->

  <Features3
    id="exterior"
    title="Residential Exterior Painting"
    subtitle="Protect and beautify your home's exterior with professional painting services that stand up to the elements."
    columns={2}
    items={[
      {
        title: 'Siding',
        description: 'Complete siding painting with premium exterior paints and proper surface preparation.',
        icon: 'tabler:home-2',
      },
      {
        title: 'Trim & Shutters',
        description: 'Detailed work on all exterior trim, shutters, and architectural elements.',
        icon: 'tabler:window',
      },
      {
        title: 'Doors & Frames',
        description: 'Front doors, garage doors, and all exterior entrance ways.',
        icon: 'tabler:door-enter',
      },
      {
        title: 'Deck & Fencing',
        description: 'Protect and beautify outdoor structures with specialized coatings.',
        icon: 'tabler:fence',
      },
      {
        title: 'Garage Doors',
        description: 'Curb appeal enhancement with professional garage door refinishing.',
        icon: 'tabler:car-garage',
      },
      {
        title: 'Power Washing',
        description: 'Thorough cleaning and preparation before any painting begins.',
        icon: 'tabler:wash-machine',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1570129477492-45c003edd2be?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80',
      alt: 'Beautiful home exterior',
    }}
  />

  <!-- Stats Widget ****************** -->

  <Stats
    title="Our 3+3+3 Service Pledge"
    subtitle="We stand behind our work with comprehensive guarantees"
    stats={[
      { title: 'Get Estimate Within 3 Business Days', amount: '3' },
      { title: 'Start Project Within 3 Weeks', amount: '3' },
      { title: 'Year Warranty', amount: '3' },
    ]}
  />

  <!-- Testimonials Widget *********** -->

  <Testimonials
    title="What Our Clients Say"
    subtitle="Don't just take our word for it - hear from homeowners who've experienced the One Coat difference."
    testimonials={[
      {
        testimonial: `The team at One Coat Painters did an absolutely amazing job on our home interior. They were professional, clean, and the attention to detail was incredible. I would definitely recommend them to anyone looking for quality painting services.`,
        name: 'Sarah M.',
        job: 'Vernon Hills Homeowner',
        image: {
          src: 'https://images.unsplash.com/photo-1438761681033-6461ffad8d80?ixlib=rb-4.0.3&auto=format&fit=crop&w=150&q=80',
          alt: 'Sarah M.',
        },
      },
      {
        testimonial: `Outstanding work from start to finish. The crew was punctual, respectful of our home, and delivered exactly what they promised. Our exterior looks brand new and has already received numerous compliments from neighbors.`,
        name: 'Mike R.',
        job: 'Lake County Resident',
        image: {
          src: 'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?ixlib=rb-4.0.3&auto=format&fit=crop&w=150&q=80',
          alt: 'Mike R.',
        },
      },
      {
        testimonial: `One Coat Painters transformed our kitchen with their cabinet painting service. It looks like we got a complete kitchen renovation at a fraction of the cost. Highly recommend!`,
        name: 'Jennifer L.',
        job: 'Happy Customer',
        image: {
          src: 'https://images.unsplash.com/photo-1494790108755-2616b612b1bc?ixlib=rb-4.0.3&auto=format&fit=crop&w=150&q=80',
          alt: 'Jennifer L.',
        },
      },
    ]}
  />

  <!-- Content Widget for Easy Pay -->

  <Content
    id="easy-pay"
    tagline="One Coat Easy Pay"
    title="Wait until you see what we can do."
    items={[
      {
        title: 'Flexible Payment Options',
        description: 'Multiple payment methods to fit your budget and timeline.',
      },
      {
        title: 'No Hidden Fees',
        description: 'Transparent pricing with detailed estimates and no surprises.',
      },
      {
        title: 'Financing Available',
        description: 'Ask about our financing options for larger projects.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1560518883-ce09059eeffa?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80',
      alt: 'Modern painted room',
      loading: 'eager',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Painting Done RIGHT! Is more than a tagline.
      </h2>
      <p>
        At One Coat Painters, we believe that quality painting should be accessible to everyone. That's why we offer
        flexible payment options and transparent pricing to help you achieve the beautiful space you've always wanted.
      </p>
      <br />
      <p>
        Our commitment to excellence means using only premium paints, employing skilled craftspeople, and standing
        behind our work with comprehensive warranties. When you choose One Coat, you're investing in lasting beauty and
        protection for your property.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-gray-50 dark:bg-slate-800"></div>
    </Fragment>
  </Content>

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="Frequently Asked Questions"
    subtitle="Find answers to common questions about our painting services and process."
    tagline="FAQs"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'How long does a typical painting project take?',
        description:
          "Project timelines vary based on size and scope. Interior rooms typically take 2-3 days, while whole house exteriors may take 5-7 days. We'll provide a detailed timeline during your consultation.",
      },
      {
        title: 'Do you provide free estimates?',
        description:
          'Yes! We offer free, no-obligation estimates for all projects. Our team will assess your needs and provide detailed pricing with no hidden fees.',
      },
      {
        title: 'What type of paint do you use?',
        description:
          'We use only premium brands like Sherwin-Williams and Benjamin Moore. Our experts will recommend the best paint type based on your specific needs, surface, and environment.',
      },
      {
        title: 'Are you licensed and insured?',
        description:
          'Absolutely. One Coat Painters is fully licensed and insured for your protection and peace of mind. We can provide proof of insurance upon request.',
      },
      {
        title: 'Do you offer warranties on your work?',
        description:
          'Yes, we stand behind our work with a comprehensive 3-year warranty on all painting services. This covers both materials and workmanship.',
      },
      {
        title: 'Can you help with color selection?',
        description:
          'Definitely! Our color consultants can help you choose the perfect colors that complement your space, lighting, and personal style. This service is included with every project.',
      },
    ]}
  />

  <!-- Contact Widget **************** -->

  <Contact
    id="contact"
    title="Get Your Free Quote Today"
    subtitle="Ready to transform your space? Contact One Coat Painters for your free, no-obligation estimate."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Name',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email',
      },
      {
        type: 'tel',
        name: 'phone',
        label: 'Phone',
      },
    ]}
    textarea={{
      label: 'Project Details',
      name: 'message',
      placeholder: 'Tell us about your painting project...',
    }}
    disclaimer={{
      label:
        'By submitting this contact form, you acknowledge and agree to the collection of your personal information.',
    }}
    description="Let's chat about your painting project."
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    title="Paint Yourself Into a Corner."
    subtitle="Transform your space today with One Coat Painters. Professional results, guaranteed satisfaction."
    actions={[
      {
        variant: 'primary',
        text: 'Get Free Quote',
        href: '#contact',
      },
      {
        variant: 'secondary',
        text: 'Call Now',
        href: 'tel:+1-555-PAINTER',
      },
    ]}
  />
</PageLayout>
