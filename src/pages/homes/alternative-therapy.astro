---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Contact from '~/components/widgets/Contact.astro';
import Header from '~/components/widgets/Header.astro';

const metadata = {
  title: 'Blue Rain Lily | Alternative Therapy & Human Design',
  description: "Dive deep with Lauren Steel's somatic therapy and Quantum Human Design to unlock your true flow.",
  robots: {
    index: true,
    follow: true,
  },
  openGraph: {
    type: 'website',
    siteName: 'Blue Rain Lily',
  },
  twitter: {
    cardType: 'summary_large_image',
  },
};
---

<PageLayout metadata={metadata}>
  <Fragment slot="header">
    <Header
      links={[
        { text: 'Home', href: '#' },
        { text: 'About', href: '#' },
        { text: 'Testimonials', href: '#' },
        { text: 'Blog', href: '#' },
      ]}
      actions={[]}
      isSticky
      showToggleTheme
      position="left"
      isDark={true}
    >
      <Fragment slot="logo">
        <span class="font-bold text-xl text-white">Blue Rain Lily</span>
      </Fragment>
    </Header>
  </Fragment>

  <!-- Hero Section ******************* -->
  <Hero
    id="hero"
    title="Embodied Healing & Human Design"
    subtitle="Dive deep with Lauren Steel's somatic therapy and Quantum Human Design to unlock your true flow."
    actions={[
      {
        variant: 'primary',
        text: 'Book Your Session',
        href: '#contact',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 hero-gradient"></div>
    </Fragment>
  </Hero>

  <!-- Services Section *************** -->
  <Features2
    id="services"
    title="Services"
    tagline="Our Offerings"
    columns={2}
    items={[
      {
        title: '1:1 Therapy Sessions',
        description: 'Personalized embodiment coaching and somatic support.',
        icon: 'tabler:user-heart',
      },
      {
        title: 'Human Design Readings',
        description: 'Discover your unique blueprint to thrive with ease.',
        icon: 'tabler:compass',
      },
      {
        title: 'Relationship & Family Readings',
        description: 'Deepen connections and understand shared dynamics.',
        icon: 'tabler:heart-handshake',
      },
      {
        title: 'HD Deep Dive',
        description: 'Extended journey for profound rewiring & growth.',
        icon: 'tabler:telescope',
      },
    ]}
    classes={{
      container: 'bg-slate-50 dark:bg-slate-900 animate-on-scroll',
    }}
  />

  <!-- Contact Section **************** -->
  <Contact
    id="contact"
    title="Start Your Journey"
    subtitle="Ready to align with your design? Send Lauren a message and she'll reach out."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Your Name',
        placeholder: 'Your Name',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Your Email',
        placeholder: 'Your Email',
      },
    ]}
    textarea={{
      label: 'How can Lauren help you?',
      name: 'message',
      placeholder: 'How can Lauren help you?',
      rows: 4,
    }}
    button="Send Message"
    description="© 2025 Blue Rain Lily. All rights reserved."
    isDark={true}
    classes={{
      container: 'animate-on-scroll',
    }}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-gradient-to-br from-slate-900 via-slate-800 to-slate-700"></div>
    </Fragment>
  </Contact>

  <style>
    /* Custom animations for on-scroll effects */
    .animate-on-scroll {
      opacity: 0;
      transform: translateY(30px);
      transition: all 0.6s ease-out;
    }

    .animate-on-scroll.intersect {
      opacity: 1;
      transform: translateY(0);
    }

    /* Custom button styling using CSS variables for theme adaptability */
    #hero .btn-primary {
      background: var(--gradient-cta) !important;
      color: white !important;
      font-weight: 600 !important;
      padding: 12px 32px !important;
      border-radius: 9999px !important;
      border: none !important;
      transition: all 0.3s ease !important;
    }

    #hero .btn-primary:hover {
      background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)) !important;
      transform: translateY(-2px) !important;
      box-shadow: 0 10px 20px var(--color-accent) !important;
      opacity: 0.9;
    }

    /* Hero section gradient using design token */
    .hero-gradient {
      background: var(--gradient-hero);
    }
  </style>

  <script>
    // Intersection Observer for scroll animations
    document.addEventListener('DOMContentLoaded', () => {
      const animatedElements = document.querySelectorAll('.animate-on-scroll');

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('intersect');
            }
          });
        },
        {
          threshold: 0.1,
          rootMargin: '0px 0px -50px 0px',
        }
      );

      animatedElements.forEach((el) => {
        observer.observe(el);
      });
    });
  </script>
</PageLayout>
