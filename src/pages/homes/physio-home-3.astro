---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Physical Therapy - Boutique 1-on-1 Care | Personalized Treatment',
  description:
    'Experience personalized, one-on-one physical therapy care. Private sessions with evidence-based treatment in an inclusive environment.',
  robots: {
    index: true,
    follow: true,
  },
  openGraph: {
    type: 'website',
    title: 'Physical Therapy - Boutique 1-on-1 Care',
    description: 'Experience personalized, one-on-one physical therapy care.',
  },
  twitter: {
    card: 'summary_large_image',
    title: 'Physical Therapy - Boutique 1-on-1 Care',
    description: 'Experience personalized, one-on-one physical therapy care.',
  },
};
---

<PageLayout metadata={metadata}>
  <!-- Minimal Centered Hero -->
  <Hero
    tagline="Boutique Physical Therapy"
    title="One-on-One Physical Therapy"
    subtitle="Experience the difference of personalized care. Every session is designed specifically for you, with your therapist's complete attention."
    actions={[
      {
        text: 'Book Online',
        href: '#appointment',
        variant: 'primary',
      },
      {
        text: 'Free 15-min Call',
        href: 'tel:+1234567890',
        variant: 'secondary',
      },
    ]}
  >
    <div slot="content" class="text-center py-24 animate-on-scroll"></div>
  </Hero>

  <!-- USP Section - 3 Icon Columns -->
  <Features
    title="Why Choose One-on-One Care?"
    subtitle="Experience the boutique difference with personalized attention"
    items={[
      {
        title: 'Private Sessions',
        description:
          "Your therapist's complete focus and attention throughout your entire session. No distractions, no rushing.",
        icon: 'tabler:user-heart',
      },
      {
        title: 'Evidence-Based',
        description:
          'Treatment plans grounded in the latest research and proven techniques tailored to your specific needs.',
        icon: 'tabler:certificate',
      },
      {
        title: 'Inclusive Care',
        description:
          'A welcoming environment where every person feels valued, respected, and understood regardless of background.',
        icon: 'tabler:heart-handshake',
      },
    ]}
    classes={{
      container: 'animate-on-scroll bg-gradient-to-b from-white to-gray-50',
    }}
  />

  <!-- Therapist Spotlight -->
  <section class="py-16 animate-on-scroll">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-text-heading)] mb-4">Meet Your Therapist</h2>
        <p class="text-lg text-[var(--color-text-muted)] max-w-2xl mx-auto">
          Work directly with experienced, licensed professionals who are passionate about your recovery.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
        <div
          class="therapist-card bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300"
        >
          <img
            src="https://images.unsplash.com/photo-1559839734-2b71ea197ec2?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80"
            alt="Dr. Sarah Chen"
            class="w-full h-48 object-cover"
          />
          <div class="p-6">
            <h3 class="text-xl font-semibold text-[var(--color-text-heading)] mb-2">Dr. Sarah Chen, DPT</h3>
            <p class="text-[var(--color-text-muted)] text-sm mb-3">Sports & Orthopedic Specialist</p>
            <div class="therapist-details opacity-0 max-h-0 overflow-hidden transition-all duration-300">
              <ul class="text-sm text-[var(--color-text-default)] space-y-1 mb-4">
                <li>• 8 years experience</li>
                <li>• USC Graduate</li>
                <li>• Former athlete specialist</li>
                <li>• Certified in dry needling</li>
              </ul>
              <p class="text-sm text-[var(--color-text-muted)]">
                "I believe in empowering patients through education and personalized treatment plans."
              </p>
            </div>
          </div>
        </div>

        <div
          class="therapist-card bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300"
        >
          <img
            src="https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80"
            alt="Dr. Michael Rodriguez"
            class="w-full h-48 object-cover"
          />
          <div class="p-6">
            <h3 class="text-xl font-semibold text-[var(--color-text-heading)] mb-2">Dr. Michael Rodriguez, DPT</h3>
            <p class="text-[var(--color-text-muted)] text-sm mb-3">Neurological Rehabilitation</p>
            <div class="therapist-details opacity-0 max-h-0 overflow-hidden transition-all duration-300">
              <ul class="text-sm text-[var(--color-text-default)] space-y-1 mb-4">
                <li>• 12 years experience</li>
                <li>• NYU Graduate</li>
                <li>• Stroke recovery specialist</li>
                <li>• Balance disorder expert</li>
              </ul>
              <p class="text-sm text-[var(--color-text-muted)]">
                "Every small improvement is a victory worth celebrating."
              </p>
            </div>
          </div>
        </div>

        <div
          class="therapist-card bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300"
        >
          <img
            src="https://images.unsplash.com/photo-1594824919068-59a29dffb6bf?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80"
            alt="Dr. Lisa Park"
            class="w-full h-48 object-cover"
          />
          <div class="p-6">
            <h3 class="text-xl font-semibold text-[var(--color-text-heading)] mb-2">Dr. Lisa Park, DPT</h3>
            <p class="text-[var(--color-text-muted)] text-sm mb-3">Women's Health Specialist</p>
            <div class="therapist-details opacity-0 max-h-0 overflow-hidden transition-all duration-300">
              <ul class="text-sm text-[var(--color-text-default)] space-y-1 mb-4">
                <li>• 10 years experience</li>
                <li>• Stanford Graduate</li>
                <li>• Pelvic floor specialist</li>
                <li>• Pre/postnatal expert</li>
              </ul>
              <p class="text-sm text-[var(--color-text-muted)]">
                "Creating a safe, comfortable space for women's health needs."
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Conditions Carousel -->
  <section class="py-16 bg-gray-50 animate-on-scroll">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-text-heading)] mb-4">Conditions We Treat</h2>
        <p class="text-lg text-[var(--color-text-muted)] max-w-2xl mx-auto">
          Specialized care for a wide range of conditions with personalized treatment approaches.
        </p>
      </div>

      <div class="flex overflow-x-auto space-x-6 pb-4 conditions-scroll">
        <div class="flex-shrink-0 w-48 bg-white rounded-lg p-6 text-center shadow-md hover:shadow-lg transition-shadow">
          <div class="text-4xl mb-3">🦴</div>
          <h3 class="font-semibold text-[var(--color-text-heading)] mb-2">Back Pain</h3>
          <p class="text-sm text-[var(--color-text-muted)]">Lower back, upper back, and sciatica</p>
        </div>

        <div class="flex-shrink-0 w-48 bg-white rounded-lg p-6 text-center shadow-md hover:shadow-lg transition-shadow">
          <div class="text-4xl mb-3">🦵</div>
          <h3 class="font-semibold text-[var(--color-text-heading)] mb-2">Knee Injuries</h3>
          <p class="text-sm text-[var(--color-text-muted)]">ACL, meniscus, and arthritis</p>
        </div>

        <div class="flex-shrink-0 w-48 bg-white rounded-lg p-6 text-center shadow-md hover:shadow-lg transition-shadow">
          <div class="text-4xl mb-3">💪</div>
          <h3 class="font-semibold text-[var(--color-text-heading)] mb-2">Shoulder Pain</h3>
          <p class="text-sm text-[var(--color-text-muted)]">Rotator cuff and impingement</p>
        </div>

        <div class="flex-shrink-0 w-48 bg-white rounded-lg p-6 text-center shadow-md hover:shadow-lg transition-shadow">
          <div class="text-4xl mb-3">🧠</div>
          <h3 class="font-semibold text-[var(--color-text-heading)] mb-2">Concussion</h3>
          <p class="text-sm text-[var(--color-text-muted)]">Vestibular and cognitive rehab</p>
        </div>

        <div class="flex-shrink-0 w-48 bg-white rounded-lg p-6 text-center shadow-md hover:shadow-lg transition-shadow">
          <div class="text-4xl mb-3">👩</div>
          <h3 class="font-semibold text-[var(--color-text-heading)] mb-2">Pelvic Health</h3>
          <p class="text-sm text-[var(--color-text-muted)]">Pre/postnatal and dysfunction</p>
        </div>

        <div class="flex-shrink-0 w-48 bg-white rounded-lg p-6 text-center shadow-md hover:shadow-lg transition-shadow">
          <div class="text-4xl mb-3">⚽</div>
          <h3 class="font-semibold text-[var(--color-text-heading)] mb-2">Sports Injuries</h3>
          <p class="text-sm text-[var(--color-text-muted)]">Return to sport focused</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Patient Testimonials -->
  <Testimonials
    title="What Our Patients Say"
    subtitle="Experience the difference that personalized, one-on-one care makes"
    testimonials={[
      {
        testimonial:
          'Finally found a place that actually listens. My therapist spent the full hour with me every session, no rushing or distractions.',
        name: 'Emma Wilson',
        job: 'Teacher',
        image: {
          src: 'https://images.unsplash.com/photo-1494790108755-2616b612b786?ixlib=rb-4.0.3&auto=format&fit=crop&w=300&q=80',
          alt: 'Emma Wilson',
        },
      },
      {
        testimonial:
          'The level of expertise and personal attention is unmatched. I felt like I was their only patient.',
        name: 'David Park',
        job: 'Software Engineer',
        image: {
          src: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?ixlib=rb-4.0.3&auto=format&fit=crop&w=300&q=80',
          alt: 'David Park',
        },
      },
      {
        testimonial:
          'As a busy mom, having someone who understands my time constraints and works with my schedule means everything.',
        name: 'Jennifer Lee',
        job: 'Working Mom',
        image: {
          src: 'https://images.unsplash.com/photo-1438761681033-6461ffad8d80?ixlib=rb-4.0.3&auto=format&fit=crop&w=300&q=80',
          alt: 'Jennifer Lee',
        },
      },
    ]}
    classes={{
      container: 'animate-on-scroll',
    }}
  />

  <!-- CTA Footer with Gradient -->
  <CallToAction
    title="Experience Boutique Physical Therapy"
    subtitle="Ready for personalized, one-on-one care? Book your initial consultation and discover what focused attention can do for your recovery."
    actions={[
      {
        variant: 'primary',
        text: 'Book Consultation',
        href: '#appointment',
      },
      {
        variant: 'secondary',
        text: 'Free 15-min Call',
        href: 'tel:+1234567890',
      },
    ]}
    classes={{
      container:
        'bg-gradient-to-r from-[var(--color-accent)] via-[var(--color-primary)] to-[var(--color-secondary)] text-white animate-on-scroll',
    }}
  >
    <!-- Inline appointment form -->
    <div slot="content" class="mt-8 max-w-md mx-auto">
      <form class="space-y-4 bg-white/10 backdrop-blur-sm rounded-lg p-6">
        <div>
          <input
            type="text"
            placeholder="Your Name"
            class="w-full px-4 py-3 rounded-lg border border-white/20 bg-white/10 text-white placeholder-white/70 focus:outline-none focus:ring-2 focus:ring-white/50"
          />
        </div>
        <div>
          <input
            type="email"
            placeholder="Email Address"
            class="w-full px-4 py-3 rounded-lg border border-white/20 bg-white/10 text-white placeholder-white/70 focus:outline-none focus:ring-2 focus:ring-white/50"
          />
        </div>
        <div>
          <input
            type="tel"
            placeholder="Phone Number"
            class="w-full px-4 py-3 rounded-lg border border-white/20 bg-white/10 text-white placeholder-white/70 focus:outline-none focus:ring-2 focus:ring-white/50"
          />
        </div>
        <div>
          <select
            class="w-full px-4 py-3 rounded-lg border border-white/20 bg-white/10 text-white focus:outline-none focus:ring-2 focus:ring-white/50"
          >
            <option value="">Preferred Time</option>
            <option value="morning">Morning (8am-12pm)</option>
            <option value="afternoon">Afternoon (12pm-5pm)</option>
            <option value="evening">Evening (5pm-8pm)</option>
          </select>
        </div>
        <div>
          <textarea
            placeholder="Brief description of your concern"
            rows="3"
            class="w-full px-4 py-3 rounded-lg border border-white/20 bg-white/10 text-white placeholder-white/70 focus:outline-none focus:ring-2 focus:ring-white/50 resize-none"
          ></textarea>
        </div>
        <button
          type="submit"
          class="w-full bg-white text-[var(--color-primary)] px-6 py-3 rounded-lg font-semibold hover:bg-gray-100 transition-colors"
        >
          Request Appointment
        </button>
      </form>
    </div>
  </CallToAction>

  <style>
    .animate-on-scroll {
      opacity: 0;
      transform: translateY(20px);
      transition:
        opacity 0.6s ease-out,
        transform 0.6s ease-out;
    }

    .animate-on-scroll.visible {
      opacity: 1;
      transform: translateY(0);
    }

    .therapist-card:hover .therapist-details {
      opacity: 1;
      max-height: 200px;
    }

    .conditions-scroll {
      scrollbar-width: thin;
      scrollbar-color: rgba(0, 0, 0, 0.2) transparent;
    }

    .conditions-scroll::-webkit-scrollbar {
      height: 6px;
    }

    .conditions-scroll::-webkit-scrollbar-track {
      background: rgba(0, 0, 0, 0.1);
      border-radius: 3px;
    }

    .conditions-scroll::-webkit-scrollbar-thumb {
      background: rgba(0, 0, 0, 0.3);
      border-radius: 3px;
    }

    @media (prefers-reduced-motion: reduce) {
      .animate-on-scroll {
        opacity: 1;
        transform: none;
        transition: none;
      }
      .therapist-card .therapist-details {
        opacity: 1;
        max-height: none;
      }
    }
  </style>

  <script>
    // Intersection Observer for scroll animations
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px',
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, observerOptions);

    // Observe all elements with animate-on-scroll class
    document.querySelectorAll('.animate-on-scroll').forEach((el) => {
      observer.observe(el);
    });

    // Form submission
    document.querySelector('form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      // Here you would integrate with your booking system
      alert('Thank you! We will contact you within 24 hours to schedule your consultation.');
    });
  </script>
</PageLayout>
