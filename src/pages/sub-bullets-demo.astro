---
import Layout from '~/layouts/PageLayout.astro';
import IconListItemSlot from '~/components/ui/IconListItemSlot.astro';
import IconListItemWithSubBullets from '~/components/ui/IconListItemWithSubBullets.astro';
import IconListWithSubBullets from '~/components/ui/IconListWithSubBullets.astro';

// Sample data for the beginner session
const beginnerSessionData = [
  {
    title: 'Beginner Session (30 minutes): Planting Seeds',
    description:
      "Start your Human Design journey by planting the seeds of self-awareness. In this foundational session, you'll learn about your Type, Strategy, and Authority—the essential elements that will help your self-understanding take root.",
    icon: 'tabler:seedling',
    subBullets: [
      { text: 'A clear introduction to the core aspects of your chart' },
      { text: 'Simple, actionable insights to begin living your design' },
      { text: "Guidance on how to notice your body's natural responses" },
    ],
  },
  {
    title: 'Intermediate Session (45 minutes): Growing Understanding',
    description: 'Deepen your Human Design knowledge by exploring your centers, channels, and gates.',
    icon: 'tabler:plant',
    subBullets: [
      { text: 'Detailed analysis of your energy centers' },
      { text: 'Understanding your defined and undefined centers' },
      { text: 'Practical exercises for decision-making' },
      { text: 'Integration strategies for daily life' },
    ],
  },
  {
    title: 'Advanced Session (60 minutes): Full Bloom',
    description:
      'Comprehensive exploration of your complete Human Design chart with focus on life themes and incarnation cross.',
    icon: 'tabler:flower',
    subBullets: [
      { text: 'Complete chart analysis including incarnation cross' },
      { text: 'Profile lines and life themes exploration' },
      { text: 'Relationship dynamics and compatibility' },
      { text: 'Career and life purpose alignment' },
      { text: 'Advanced decision-making strategies' },
    ],
  },
];

const metadata = {
  title: 'Sub-Bullets Demo - Human Design Sessions',
  description:
    'Demonstration of icon list components with sub-bullet support for displaying detailed session information.',
  robots: {
    index: true,
    follow: true,
  },
};
---

<Layout metadata={metadata}>
  <main class="py-12 md:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <!-- Page Header -->
      <div class="text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">Sub-Bullets Demo</h1>
        <p class="text-xl text-muted dark:text-slate-400 max-w-3xl mx-auto">
          Three different approaches for displaying lists with sub-bullets: structured data, slot-based content, and
          traditional bullet points.
        </p>
      </div>

      <!-- Method 1: Structured Sub-Bullets -->
      <section class="mb-16">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-8">Method 1: Structured Sub-Bullets</h2>
        <p class="text-lg text-muted dark:text-slate-400 mb-8">
          Using <code>IconListWithSubBullets</code> component with structured data. Perfect for consistent formatting.
        </p>

        <div
          class="bg-gradient-to-br from-blue-50 to-purple-50 dark:from-slate-800 dark:to-slate-700 rounded-2xl p-8 md:p-12"
        >
          <IconListWithSubBullets
            items={beginnerSessionData}
            columns={1}
            iconColor="primary"
            size="md"
            spacing="loose"
            subBulletStyle="bullet"
          />
        </div>
      </section>

      <!-- Method 2: Slot-Based Content -->
      <section class="mb-16">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-8">Method 2: Slot-Based Content</h2>
        <p class="text-lg text-muted dark:text-slate-400 mb-8">
          Using <code>IconListItemSlot</code> component with custom HTML content. Maximum flexibility for complex layouts.
        </p>

        <div class="space-y-8">
          <IconListItemSlot
            icon="tabler:seedling"
            title="Beginner Session (30 minutes): Planting Seeds"
            iconColor="success"
            size="md"
          >
            <p class="mb-3">
              Start your Human Design journey by planting the seeds of self-awareness. In this foundational session,
              you'll learn about your Type, Strategy, and Authority—the essential elements that will help your
              self-understanding take root.
            </p>
            <h4 class="font-semibold text-gray-900 dark:text-white mb-2">What you'll receive:</h4>
            <ul class="space-y-2">
              <li class="flex items-start gap-2">
                <span class="text-green-600 dark:text-green-500 font-medium mt-0.5">•</span>
                <span>A clear introduction to the core aspects of your chart</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-green-600 dark:text-green-500 font-medium mt-0.5">•</span>
                <span>Simple, actionable insights to begin living your design</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-green-600 dark:text-green-500 font-medium mt-0.5">•</span>
                <span>Guidance on how to notice your body's natural responses</span>
              </li>
            </ul>
          </IconListItemSlot>

          <IconListItemSlot
            icon="tabler:plant"
            title="Intermediate Session (45 minutes): Growing Understanding"
            iconColor="primary"
            size="md"
          >
            <p class="mb-3">Deepen your Human Design knowledge by exploring your centers, channels, and gates.</p>
            <div class="bg-blue-50 dark:bg-slate-700 rounded-lg p-4">
              <h4 class="font-semibold text-blue-900 dark:text-blue-100 mb-2">Session Includes:</h4>
              <div class="grid md:grid-cols-2 gap-2 text-sm">
                <div>• Detailed analysis of your energy centers</div>
                <div>• Understanding defined/undefined centers</div>
                <div>• Practical decision-making exercises</div>
                <div>• Daily life integration strategies</div>
              </div>
            </div>
          </IconListItemSlot>
        </div>
      </section>

      <!-- Method 3: Different Sub-Bullet Styles -->
      <section class="mb-16">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-8">Method 3: Different Sub-Bullet Styles</h2>
        <p class="text-lg text-muted dark:text-slate-400 mb-8">
          Various formatting options for sub-bullets: traditional bullets, icons, and dashes.
        </p>

        <div class="grid lg:grid-cols-3 gap-8">
          <!-- Bullet Style -->
          <div class="bg-white dark:bg-slate-800 rounded-lg p-6 shadow-sm border border-gray-200 dark:border-gray-700">
            <h3 class="text-lg font-semibold mb-4 text-gray-900 dark:text-white">Bullet Style</h3>
            <IconListItemWithSubBullets
              icon="tabler:seedling"
              title="Session Benefits"
              description="What you'll gain from this experience:"
              iconColor="success"
              size="sm"
              subBulletStyle="bullet"
              subBullets={[
                { text: 'Clear understanding of your design' },
                { text: 'Practical tools for daily life' },
                { text: 'Body awareness techniques' },
              ]}
            />
          </div>

          <!-- Icon Style -->
          <div class="bg-white dark:bg-slate-800 rounded-lg p-6 shadow-sm border border-gray-200 dark:border-gray-700">
            <h3 class="text-lg font-semibold mb-4 text-gray-900 dark:text-white">Icon Style</h3>
            <IconListItemWithSubBullets
              icon="tabler:compass"
              title="Session Benefits"
              description="What you'll gain from this experience:"
              iconColor="primary"
              size="sm"
              subBulletStyle="icon"
              subBullets={[
                { text: 'Clear understanding of your design', icon: 'tabler:check' },
                { text: 'Practical tools for daily life', icon: 'tabler:tools' },
                { text: 'Body awareness techniques', icon: 'tabler:heart' },
              ]}
            />
          </div>

          <!-- Dash Style -->
          <div class="bg-white dark:bg-slate-800 rounded-lg p-6 shadow-sm border border-gray-200 dark:border-gray-700">
            <h3 class="text-lg font-semibold mb-4 text-gray-900 dark:text-white">Dash Style</h3>
            <IconListItemWithSubBullets
              icon="tabler:target"
              title="Session Benefits"
              description="What you'll gain from this experience:"
              iconColor="accent"
              size="sm"
              subBulletStyle="dash"
              subBullets={[
                { text: 'Clear understanding of your design' },
                { text: 'Practical tools for daily life' },
                { text: 'Body awareness techniques' },
              ]}
            />
          </div>
        </div>
      </section>

      <!-- Code Examples -->
      <section class="mb-16">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-8">Code Examples</h2>

        <div class="space-y-6">
          <!-- Structured Data Example -->
          <div class="bg-gray-50 dark:bg-slate-800 rounded-lg p-6">
            <h3 class="text-lg font-semibold mb-4 text-gray-800 dark:text-gray-200">1. Structured Sub-Bullets</h3>
            <pre
              class="bg-gray-900 text-green-400 p-4 rounded overflow-x-auto text-sm"><code>{`const sessionData = [
  {
    title: 'Beginner Session (30 minutes): Planting Seeds',
    description: 'Start your Human Design journey...',
    icon: 'tabler:seedling',
    subBullets: [
      { text: 'A clear introduction to the core aspects' },
      { text: 'Simple, actionable insights' },
      { text: 'Guidance on body responses' },
    ]
  }
];

<IconListWithSubBullets
  items={sessionData}
  columns={1}
  iconColor="primary"
  subBulletStyle="bullet"
/>`}</code></pre>
          </div>

          <!-- Slot-Based Example -->
          <div class="bg-gray-50 dark:bg-slate-800 rounded-lg p-6">
            <h3 class="text-lg font-semibold mb-4 text-gray-800 dark:text-gray-200">2. Slot-Based Content</h3>
            <pre
              class="bg-gray-900 text-green-400 p-4 rounded overflow-x-auto text-sm"><code>{`<IconListItemSlot
  icon="tabler:seedling"
  title="Beginner Session"
  iconColor="success"
>
  <p>Your custom description here...</p>
  <ul class="space-y-2">
    <li class="flex items-start gap-2">
      <span class="text-green-600">•</span>
      <span>Custom formatted bullet point</span>
    </li>
    <!-- More custom content -->
  </ul>
</IconListItemSlot>`}</code></pre>
          </div>

          <!-- Individual Item Example -->
          <div class="bg-gray-50 dark:bg-slate-800 rounded-lg p-6">
            <h3 class="text-lg font-semibold mb-4 text-gray-800 dark:text-gray-200">
              3. Individual Item with Sub-Bullets
            </h3>
            <pre
              class="bg-gray-900 text-green-400 p-4 rounded overflow-x-auto text-sm"><code>{`<IconListItemWithSubBullets
  icon="tabler:seedling"
  title="Session Title"
  description="Main description"
  iconColor="primary"
  subBulletStyle="icon"
  subBullets={[
    { text: 'First benefit', icon: 'tabler:check' },
    { text: 'Second benefit', icon: 'tabler:star' },
  ]}
/>`}</code></pre>
          </div>
        </div>
      </section>

      <!-- Usage Recommendations -->
      <section>
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-8">When to Use Each Method</h2>

        <div class="grid md:grid-cols-3 gap-6">
          <div class="bg-blue-50 dark:bg-blue-900/20 rounded-lg p-6 border border-blue-200 dark:border-blue-800">
            <h3 class="font-semibold text-blue-900 dark:text-blue-100 mb-3">Structured Sub-Bullets</h3>
            <p class="text-blue-800 dark:text-blue-200 text-sm">
              Best for consistent, data-driven content where all items follow the same format. Great for service
              offerings, feature lists, or process steps.
            </p>
          </div>

          <div class="bg-green-50 dark:bg-green-900/20 rounded-lg p-6 border border-green-200 dark:border-green-800">
            <h3 class="font-semibold text-green-900 dark:text-green-100 mb-3">Slot-Based Content</h3>
            <p class="text-green-800 dark:text-green-200 text-sm">
              Perfect for complex layouts, custom formatting, or when you need full control over the content structure.
              Maximum flexibility.
            </p>
          </div>

          <div
            class="bg-purple-50 dark:bg-purple-900/20 rounded-lg p-6 border border-purple-200 dark:border-purple-800"
          >
            <h3 class="font-semibold text-purple-900 dark:text-purple-100 mb-3">Mixed Approach</h3>
            <p class="text-purple-800 dark:text-purple-200 text-sm">
              Combine both methods as needed. Use structured data for consistency and slots for special cases or unique
              layouts.
            </p>
          </div>
        </div>
      </section>
    </div>
  </main>
</Layout>
