---
import Layout from '~/layouts/PageLayout.astro';
import IconListItemWithSubBullets from '~/components/ui/IconListItemWithSubBullets.astro';

const metadata = {
  title: 'Human Design Beginner Session',
  description: 'Learn about your Type, Strategy, and Authority in this foundational Human Design session.',
  robots: {
    index: true,
    follow: true,
  },
};
---

<Layout metadata={metadata}>
  <main class="py-12 md:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <!-- Beginner Session Section -->
      <div
        class="bg-gradient-to-br from-purple-50 to-pink-50 dark:from-slate-800 dark:to-slate-700 rounded-2xl p-8 md:p-12"
      >
        <IconListItemWithSubBullets
          icon="tabler:seedling"
          title="Beginner Session (30 minutes): Planting Seeds"
          description="Start your Human Design journey by planting the seeds of self-awareness. In this foundational session, you'll learn about your Type, Strategy, and Authority—the essential elements that will help your self-understanding take root."
          iconColor="primary"
          size="lg"
          subBullets={[
            { text: 'A clear introduction to the core aspects of your chart' },
            { text: 'Simple, actionable insights to begin living your design' },
            { text: "Guidance on how to notice your body's natural responses" },
          ]}
        />

        <!-- Call to Action -->
        <div class="mt-8 text-center">
          <button
            class="bg-primary hover:bg-primary/90 text-white font-semibold py-3 px-8 rounded-lg transition-colors duration-200"
          >
            Book Your Beginner Session
          </button>
        </div>
      </div>
    </div>
  </main>
</Layout>
