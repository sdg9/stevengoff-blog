---
import Layout from '~/layouts/PageLayout.astro';
import IconList from '~/components/ui/IconList.astro';

const therapyItems = [
  {
    title: 'Explore your present and your potential',
    description:
      'Understand where you are now, clarify where you want to go, and identify what might be holding you back.',
    icon: 'tabler:compass',
  },
  {
    title: 'Process and reframe your story',
    description: 'Gently revisit past experiences, reframe your narrative, and create space for healing.',
    icon: 'tabler:heart',
  },
  {
    title: 'Tune into your body',
    description:
      "Learn to listen to your body's wisdom through somatic (body-based) practices, even if you're new to this approach.",
    icon: 'tabler:user-heart',
  },
  {
    title: 'Blend science and intuition',
    description:
      'I integrate somatic attachment therapy with Human Design—a modern tool for self-understanding and decision-making—to support you in finding more ease and flow in your life.',
    icon: 'tabler:brain',
  },
  {
    title: 'Take actionable steps',
    description: "Together, we'll create practical, personalized steps to help you reach your goals.",
    icon: 'tabler:target',
  },
];

const metadata = {
  title: 'Therapy Services - Somatic Attachment Therapy',
  description:
    'Explore personalized therapy services combining somatic practices with Human Design for holistic healing and growth.',
  robots: {
    index: true,
    follow: true,
  },
  openGraph: {
    type: 'website',
    title: 'Therapy Services - Somatic Attachment Therapy',
    description:
      'Explore personalized therapy services combining somatic practices with Human Design for holistic healing and growth.',
  },
  twitter: {
    card: 'summary_large_image',
    title: 'Therapy Services - Somatic Attachment Therapy',
    description:
      'Explore personalized therapy services combining somatic practices with Human Design for holistic healing and growth.',
  },
};
---

<Layout metadata={metadata}>
  <main class="py-12 md:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <!-- Hero Section -->
      <div class="text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6 font-heading">
          Somatic Attachment Therapy
        </h1>
        <p class="text-xl text-muted dark:text-slate-400 max-w-3xl mx-auto mb-8">
          A holistic approach to healing that integrates body wisdom with modern therapeutic techniques
        </p>
      </div>

      <!-- Therapy Approach Section -->
      <section class="mb-16">
        <div
          class="bg-gradient-to-br from-blue-50 to-purple-50 dark:from-slate-800 dark:to-slate-700 rounded-2xl p-8 md:p-12"
        >
          <div class="max-w-4xl mx-auto">
            <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-8 text-center">My Therapeutic Approach</h2>
            <IconList items={therapyItems} columns={1} iconColor="primary" size="md" spacing="loose" />
          </div>
        </div>
      </section>

      <!-- Two Column Layout Example -->
      <section class="mb-16">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-8 text-center">Core Areas of Focus</h2>
        <IconList items={therapyItems.slice(0, 4)} columns={2} iconColor="success" size="md" spacing="normal" />
      </section>

      <!-- Call to Action -->
      <section class="text-center">
        <div class="bg-white dark:bg-slate-800 rounded-xl p-8 shadow-lg border border-gray-200 dark:border-gray-700">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Ready to Begin Your Healing Journey?</h2>
          <p class="text-lg text-muted dark:text-slate-400 mb-6">
            Let's work together to create a personalized path forward that honors both your mind and body.
          </p>
          <button
            class="bg-primary hover:bg-primary/90 text-white font-semibold py-3 px-8 rounded-lg transition-colors duration-200"
          >
            Schedule a Consultation
          </button>
        </div>
      </section>
    </div>
  </main>
</Layout>
