---
import Layout from '~/layouts/PageLayout.astro';
const metadata = {
  title: 'Privacy',
  description: 'How this site uses analytics and error reporting, and how to opt out of Google Analytics.',
};
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <h1 class="mb-8 text-4xl font-bold">Privacy</h1>
    <div class="prose dark:prose-invert max-w-none">
      <p>I use a few services to understand which posts people read and to find problems with the site.</p>
      <h2>Google Analytics</h2>
      <p>
        Google Analytics measures visits on stevengoff.dev and www.stevengoff.dev. It can use cookies to distinguish
        browsers and report traffic sources, device information, and pages visited. Advertising consent is denied,
        Google signals and ad personalization are disabled, and this site does not display a cookie-consent banner. You
        can turn off Google Analytics below.
      </p>
      <p>
        This preference is stored in your browser. It applies to future Google Analytics collection on this site; it
        does not delete information already collected. Set it separately on other browsers or devices. Clearing browser
        storage also clears the saved preference. If browser storage cannot be read, Google Analytics stays off.
      </p>
      <button id="analytics-opt-out" type="button" class="btn btn-primary">Turn off Google Analytics</button>
      <p id="analytics-preference" role="status" aria-live="polite"></p>
      <noscript>Google Analytics does not load when JavaScript is disabled.</noscript>
      <h2>Error reporting</h2>
      <p>
        Sentry helps me diagnose software errors. Reports can include error messages, stack traces, and browser or
        device context. Sending default personally identifiable information is disabled, and session replay is off. The
        Google Analytics control above does not disable Sentry.
      </p>
      <h2>Hosting analytics</h2>
      <p>
        Cloudflare hosts the site and provides its own web analytics. Automatic web analytics is configured to exclude
        visitors in the European Union. The Google Analytics preference does not control Cloudflare analytics or the
        operational data needed to serve and protect the site.
      </p>
      <p>
        Service details: <a href="https://policies.google.com/privacy">Google's privacy policy</a>,
        <a href="https://sentry.io/privacy/">Sentry's privacy policy</a>, and
        <a href="https://www.cloudflare.com/privacypolicy/">Cloudflare's privacy policy</a>.
      </p>
    </div>
  </section>
</Layout>

<script>
  import { getAnalyticsOptOutStatus, setAnalyticsOptOut } from '~/utils/analytics-opt-out';

  function connectPrivacyControl() {
    const button = document.querySelector<HTMLButtonElement>('#analytics-opt-out');
    const status = document.querySelector<HTMLElement>('#analytics-preference');
    if (!button || !status) return;
    function render() {
      if (!button || !status) return;
      const optedOut = getAnalyticsOptOutStatus();
      button.disabled = optedOut;
      button.textContent = optedOut ? 'Google Analytics is off' : 'Turn off Google Analytics';
      status.textContent = optedOut
        ? 'Google Analytics is disabled in this browser.'
        : 'Google Analytics is enabled unless blocked by your browser.';
    }
    button.onclick = () => {
      setAnalyticsOptOut(true);
      render();
    };
    render();
  }
  document.addEventListener('astro:page-load', connectPrivacyControl);
</script>
