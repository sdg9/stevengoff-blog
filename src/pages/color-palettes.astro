---
import Layout from '../layouts/PageLayout.astro';
import PalettePreview from '../components/ui/PalettePreview.astro';
import CompactContrastGrid from '../components/ui/CompactContrastGrid.astro';
import { colorPalettes } from '../utils/palettes';

const metadata = {
  title: 'Color Palette System with Accessibility Analysis',
  description: 'Browse color palettes with comprehensive accessibility ratings and contrast analysis.',
  robots: {
    index: true,
    follow: true,
  },
};

// Get the current active palette from CustomStyles.astro (this would need to be dynamic in a real implementation)
const currentPalette = 'default';
---

<Layout metadata={metadata}>
  <section class="px-6 py-12 md:py-16 lg:py-20">
    <div class="mx-auto max-w-6xl">
      <!-- Header -->
      <div class="mb-12 text-center">
        <h1 class="text-4xl font-bold text-gray-900 dark:text-white md:text-5xl">Color Palette System</h1>
        <p class="mt-4 text-xl text-gray-600 dark:text-gray-300">
          Easily switch between beautiful, professionally crafted color schemes
        </p>
      </div>

      <!-- How to Use Section -->
      <div class="mb-12 rounded-lg bg-gray-50 p-6 dark:bg-gray-800">
        <h2 class="mb-4 text-2xl font-semibold text-gray-900 dark:text-white">How to Switch Palettes</h2>
        <div class="space-y-4">
          <div class="rounded bg-white p-4 dark:bg-gray-700">
            <h3 class="mb-2 font-medium text-gray-900 dark:text-white">Step 1: Edit CustomStyles.astro</h3>
            <p class="text-gray-600 dark:text-gray-300">
              Open <code class="rounded bg-gray-100 px-2 py-1 dark:bg-gray-600">src/components/CustomStyles.astro</code>
            </p>
          </div>
          <div class="rounded bg-white p-4 dark:bg-gray-700">
            <h3 class="mb-2 font-medium text-gray-900 dark:text-white">Step 2: Change the ACTIVE_PALETTE</h3>
            <p class="mb-2 text-gray-600 dark:text-gray-300">Find this line and change the palette name:</p>
            <pre
              class="rounded bg-gray-100 p-3 text-sm dark:bg-gray-600"><code>const ACTIVE_PALETTE = 'default';</code></pre>
          </div>
          <div class="rounded bg-white p-4 dark:bg-gray-700">
            <h3 class="mb-2 font-medium text-gray-900 dark:text-white">Step 3: Save and See Changes</h3>
            <p class="text-gray-600 dark:text-gray-300">
              Your site will automatically update with the new color scheme!
            </p>
          </div>
        </div>
      </div>

      <!-- Available Palettes with Accessibility Ratings -->
      <PalettePreview currentPalette={currentPalette} showAccessibility={true} />

      <!-- Detailed Accessibility Analysis -->
      <div class="mt-16">
        <h2 class="mb-8 text-3xl font-bold text-gray-900 dark:text-white">Accessibility Analysis</h2>
        <p class="mb-8 text-lg text-gray-600 dark:text-gray-300">
          Each palette is analyzed for WCAG compliance. Contrast ratios are tested across all color combinations to
          ensure accessibility standards are met. Click on any color cell to see AAA recommendations.
        </p>

        <div class="space-y-6">
          {Object.values(colorPalettes).map((palette) => <CompactContrastGrid palette={palette} />)}
        </div>
      </div>

      <!-- Technical Details -->
      <div class="mt-12 rounded-lg bg-blue-50 p-6 dark:bg-blue-900/20">
        <h2 class="mb-4 text-2xl font-semibold text-gray-900 dark:text-white">Technical Details</h2>
        <div class="grid gap-6 md:grid-cols-2">
          <div>
            <h3 class="mb-2 font-medium text-gray-900 dark:text-white">Palette Structure</h3>
            <ul class="space-y-1 text-sm text-gray-600 dark:text-gray-300">
              <li>• <strong>Primary:</strong> Main brand color</li>
              <li>• <strong>Secondary:</strong> Supporting color</li>
              <li>• <strong>Accent:</strong> Highlights and CTAs</li>
              <li>• <strong>Background:</strong> Page background</li>
              <li>• <strong>Foreground:</strong> Text color</li>
              <li>• <strong>System colors:</strong> Success, error, warning</li>
            </ul>
          </div>
          <div>
            <h3 class="mb-2 font-medium text-gray-900 dark:text-white">Accessibility Features</h3>
            <ul class="space-y-1 text-sm text-gray-600 dark:text-gray-300">
              <li>• <strong>WCAG Compliance:</strong> AA and AAA ratings</li>
              <li>• <strong>Compact Grid:</strong> All combinations at a glance</li>
              <li>• <strong>Interactive Recommendations:</strong> Click cells for AAA suggestions</li>
              <li>• <strong>Color Wheel:</strong> Explore accessible alternatives</li>
              <li>• <strong>Background Testing:</strong> Main and muted backgrounds</li>
            </ul>
          </div>
        </div>
        <div class="mt-4">
          <h3 class="mb-2 font-medium text-gray-900 dark:text-white">CSS Variables</h3>
          <p class="text-sm text-gray-600 dark:text-gray-300">
            All colors are available as CSS custom properties (--color-primary, --color-secondary, etc.) and
            automatically support both light and dark modes with tested contrast ratios.
          </p>
        </div>
      </div>

      <!-- Adding Custom Palettes -->
      <div class="mt-12 rounded-lg bg-green-50 p-6 dark:bg-green-900/20">
        <h2 class="mb-4 text-2xl font-semibold text-gray-900 dark:text-white">Creating Custom Palettes</h2>
        <p class="mb-4 text-gray-600 dark:text-gray-300">
          You can add your own custom palettes by editing
          <code class="rounded bg-gray-100 px-2 py-1 dark:bg-gray-600">src/utils/palettes.ts</code>
        </p>
        <pre
          class="rounded bg-gray-100 p-4 text-sm dark:bg-gray-600"><code>{`myCustomPalette: {
  name: 'My Custom Palette',
  description: 'A unique color scheme',
  light: {
    primary: '#your-color',
    secondary: '#your-color',
    // ... other colors
  },
  dark: {
    // ... dark mode variants
  }
}`}</code></pre>
      </div>
    </div>
  </section>
</Layout>
