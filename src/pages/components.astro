---
import Announcement from '~/components/widgets/Announcement.astro';
import BlogHighlightedPosts from '~/components/widgets/BlogHighlightedPosts.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import Brands from '~/components/widgets/Brands.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Contact from '~/components/widgets/Contact.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Footer from '~/components/widgets/Footer.astro';
import Header from '~/components/widgets/Header.astro';
import Hero from '~/components/widgets/Hero.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Note from '~/components/widgets/Note.astro';
import Pricing from '~/components/widgets/Pricing.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps from '~/components/widgets/Steps.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import Layout from '~/layouts/PageLayout.astro';
import Background from '~/components/ui/Background.astro';
import Button from '~/components/ui/Button.astro';
import DListItem from '~/components/ui/DListItem.astro';
import Form from '~/components/ui/Form.astro';
import Headline from '~/components/ui/Headline.astro';
import ItemGrid from '~/components/ui/ItemGrid.astro';
import ItemGrid2 from '~/components/ui/ItemGrid2.astro';
import Timeline from '~/components/ui/Timeline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

const metadata = {
  title: 'Components',
};
---

<Layout metadata={metadata}>
  <section class="prose max-w-4xl mx-auto my-8">
    <h1>Component Library</h1>
    <p>
      This page demonstrates all available UI widgets in <code>src/components/widgets</code> and <code
        >src/components/ui</code
      >. Each section includes a live example and usage notes.
    </p>
  </section>

  <section>
    <h2>UI Components</h2>
    <p>These are foundational UI building blocks from <code>src/components/ui</code> used throughout the site.</p>
    <ul class="space-y-4">
      <li>
        <strong>Background</strong>: Decorative backgrounds for sections. <code>&lt;Background /&gt;</code>
        <div class="mt-2"><Background /></div>
      </li>
      <li>
        <strong>Button</strong>: Reusable button component. <code>&lt;Button /&gt;</code>
        <div class="mt-2"><Button label="Button" /></div>
      </li>
      <li>
        <strong>DListItem</strong>: Description list item for key-value pairs. <code>&lt;DListItem /&gt;</code>
        <dl class="mt-2"><DListItem label="Key" value="Value" /></dl>
      </li>
      <li>
        <strong>Form</strong>: Form container for consistent styling. <code>&lt;Form /&gt;</code>
        <div class="mt-2"><Form /></div>
      </li>
      <li>
        <strong>Headline</strong>: Section or card headline. <code>&lt;Headline /&gt;</code>
        <div class="mt-2"><Headline title="Headline Example" /></div>
      </li>
      <li>
        <strong>ItemGrid</strong>: Grid layout for items. <code>&lt;ItemGrid /&gt;</code>
        <div class="mt-2"><ItemGrid items={[{ title: 'Item 1' }, { title: 'Item 2' }]} /></div>
      </li>
      <li>
        <strong>ItemGrid2</strong>: Alternate grid layout. <code>&lt;ItemGrid2 /&gt;</code>
        <div class="mt-2"><ItemGrid2 items={[{ title: 'Item A' }, { title: 'Item B' }]} /></div>
      </li>
      <li>
        <strong>Timeline</strong>: Timeline/stepper for processes. <code>&lt;Timeline /&gt;</code>
        <div class="mt-2"><Timeline items={[{ title: 'Step 1' }, { title: 'Step 2' }]} /></div>
      </li>
      <li>
        <strong>WidgetWrapper</strong>: Wrapper for widget sections. <code>&lt;WidgetWrapper /&gt;</code>
        <div class="mt-2"><WidgetWrapper>Wrapped content</WidgetWrapper></div>
      </li>
    </ul>
  </section>

  <section>
    <h2>Announcement</h2>
    <p>Displays a site-wide announcement bar. Useful for news, updates, or promotions.</p>
    <Announcement />
  </section>

  <section>
    <h2>BlogHighlightedPosts</h2>
    <p>Showcases selected blog posts by ID. Props: <code>postIds</code> (array of post slugs).</p>
    <BlogHighlightedPosts postIds={['example-post-1', 'example-post-2']} />
  </section>

  <section>
    <h2>BlogLatestPosts</h2>
    <p>Displays the latest blog posts. Props: <code>count</code> (number of posts).</p>
    <BlogLatestPosts count={3} />
  </section>

  <section>
    <h2>Brands</h2>
    <p>Show partner or client logos. Props: <code>icons</code>, <code>images</code>.</p>
    <Brands />
  </section>

  <section>
    <h2>CallToAction</h2>
    <p>Prominent call-to-action section. Props: <code>title</code>, <code>subtitle</code>, <code>actions</code>.</p>
    <CallToAction title="Ready to start?" actions={[{ label: 'Sign Up', href: '/signup' }]} />
  </section>

  <section>
    <h2>Contact</h2>
    <p>Contact form widget. Props: <code>inputs</code>, <code>textarea</code>, <code>button</code>.</p>
    <Contact />
  </section>

  <section>
    <h2>Content</h2>
    <p>
      Flexible content block with image, text, and call-to-action. Props: <code>title</code>, <code>content</code>, <code
        >image</code
      >.
    </p>
    <Content title="Content Block" content="This is a content block." />
  </section>

  <section>
    <h2>FAQs</h2>
    <p>Frequently asked questions. Props: <code>items</code> (array of Q&A).</p>
    <FAQs />
  </section>

  <section>
    <h2>Features</h2>
    <p>Feature list with icons. Props: <code>items</code> (array), <code>columns</code>.</p>
    <Features />
  </section>

  <section>
    <h2>Features2</h2>
    <p>Alternate feature layout.</p>
    <Features2 />
  </section>

  <section>
    <h2>Features3</h2>
    <p>Another feature layout variant.</p>
    <Features3 />
  </section>

  <section>
    <h2>Footer</h2>
    <p>Site footer with links and info.</p>
    <Footer />
  </section>

  <section>
    <h2>Header</h2>
    <p>Site header/navigation bar.</p>
    <Header />
  </section>

  <section>
    <h2>Hero</h2>
    <p>
      Primary hero section. Props: <code>title</code>, <code>subtitle</code>, <code>image</code>, <code>actions</code>.
    </p>
    <Hero title="Welcome!" subtitle="This is the hero section." />
  </section>

  <section>
    <h2>Hero2</h2>
    <p>Alternate hero layout.</p>
    <Hero2 title="Welcome!" subtitle="Alternate hero." />
  </section>

  <section>
    <h2>HeroText</h2>
    <p>Text-focused hero section.</p>
    <HeroText title="Text Hero" subtitle="For text-heavy intros." />
  </section>

  <section>
    <h2>Note</h2>
    <p>Info or alert note. Props: <code>icon</code>, <code>title</code>, <code>description</code>.</p>
    <Note title="Note Title" description="This is a note." />
  </section>

  <section>
    <h2>Pricing</h2>
    <p>Pricing table. Props: <code>prices</code> (array).</p>
    <Pricing />
  </section>

  <section>
    <h2>Stats</h2>
    <p>Key statistics. Props: <code>stats</code> (array).</p>
    <Stats />
  </section>

  <section>
    <h2>Steps</h2>
    <p>Step-by-step process. Props: <code>items</code> (array).</p>
    <Steps />
  </section>

  <section>
    <h2>Steps2</h2>
    <p>Alternate steps layout.</p>
    <Steps2 />
  </section>

  <section>
    <h2>Testimonials</h2>
    <p>Customer testimonials. Props: <code>testimonials</code> (array).</p>
    <Testimonials />
  </section>
</Layout>
