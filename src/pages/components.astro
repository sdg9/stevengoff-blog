<IconListItemWithSubBullets
  icon="tabler:seedling"
  title="Main Feature"
  description="Description of the main feature:"
  iconColor="primary"
  subBulletStyle="bullet"
  subBullets={[
    { text: 'First sub-point' },
    { text: 'Second sub-point' }
  ]}
/>

<!-- Icon Style Sub-bullets -->
<IconListItemWithSubBullets
  subBulletStyle="icon"
  subBullets={[
    { text: 'Custom icon', icon: 'tabler:check' }
  ]}
/>`}</code></pre>
              </div>
