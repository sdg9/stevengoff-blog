---

<Layout metadata={metadata}>
  <main class="py-12 md:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <!-- Page Header -->
      <div class="text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">Component Library</h1>
        <p class="text-xl text-muted dark:text-slate-400 max-w-3xl mx-auto mb-6">
          Complete reference and live demonstrations of all available UI components and widgets. Use these building
          blocks to create beautiful, consistent interfaces throughout your site.
        </p>

        <!-- Color Customizer Notice -->
        <div
          class="inline-flex items-center space-x-2 bg-gradient-to-r from-purple-100 to-blue-100 dark:from-purple-900 dark:to-blue-900 px-4 py-2 rounded-full text-sm text-purple-700 dark:text-purple-300 border border-purple-200 dark:border-purple-700"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zM21 5a2 2 0 00-2-2h-4a2 2 0 00-2 2v12a4 4 0 004 4h4a2 2 0 002-2V5z"
            ></path>
          </svg>
          <span>Click the design tool button (top-right) to customize colors in real-time!</span>
        </div>
      </div>

      <!-- Color Variables Test Section -->
      <section class="mb-16">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 text-center">Live Color Variables Test</h2>
        <div class="grid grid-cols-1 md:grid-cols-5 gap-4 max-w-4xl mx-auto">
          <div class="text-center p-4 rounded-lg border border-gray-200 dark:border-gray-700">
            <div class="w-full h-16 rounded mb-3" style="background-color: var(--color-primary);"></div>
            <p class="text-sm font-medium text-gray-700 dark:text-gray-300">Primary</p>
            <code class="text-xs text-gray-500 block mt-1">--color-primary</code>
          </div>
          <div class="text-center p-4 rounded-lg border border-gray-200 dark:border-gray-700">
            <div class="w-full h-16 rounded mb-3" style="background-color: var(--color-secondary);"></div>
            <p class="text-sm font-medium text-gray-700 dark:text-gray-300">Secondary</p>
            <code class="text-xs text-gray-500 block mt-1">--color-secondary</code>
          </div>
          <div class="text-center p-4 rounded-lg border border-gray-200 dark:border-gray-700">
            <div class="w-full h-16 rounded mb-3" style="background-color: var(--color-accent);"></div>
            <p class="text-sm font-medium text-gray-700 dark:text-gray-300">Accent</p>
            <code class="text-xs text-gray-500 block mt-1">--color-accent</code>
          </div>
          <div class="text-center p-4 rounded-lg border border-gray-200 dark:border-gray-700">
            <div
              class="w-full h-16 rounded mb-3 border border-gray-300"
              style="background-color: var(--color-background);"
            >
            </div>
            <p class="text-sm font-medium text-gray-700 dark:text-gray-300">Background</p>
            <code class="text-xs text-gray-500 block mt-1">--color-background</code>
          </div>
          <div class="text-center p-4 rounded-lg border border-gray-200 dark:border-gray-700">
            <div class="w-full h-16 rounded mb-3" style="background-color: var(--color-foreground);"></div>
            <p class="text-sm font-medium text-gray-700 dark:text-gray-300">Foreground</p>
            <code class="text-xs text-gray-500 block mt-1">--color-foreground</code>
          </div>
        </div>
        <p class="text-center text-sm text-gray-600 dark:text-gray-400 mt-4">
          These colors should change in real-time when you use the color customizer above. Try swapping or changing
          colors to see the effect!
        </p>
      </section>

      <!-- Comprehensive Table of Contents -->
      <nav class="mb-16 bg-gray-50 dark:bg-slate-800 rounded-lg p-8">
        <h2 class="text-2xl font-semibold text-gray-900 dark:text-white mb-6 text-center">Component Index</h2>
        <p class="text-gray-600 dark:text-gray-400 text-center mb-8 max-w-2xl mx-auto">
          Navigate to any component section below. Components are grouped by type for easy discovery.
        </p>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 text-sm">
          <!-- UI Foundation Components -->
          <div class="bg-white dark:bg-slate-700 rounded-lg p-4">
            <h3 class="font-semibold text-gray-800 dark:text-gray-200 mb-3 flex items-center">
              <span class="w-2 h-2 bg-primary rounded-full mr-2"></span>
              UI Foundation
            </h3>
            <ul class="space-y-2 text-gray-600 dark:text-gray-400">
              <li><a href="#button" class="hover:text-primary transition-colors">Button</a></li>
              <li><a href="#background" class="hover:text-primary transition-colors">Background</a></li>
              <li><a href="#headline" class="hover:text-primary transition-colors">Headline</a></li>
              <li><a href="#timeline" class="hover:text-primary transition-colors">Timeline</a></li>
              <li><a href="#forms" class="hover:text-primary transition-colors">Forms & DList</a></li>
            </ul>
          </div>

          <!-- Icon & List Components -->
          <div class="bg-white dark:bg-slate-700 rounded-lg p-4">
            <h3 class="font-semibold text-gray-800 dark:text-gray-200 mb-3 flex items-center">
              <span class="w-2 h-2 bg-accent rounded-full mr-2"></span>
              Icon Lists
            </h3>
            <ul class="space-y-2 text-gray-600 dark:text-gray-400">
              <li><a href="#icon-list-item" class="hover:text-primary transition-colors">IconListItem</a></li>
              <li><a href="#icon-list" class="hover:text-primary transition-colors">IconList</a></li>
              <li><a href="#icon-list-slots" class="hover:text-primary transition-colors">IconListItemSlot</a></li>
              <li><a href="#icon-list-sub-bullets" class="hover:text-primary transition-colors">Sub-bullets</a></li>
              <li><a href="#item-grid" class="hover:text-primary transition-colors">ItemGrid</a></li>
            </ul>
          </div>

          <!-- Hero Components -->
          <div class="bg-white dark:bg-slate-700 rounded-lg p-4">
            <h3 class="font-semibold text-gray-800 dark:text-gray-200 mb-3 flex items-center">
              <span class="w-2 h-2 bg-secondary rounded-full mr-2"></span>
              Hero Sections
            </h3>
            <ul class="space-y-2 text-gray-600 dark:text-gray-400">
              <li><a href="#hero" class="hover:text-primary transition-colors">Hero</a></li>
              <li><a href="#hero2" class="hover:text-primary transition-colors">Hero2</a></li>
              <li><a href="#hero-text" class="hover:text-primary transition-colors">HeroText</a></li>
            </ul>
          </div>

          <!-- Feature Components -->
          <div class="bg-white dark:bg-slate-700 rounded-lg p-4">
            <h3 class="font-semibold text-gray-800 dark:text-gray-200 mb-3 flex items-center">
              <span class="w-2 h-2 bg-green-500 rounded-full mr-2"></span>
              Features
            </h3>
            <ul class="space-y-2 text-gray-600 dark:text-gray-400">
              <li><a href="#features" class="hover:text-primary transition-colors">Features</a></li>
              <li><a href="#features2" class="hover:text-primary transition-colors">Features2</a></li>
              <li><a href="#features3" class="hover:text-primary transition-colors">Features3</a></li>
            </ul>
          </div>

          <!-- Step Components -->
          <div class="bg-white dark:bg-slate-700 rounded-lg p-4">
            <h3 class="font-semibold text-gray-800 dark:text-gray-200 mb-3 flex items-center">
              <span class="w-2 h-2 bg-blue-500 rounded-full mr-2"></span>
              Process Steps
            </h3>
            <ul class="space-y-2 text-gray-600 dark:text-gray-400">
              <li><a href="#steps" class="hover:text-primary transition-colors">Steps</a></li>
              <li><a href="#steps2" class="hover:text-primary transition-colors">Steps2</a></li>
            </ul>
          </div>

          <!-- Content & Information -->
          <div class="bg-white dark:bg-slate-700 rounded-lg p-4">
            <h3 class="font-semibold text-gray-800 dark:text-gray-200 mb-3 flex items-center">
              <span class="w-2 h-2 bg-purple-500 rounded-full mr-2"></span>
              Content Blocks
            </h3>
            <ul class="space-y-2 text-gray-600 dark:text-gray-400">
              <li><a href="#content" class="hover:text-primary transition-colors">Content</a></li>
              <li><a href="#testimonials" class="hover:text-primary transition-colors">Testimonials</a></li>
              <li><a href="#stats" class="hover:text-primary transition-colors">Stats</a></li>
              <li><a href="#faqs" class="hover:text-primary transition-colors">FAQs</a></li>
              <li><a href="#note" class="hover:text-primary transition-colors">Note</a></li>
            </ul>
          </div>

          <!-- Interactive Components -->
          <div class="bg-white dark:bg-slate-700 rounded-lg p-4">
            <h3 class="font-semibold text-gray-800 dark:text-gray-200 mb-3 flex items-center">
              <span class="w-2 h-2 bg-orange-500 rounded-full mr-2"></span>
              Interactive
            </h3>
            <ul class="space-y-2 text-gray-600 dark:text-gray-400">
              <li><a href="#contact" class="hover:text-primary transition-colors">Contact</a></li>
              <li><a href="#pricing" class="hover:text-primary transition-colors">Pricing</a></li>
              <li><a href="#cta" class="hover:text-primary transition-colors">Call to Action</a></li>
            </ul>
          </div>

          <!-- Blog & Content Management -->
          <div class="bg-white dark:bg-slate-700 rounded-lg p-4">
            <h3 class="font-semibold text-gray-800 dark:text-gray-200 mb-3 flex items-center">
              <span class="w-2 h-2 bg-pink-500 rounded-full mr-2"></span>
              Blog Components
            </h3>
            <ul class="space-y-2 text-gray-600 dark:text-gray-400">
              <li><a href="#blog-latest" class="hover:text-primary transition-colors">BlogLatestPosts</a></li>
              <li><a href="#blog-highlighted" class="hover:text-primary transition-colors">BlogHighlighted</a></li>
              <li><a href="#brands" class="hover:text-primary transition-colors">Brands</a></li>
              <li><a href="#announcement" class="hover:text-primary transition-colors">Announcement</a></li>
            </ul>
          </div>
        </div>

        <!-- Quick Jump Navigation -->
        <div class="mt-8 pt-6 border-t border-gray-200 dark:border-gray-600">
          <div class="text-center">
            <p class="text-sm text-gray-600 dark:text-gray-400 mb-3">Quick Jump to Sections:</p>
            <div class="flex flex-wrap justify-center gap-2">
              <a
                href="#ui-components"
                class="inline-block px-3 py-1 bg-primary/10 text-primary rounded-full text-xs hover:bg-primary/20 transition-colors"
                >UI Components</a
              >
              <a
                href="#icon-list-components"
                class="inline-block px-3 py-1 bg-accent/10 text-accent rounded-full text-xs hover:bg-accent/20 transition-colors"
                >Icon Lists</a
              >
              <a
                href="#widgets"
                class="inline-block px-3 py-1 bg-secondary/10 text-secondary rounded-full text-xs hover:bg-secondary/20 transition-colors"
                >Widget Components</a
              >
            </div>
          </div>
        </div>
      </nav>

      <!-- UI Components Section -->
      <section id="ui-components" class="mb-20">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-8">UI Components</h2>
        <p class="text-lg text-gray-600 dark:text-gray-400 mb-12">
          Foundational building blocks from <code class="bg-gray-100 dark:bg-gray-800 px-2 py-1 rounded"
            >src/components/ui</code
          >
          used throughout the site for consistent styling and behavior.
        </p>

        <!-- Button Component -->
        <div id="button" class="mb-12">
          <h3 class="text-2xl font-semibold text-gray-900 dark:text-white mb-4">Button</h3>
          <p class="text-gray-600 dark:text-gray-400 mb-6">
            Versatile button component with multiple variants, sizes, and states. Supports icons, different styles, and
            accessibility features.
          </p>

          <div class="grid lg:grid-cols-2 gap-8">
            <div>
              <h4 class="text-lg font-medium mb-4">Examples</h4>
              <div class="bg-white dark:bg-slate-800 p-6 rounded-lg border border-gray-200 dark:border-gray-700">
                <div class="space-y-4">
                  <div class="flex flex-wrap gap-3">
                    <Button text="Primary" variant="primary" />
                    <Button text="Secondary" variant="secondary" />
                    <Button text="Tertiary" variant="tertiary" />
                  </div>
                  <div class="flex flex-wrap gap-3">
                    <Button text="With Icon" variant="primary" icon="tabler:rocket" />
                    <Button text="Link Style" variant="link" />
                  </div>
                </div>
              </div>
            </div>

            <div>
              <h4 class="text-lg font-medium mb-4">Code Example</h4>
              <div class="bg-gray-900 text-green-400 p-4 rounded-lg overflow-x-auto text-sm">
                <pre><code>{`<!-- Basic Usage -->
<Button text="Click Me" variant="primary" />

<!-- With Icon -->
<Button 
  text="Get Started" 
  variant="primary" 
  icon="tabler:rocket" 
/>

<!-- Link Button -->
<Button 
  text="Learn More" 
  variant="link" 
  href="/about" 
/>`}</code></pre>
              </div>
            </div>
          </div>

          <div class="mt-6 bg-gray-50 dark:bg-slate-800 rounded-lg p-4">
            <h4 class="font-semibold text-gray-900 dark:text-white mb-2">Available Props</h4>
            <ul class="text-sm text-gray-600 dark:text-gray-400 space-y-1">
              <li><code>text</code> - Button label text</li>
              <li><code>variant</code> - Style variant: primary, secondary, tertiary, link</li>
              <li><code>icon</code> - Optional Tabler icon name</li>
              <li><code>href</code> - Makes button a link</li>
              <li><code>class</code> - Additional CSS classes</li>
            </ul>
          </div>
        </div>

        <!-- Background Component -->
        <div id="background" class="mb-12">
          <h3 class="text-2xl font-semibold text-gray-900 dark:text-white mb-4">Background</h3>
          <p class="text-gray-600 dark:text-gray-400 mb-6">
            Decorative background patterns and gradients for section styling. Adds visual interest without being
            distracting.
          </p>

          <div
            class="bg-white dark:bg-slate-800 p-6 rounded-lg border border-gray-200 dark:border-gray-700 relative overflow-hidden"
          >
            <Background />
            <div class="relative z-10 text-center py-8">
              <h4 class="text-lg font-medium text-gray-900 dark:text-white mb-2">Section with Background</h4>
              <p class="text-gray-600 dark:text-gray-400">
                This content appears over the decorative background pattern.
              </p>
            </div>
          </div>

          <div class="mt-4 bg-gray-900 text-green-400 p-4 rounded-lg overflow-x-auto text-sm">
            <pre><code>{`<!-- Basic Usage -->
<section class="relative">
  <Background />
  <div class="relative z-10">
    <!-- Your content here -->
  </div>
</section>`}</code></pre>
          </div>
        </div>

        <!-- Headline Component -->
        <div id="headline" class="mb-12">
          <h3 class="text-2xl font-semibold text-gray-900 dark:text-white mb-4">Headline</h3>
          <p class="text-gray-600 dark:text-gray-400 mb-6">
            Consistent headline formatting for sections and cards. Supports subtitles, custom styling, and responsive
            text sizing.
          </p>

          <div class="grid lg:grid-cols-2 gap-8">
            <div>
              <h4 class="text-lg font-medium mb-4">Examples</h4>
              <div class="space-y-6">
                <div class="bg-white dark:bg-slate-800 p-6 rounded-lg border border-gray-200 dark:border-gray-700">
                  <Headline
                    title="Main Section Title"
                    subtitle="Supporting subtitle text that provides additional context"
                  />
                </div>
                <div class="bg-white dark:bg-slate-800 p-6 rounded-lg border border-gray-200 dark:border-gray-700">
                  <Headline
                    title="Centered Headline"
                    subtitle="Perfect for hero sections"
                    classes={{ container: 'text-center' }}
                  />
                </div>
              </div>
            </div>

            <div>
              <h4 class="text-lg font-medium mb-4">Code Example</h4>
              <div class="bg-gray-900 text-green-400 p-4 rounded-lg overflow-x-auto text-sm">
                <pre><code>{`<!-- Basic Headline -->
<Headline 
  title="Section Title" 
  subtitle="Optional subtitle" 
/>

<!-- Centered Headline -->
<Headline 
  title="Hero Title" 
  subtitle="Hero subtitle"
  classes={{ container: 'text-center' }}
/>`}</code></pre>
              </div>
            </div>
          </div>
        </div>

