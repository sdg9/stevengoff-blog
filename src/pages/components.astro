---
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Contact from '~/components/widgets/Contact.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Note from '~/components/widgets/Note.astro';
import Pricing from '~/components/widgets/Pricing.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps from '~/components/widgets/Steps.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import Layout from '~/layouts/PageLayout.astro';
import Background from '~/components/ui/Background.astro';
import Button from '~/components/ui/Button.astro';
import DListItem from '~/components/ui/DListItem.astro';
import Form from '~/components/ui/Form.astro';
import Headline from '~/components/ui/Headline.astro';
import Timeline from '~/components/ui/Timeline.astro';
import IconList from '~/components/ui/IconList.astro';
import IconListItem from '~/components/ui/IconListItem.astro';
import IconListItemSlot from '~/components/ui/IconListItemSlot.astro';
import IconListItemWithSubBullets from '~/components/ui/IconListItemWithSubBullets.astro';
import IconListWithSubBullets from '~/components/ui/IconListWithSubBullets.astro';

const metadata = {
  title: 'Component Library - UI Components & Widgets',
  description: 'Complete reference and demonstration of all available UI components and widgets in the Astro theme.',
  robots: {
    index: true,
    follow: true,
  },
};

// Sample data for demonstrations
const sampleIconItems = [
  {
    icon: 'tabler:heart',
    title: 'User Experience',
    description: 'Create delightful and intuitive user experiences with thoughtful design.',
  },
  {
    icon: 'tabler:star',
    title: 'Performance',
    description: 'Optimized components built for speed and efficiency.',
  },
  {
    icon: 'tabler:palette',
    title: 'Customizable',
    description: 'Flexible styling options to match your brand and design needs.',
  },
];

const sampleSubBulletItems = [
  {
    icon: 'tabler:seedling',
    title: 'Growing Your Business',
    description: 'Comprehensive tools and strategies for business development:',
    subBullets: [
      { text: 'Market research and competitive analysis' },
      { text: 'Customer acquisition and retention strategies' },
      { text: 'Revenue optimization and growth metrics' },
    ],
  },
];

const sampleTimelineItems = [
  {
    title: 'Discovery Phase',
    description: 'Research and planning stage',
    icon: 'tabler:search',
  },
  {
    title: 'Design & Development',
    description: 'Creating the solution',
    icon: 'tabler:code',
  },
  {
    title: 'Launch & Optimize',
    description: 'Deploy and refine',
    icon: 'tabler:rocket',
  },
];
---

<Layout metadata={metadata}>
  <main class="py-12 md:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <!-- Page Header -->
      <div class="text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">Component Library</h1>
        <p class="text-xl text-muted dark:text-slate-400 max-w-3xl mx-auto">
          Complete reference and live demonstrations of all available UI components and widgets. Use these building
          blocks to create beautiful, consistent interfaces throughout your site.
        </p>
      </div>

      <!-- Table of Contents -->
      <nav class="mb-16 bg-gray-50 dark:bg-slate-800 rounded-lg p-6">
        <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Quick Navigation</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4 text-sm">
          <div>
            <h3 class="font-semibold text-gray-800 dark:text-gray-200 mb-2">UI Components</h3>
            <ul class="space-y-1 text-gray-600 dark:text-gray-400">
              <li><a href="#button" class="hover:text-primary">Button</a></li>
              <li><a href="#background" class="hover:text-primary">Background</a></li>
              <li><a href="#headline" class="hover:text-primary">Headline</a></li>
              <li><a href="#timeline" class="hover:text-primary">Timeline</a></li>
              <li><a href="#forms" class="hover:text-primary">Forms</a></li>
            </ul>
          </div>
          <div>
            <h3 class="font-semibold text-gray-800 dark:text-gray-200 mb-2">Icon Lists</h3>
            <ul class="space-y-1 text-gray-600 dark:text-gray-400">
              <li><a href="#icon-list-item" class="hover:text-primary">IconListItem</a></li>
              <li><a href="#icon-list" class="hover:text-primary">IconList</a></li>
              <li><a href="#icon-list-slots" class="hover:text-primary">IconListItemSlot</a></li>
              <li><a href="#icon-list-sub-bullets" class="hover:text-primary">Sub-bullets</a></li>
            </ul>
          </div>
          <div>
            <h3 class="font-semibold text-gray-800 dark:text-gray-200 mb-2">Widgets</h3>
            <ul class="space-y-1 text-gray-600 dark:text-gray-400">
              <li><a href="#hero" class="hover:text-primary">Hero Sections</a></li>
              <li><a href="#features" class="hover:text-primary">Features</a></li>
              <li><a href="#testimonials" class="hover:text-primary">Testimonials</a></li>
              <li><a href="#contact" class="hover:text-primary">Contact Forms</a></li>
            </ul>
          </div>
        </div>
      </nav>

      <!-- UI Components Section -->
      <section id="ui-components" class="mb-20">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-8">UI Components</h2>
        <p class="text-lg text-gray-600 dark:text-gray-400 mb-12">
          Foundational building blocks from <code class="bg-gray-100 dark:bg-gray-800 px-2 py-1 rounded">src/components/ui</code> 
          used throughout the site for consistent styling and behavior.
        </p>

        <!-- Button Component -->
        <div id="button" class="mb-12">
          <h3 class="text-2xl font-semibold text-gray-900 dark:text-white mb-4">Button</h3>
          <p class="text-gray-600 dark:text-gray-400 mb-6">
            Versatile button component with multiple variants, sizes, and states. Supports icons, different styles, and accessibility features.
          </p>
          
          <div class="grid lg:grid-cols-2 gap-8">
            <div>
              <h4 class="text-lg font-medium mb-4">Examples</h4>
              <div class="bg-white dark:bg-slate-800 p-6 rounded-lg border border-gray-200 dark:border-gray-700">
                <div class="space-y-4">
                  <div class="flex flex-wrap gap-3">
                    <Button text="Primary" variant="primary" />
                    <Button text="Secondary" variant="secondary" />
                    <Button text="Tertiary" variant="tertiary" />
                  </div>
                  <div class="flex flex-wrap gap-3">
                    <Button text="With Icon" variant="primary" icon="tabler:rocket" />
                    <Button text="Link Style" variant="link" />
                  </div>
                </div>
              </div>
            </div>
            
            <div>
              <h4 class="text-lg font-medium mb-4">Code Example</h4>
              <div class="bg-gray-900 text-green-400 p-4 rounded-lg overflow-x-auto text-sm">
                <pre><code>{`<!-- Basic Usage -->
<Button text="Click Me" variant="primary" />

<!-- With Icon -->
<Button 
  text="Get Started" 
  variant="primary" 
  icon="tabler:rocket" 
/>

<!-- Link Button -->
<Button 
  text="Learn More" 
  variant="link" 
  href="/about" 
/>`}</code></pre>
              </div>
            </div>
          </div>
          
          <div class="mt-6 bg-gray-50 dark:bg-slate-800 rounded-lg p-4">
            <h4 class="font-semibold text-gray-900 dark:text-white mb-2">Available Props</h4>
            <ul class="text-sm text-gray-600 dark:text-gray-400 space-y-1">
              <li><code>text</code> - Button label text</li>
              <li><code>variant</code> - Style variant: primary, secondary, tertiary, link</li>
              <li><code>icon</code> - Optional Tabler icon name</li>
              <li><code>href</code> - Makes button a link</li>
              <li><code>class</code> - Additional CSS classes</li>
            </ul>
          </div>
        </div>

        <!-- Background Component -->
        <div id="background" class="mb-12">
          <h3 class="text-2xl font-semibold text-gray-900 dark:text-white mb-4">Background</h3>
          <p class="text-gray-600 dark:text-gray-400 mb-6">
            Decorative background patterns and gradients for section styling. Adds visual interest without being distracting.
          </p>
          
          <div class="bg-white dark:bg-slate-800 p-6 rounded-lg border border-gray-200 dark:border-gray-700 relative overflow-hidden">
            <Background />
            <div class="relative z-10 text-center py-8">
              <h4 class="text-lg font-medium text-gray-900 dark:text-white mb-2">Section with Background</h4>
              <p class="text-gray-600 dark:text-gray-400">This content appears over the decorative background pattern.</p>
            </div>
          </div>
          
          <div class="mt-4 bg-gray-900 text-green-400 p-4 rounded-lg overflow-x-auto text-sm">
            <pre><code>{`<!-- Basic Usage -->
<section class="relative">
  <Background />
  <div class="relative z-10">
    <!-- Your content here -->
  </div>
</section>`}</code></pre>
          </div>
        </div>

        <!-- Headline Component -->
        <div id="headline" class="mb-12">
          <h3 class="text-2xl font-semibold text-gray-900 dark:text-white mb-4">Headline</h3>
          <p class="text-gray-600 dark:text-gray-400 mb-6">
            Consistent headline formatting for sections and cards. Supports subtitles, custom styling, and responsive text sizing.
          </p>
          
          <div class="grid lg:grid-cols-2 gap-8">
            <div>
              <h4 class="text-lg font-medium mb-4">Examples</h4>
              <div class="space-y-6">
                <div class="bg-white dark:bg-slate-800 p-6 rounded-lg border border-gray-200 dark:border-gray-700">
                  <Headline title="Main Section Title" subtitle="Supporting subtitle text that provides additional context" />
                </div>
                <div class="bg-white dark:bg-slate-800 p-6 rounded-lg border border-gray-200 dark:border-gray-700">
                  <Headline title="Centered Headline" subtitle="Perfect for hero sections" classes={{ container: 'text-center' }} />
                </div>
              </div>
            </div>
            
            <div>
              <h4 class="text-lg font-medium mb-4">Code Example</h4>
              <div class="bg-gray-900 text-green-400 p-4 rounded-lg overflow-x-auto text-sm">
                <pre><code>{`<!-- Basic Headline -->
<Headline 
  title="Section Title" 
  subtitle="Optional subtitle" 
/>

<!-- Centered Headline -->
<Headline 
  title="Hero Title" 
  subtitle="Hero subtitle"
  classes={{ container: 'text-center' }}
/>`}</code></pre>
              </div>
            </div>
          </div>
        </div>

        <!-- Timeline Component -->
        <div id="timeline" class="mb-12">
          <h3 class="text-2xl font-semibold text-gray-900 dark:text-white mb-4">Timeline</h3>
          <p class="text-gray-600 dark:text-gray-400 mb-6">
            Visual timeline component perfect for showing processes, steps, or chronological events with icons and descriptions.
          </p>
          
          <div class="bg-white dark:bg-slate-800 p-6 rounded-lg border border-gray-200 dark:border-gray-700">
            <Timeline items={sampleTimelineItems} />
          </div>
          
          <div class="mt-4 bg-gray-900 text-green-400 p-4 rounded-lg overflow-x-auto text-sm">
            <pre><code>{`const timelineItems = [
  {
    title: 'Discovery Phase',
    description: 'Research and planning stage',
    icon: 'tabler:search',
  },
  {
    title: 'Design & Development', 
    description: 'Creating the solution',
    icon: 'tabler:code',
  }
];

<Timeline items={timelineItems} />`}</code></pre>
          </div>
        </div>

        <!-- Forms Section -->
        <div id="forms" class="mb-12">
          <h3 class="text-2xl font-semibold text-gray-900 dark:text-white mb-4">Forms & Inputs</h3>
          <p class="text-gray-600 dark:text-gray-400 mb-6">
            Form components and description list items for structured data display and user input.
          </p>
          
          <div class="grid lg:grid-cols-2 gap-8">
            <div>
              <h4 class="text-lg font-medium mb-4">Form Container</h4>
              <div class="bg-white dark:bg-slate-800 p-6 rounded-lg border border-gray-200 dark:border-gray-700">
                <Form />
              </div>
            </div>
            
            <div>
              <h4 class="text-lg font-medium mb-4">Description List Items</h4>
              <div class="bg-white dark:bg-slate-800 p-6 rounded-lg border border-gray-200 dark:border-gray-700">
                <dl class="space-y-3">
                  <DListItem dt="Name">John Doe</DListItem>
                  <DListItem dt="Email">john@example.com</DListItem>
                  <DListItem dt="Status">Active</DListItem>
                </dl>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Icon List Components Section -->
      <section id="icon-list-components" class="mb-20">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-8">Icon List Components</h2>
        <p class="text-lg text-gray-600 dark:text-gray-400 mb-12">
          Specialized components for displaying lists with icons, titles, and descriptions. Perfect for features, 
          services, process steps, and any content that benefits from visual icons and structured layout.
        </p>

        <!-- IconListItem -->
        <div id="icon-list-item" class="mb-16">
          <h3 class="text-2xl font-semibold text-gray-900 dark:text-white mb-4">IconListItem</h3>
          <p class="text-gray-600 dark:text-gray-400 mb-6">
            Single list item component with icon, title, and description. Highly customizable with different sizes, 
            colors, and styling options.
          </p>

          <div class="space-y-8">
            <!-- Size Examples -->
            <div>
              <h4 class="text-lg font-medium mb-4">Different Sizes</h4>
              <div class="grid gap-6">
                <div class="bg-white dark:bg-slate-800 p-6 rounded-lg border border-gray-200 dark:border-gray-700">
                  <h5 class="text-sm font-semibold mb-3 text-gray-700 dark:text-gray-300">Small</h5>
                  <IconListItem
                    icon="tabler:heart"
                    title="Small Size Example"
                    description="Compact version perfect for sidebars or dense layouts."
                    size="sm"
                    iconColor="primary"
                  />
                </div>
                
                <div class="bg-white dark:bg-slate-800 p-6 rounded-lg border border-gray-200 dark:border-gray-700">
                  <h5 class="text-sm font-semibold mb-3 text-gray-700 dark:text-gray-300">Medium (Default)</h5>
                  <IconListItem
                    icon="tabler:star"
                    title="Medium Size Example"
                    description="Standard size that works well in most contexts and provides good balance."
                    size="md"
                    iconColor="accent"
                  />
                </div>
                
                <div class="bg-white dark:bg-slate-800 p-6 rounded-lg border border-gray-200 dark:border-gray-700">
                  <h5 class="text-sm font-semibold mb-3 text-gray-700 dark:text-gray-300">Large</h5>
                  <IconListItem
                    icon="tabler:rocket"
                    title="Large Size Example"
                    description="Prominent version ideal for hero sections, landing pages, or when you want to draw attention to key features."
                    size="lg"
                    iconColor="success"
                  />
                </div>
              </div>
            </div>

            <!-- Color Examples -->
            <div>
              <h4 class="text-lg font-medium mb-4">Icon Colors</h4>
              <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
                <div class="bg-white dark:bg-slate-800 p-4 rounded-lg border border-gray-200 dark:border-gray-700">
                  <IconListItem
                    icon="tabler:palette"
                    title="Primary Color"
                    description="Main brand color"
                    iconColor="primary"
                    size="sm"
                  />
                </div>
                <div class="bg-white dark:bg-slate-800 p-4 rounded-lg border border-gray-200 dark:border-gray-700">
                  <IconListItem
                    icon="tabler:check"
                    title="Success Color"
                    description="Green for positive actions"
                    iconColor="success"
                    size="sm"
                  />
                </div>
                <div class="bg-white dark:bg-slate-800 p-4 rounded-lg border border-gray-200 dark:border-gray-700">
                  <IconListItem
                    icon="tabler:star"
                    title="Accent Color"
                    description="Highlight and emphasis"
                    iconColor="accent"
                    size="sm"
                  />
                </div>
              </div>
            </div>

            <!-- Code Example -->
            <div>
              <h4 class="text-lg font-medium mb-4">Usage Examples</h4>
              <div class="bg-gray-900 text-green-400 p-4 rounded-lg overflow-x-auto text-sm">
                <pre><code>{`<!-- Basic Usage -->
<IconListItem
  icon="tabler:heart"
  title="Feature Title"
  description="Description of the feature"
/>

<!-- With Custom Styling -->
<IconListItem
  icon="tabler:rocket"
  title="Advanced Feature"
  description="Detailed description with custom styling"
  iconColor="success"
  size="lg"
  iconBg={false}
/>`}</code></pre>
              </div>
            </div>

            <!-- Props Reference -->
            <div class="bg-gray-50 dark:bg-slate-800 rounded-lg p-6">
              <h4 class="font-semibold text-gray-900 dark:text-white mb-4">Available Props</h4>
              <div class="grid md:grid-cols-2 gap-6 text-sm">
                <div>
                  <h5 class="font-medium text-gray-800 dark:text-gray-200 mb-2">Required</h5>
                  <ul class="space-y-1 text-gray-600 dark:text-gray-400">
                    <li><code>icon</code> - Tabler icon name (e.g., "tabler:heart")</li>
                    <li><code>title</code> - Main heading text</li>
                    <li><code>description</code> - Supporting description text</li>
                  </ul>
                </div>
                <div>
                  <h5 class="font-medium text-gray-800 dark:text-gray-200 mb-2">Optional</h5>
                  <ul class="space-y-1 text-gray-600 dark:text-gray-400">
                    <li><code>iconColor</code> - primary, secondary, accent, success, warning</li>
                    <li><code>size</code> - sm, md, lg</li>
                    <li><code>iconBg</code> - true/false (show icon background)</li>
                    <li><code>class</code> - Additional CSS classes</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- IconList -->
        <div id="icon-list" class="mb-16">
          <h3 class="text-2xl font-semibold text-gray-900 dark:text-white mb-4">IconList</h3>
          <p class="text-gray-600 dark:text-gray-400 mb-6">
            Container component that renders multiple IconListItem components in a responsive grid layout. 
            Perfect for feature lists, service offerings, and benefit summaries.
          </p>

          <div class="space-y-8">
            <!-- Single Column -->
            <div>
              <h4 class="text-lg font-medium mb-4">Single Column Layout</h4>
              <div class="bg-white dark:bg-slate-800 p-6 rounded-lg border border-gray-200 dark:border-gray-700">
                <IconList items={sampleIconItems} columns={1} iconColor="primary" spacing="normal" />
              </div>
            </div>

            <!-- Two Columns -->
            <div>
              <h4 class="text-lg font-medium mb-4">Two Column Layout</h4>
              <div class="bg-white dark:bg-slate-800 p-6 rounded-lg border border-gray-200 dark:border-gray-700">
                <IconList items={sampleIconItems} columns={2} iconColor="secondary" spacing="loose" />
              </div>
            </div>

            <!-- Three Columns -->
            <div>
              <h4 class="text-lg font-medium mb-4">Three Column Layout (Large Screens)</h4>
              <div class="bg-white dark:bg-slate-800 p-6 rounded-lg border border-gray-200 dark:border-gray-700">
                <IconList items={sampleIconItems} columns={3} iconColor="success" size="sm" spacing="normal" />
              </div>
            </div>

            <!-- Code Example -->
            <div>
              <h4 class="text-lg font-medium mb-4">Code Example</h4>
              <div class="bg-gray-900 text-green-400 p-4 rounded-lg overflow-x-auto text-sm">
                <pre><code>{`const items = [
  {
    icon: 'tabler:heart',
    title: 'User Experience',
    description: 'Create delightful user experiences...',
  },
  {
    icon: 'tabler:star', 
    title: 'Performance',
    description: 'Optimized for speed...',
  }
];

<IconList 
  items={items}
  columns={2}
  iconColor="primary"
  spacing="normal"
/>`}</code></pre>
              </div>
            </div>
          </div>
        </div>

        <!-- IconListItemSlot -->
        <div id="icon-list-slots" class="mb-16">
          <h3 class="text-2xl font-semibold text-gray-900 dark:text-white mb-4">IconListItemSlot</h3>
          <p class="text-gray-600 dark:text-gray-400 mb-6">
            Flexible version using slots for custom content. When you need more control over the content structure 
            than the standard IconListItem provides.
          </p>

          <div class="bg-white dark:bg-slate-800 p-6 rounded-lg border border-gray-200 dark:border-gray-700 mb-6">
            <IconListItemSlot icon="tabler:code" title="Custom Content with Slots" iconColor="accent">
              <p class="mb-3 text-gray-600 dark:text-gray-400">
                This component uses slots for maximum flexibility in content structure.
              </p>
              <div class="space-y-2">
                <div class="flex items-center gap-2 text-sm">
                  <span class="w-2 h-2 bg-accent rounded-full"></span>
                  <span>Custom HTML content</span>
                </div>
                <div class="flex items-center gap-2 text-sm">
                  <span class="w-2 h-2 bg-accent rounded-full"></span>
                  <span>Complex layouts and styling</span>
                </div>
                <div class="flex items-center gap-2 text-sm">
                  <span class="w-2 h-2 bg-accent rounded-full"></span>
                  <span>Interactive elements</span>
                </div>
              </div>
            </IconListItemSlot>
          </div>

          <div class="bg-gray-900 text-green-400 p-4 rounded-lg overflow-x-auto text-sm">
            <pre><code>{`<IconListItemSlot 
  icon="tabler:code" 
  title="Custom Content" 
  iconColor="accent"
>
  <p>Your custom content here...</p>
  <ul class="space-y-2">
    <li>• Custom bullet points</li>
    <li>• Complex layouts</li>
  </ul>
</IconListItemSlot>`}</code></pre>
          </div>
        </div>

        <!-- Sub-bullets Components -->
        <div id="icon-list-sub-bullets" class="mb-16">
          <h3 class="text-2xl font-semibold text-gray-900 dark:text-white mb-4">Components with Sub-bullets</h3>
          <p class="text-gray-600 dark:text-gray-400 mb-6">
            Specialized components for hierarchical content with main points and supporting sub-points. 
            Available in multiple bullet styles for different design needs.
          </p>

          <div class="space-y-8">
            <!-- Single Item with Sub-bullets -->
            <div>
              <h4 class="text-lg font-medium mb-4">IconListItemWithSubBullets</h4>
              <div class="bg-white dark:bg-slate-800 p-6 rounded-lg border border-gray-200 dark:border-gray-700">
                <IconListItemWithSubBullets
                  icon="tabler:seedling"
                  title="Business Growth Strategy"
                  description="Comprehensive approach to scaling your business:"
                  iconColor="primary"
                  subBulletStyle="bullet"
                  subBullets={[
                    { text: 'Market research and competitive analysis to identify opportunities' },
                    { text: 'Customer acquisition strategies tailored to your target audience' },
                    { text: 'Revenue optimization and growth metrics tracking' },
                  ]}
                />
              </div>
            </div>

            <!-- Different Bullet Styles -->
            <div>
              <h4 class="text-lg font-medium mb-4">Bullet Style Variations</h4>
              <div class="grid lg:grid-cols-3 gap-6">
                <div class="bg-white dark:bg-slate-800 p-4 rounded-lg border border-gray-200 dark:border-gray-700">
                  <h5 class="text-sm font-semibold mb-3 text-gray-700 dark:text-gray-300">Bullet Style</h5>
                  <IconListItemWithSubBullets
                    icon="tabler:list"
                    title="Traditional Bullets"
                    description="Standard bullet points:"
                    iconColor="primary"
                    size="sm"
                    subBulletStyle="bullet"
                    subBullets={[
                      { text: 'Standard bullet point' },
                      { text: 'Another bullet point' },
                    ]}
                  />
                </div>

                <div class="bg-white dark:bg-slate-800 p-4 rounded-lg border border-gray-200 dark:border-gray-700">
                  <h5 class="text-sm font-semibold mb-3 text-gray-700 dark:text-gray-300">Icon Style</h5>
