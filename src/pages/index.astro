---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import { fetchPosts } from '~/utils/blog';
import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';
import Image from '~/components/common/Image.astro';

const metadata = {
  title: "Steven's Dev Blog",
  description:
    '20 years of side projects, game dev experiments, and digital Legos. A developer\'s journey through tinkering, learning, and occasionally shipping.',
  ignoreTitleTemplate: true,
};

const posts = await fetchPosts();
const featuredPost = posts[0];
const recentPosts = posts.slice(1);
---

<PageLayout metadata={metadata}>
  <!-- Hero Section -->
  <section class="relative py-12 md:py-20 px-4 sm:px-6">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-6">
        Programming is <span class="text-primary">Digital Legos</span>
      </h1>
      <p class="text-xl md:text-2xl text-muted max-w-2xl mx-auto mb-8">
        20 years of side projects, game dev experiments, tax crusades, and AI acceleration.
        A developer's journey through tinkering, learning, and occasionally shipping.
      </p>
      <div class="flex flex-wrap justify-center gap-4 text-sm text-muted">
        <span class="flex items-center gap-2">
          <span class="w-2 h-2 bg-primary rounded-full"></span>
          React Native by day
        </span>
        <span class="flex items-center gap-2">
          <span class="w-2 h-2 bg-accent rounded-full"></span>
          Game dev by night
        </span>
        <span class="flex items-center gap-2">
          <span class="w-2 h-2 bg-secondary rounded-full"></span>
          Father of 3
        </span>
      </div>
    </div>
  </section>

  <!-- Featured Post -->
  {featuredPost && (
    <section class="py-8 px-4 sm:px-6">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-sm font-semibold text-primary uppercase tracking-wider mb-6">Latest Post</h2>
        <article class="group relative bg-muted/30 rounded-2xl overflow-hidden">
          {featuredPost.image && (
            <div class="aspect-[2/1] overflow-hidden">
              <Image
                src={featuredPost.image}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                widths={[400, 800, 1200]}
                sizes="(max-width: 768px) 100vw, 800px"
                alt={featuredPost.title}
                width={1200}
                height={600}
                loading="eager"
              />
            </div>
          )}
          <div class="p-6 md:p-8">
            <div class="flex flex-wrap items-center gap-3 text-sm text-muted mb-3">
              <time datetime={String(featuredPost.publishDate)}>{getFormattedDate(featuredPost.publishDate)}</time>
              {featuredPost.category && (
                <>
                  <span>·</span>
                  <span class="text-primary font-medium capitalize">{featuredPost.category.title}</span>
                </>
              )}
              {featuredPost.readingTime && (
                <>
                  <span>·</span>
                  <span>{Math.ceil(featuredPost.readingTime)} min read</span>
                </>
              )}
            </div>
            <h3 class="text-2xl md:text-3xl font-bold mb-3">
              <a href={getPermalink(featuredPost.permalink, 'post')} class="hover:text-primary transition-colors">
                {featuredPost.title}
              </a>
            </h3>
            {featuredPost.excerpt && (
              <p class="text-muted text-lg mb-4">{featuredPost.excerpt}</p>
            )}
            <a
              href={getPermalink(featuredPost.permalink, 'post')}
              class="inline-flex items-center gap-2 text-primary font-medium hover:underline"
            >
              Read more
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
            </a>
          </div>
        </article>
      </div>
    </section>
  )}

  <!-- All Posts -->
  <section class="py-12 px-4 sm:px-6">
    <div class="max-w-4xl mx-auto">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl font-bold">All Posts</h2>
        <a href="/blog" class="text-primary hover:underline text-sm font-medium">View all →</a>
      </div>
      <div class="grid gap-8">
        {recentPosts.map((post) => (
          <article class="group flex flex-col md:flex-row gap-6 pb-8 border-b border-border last:border-0">
            {post.image && (
              <a href={getPermalink(post.permalink, 'post')} class="shrink-0">
                <Image
                  src={post.image}
                  class="w-full md:w-48 h-48 object-cover rounded-lg bg-muted group-hover:opacity-90 transition-opacity"
                  widths={[200, 400]}
                  sizes="(max-width: 768px) 100vw, 200px"
                  alt={post.title}
                  width={200}
                  height={200}
                  loading="lazy"
                />
              </a>
            )}
            <div class="flex flex-col justify-center">
              <div class="flex flex-wrap items-center gap-2 text-sm text-muted mb-2">
                <time datetime={String(post.publishDate)}>{getFormattedDate(post.publishDate)}</time>
                {post.category && (
                  <>
                    <span>·</span>
                    <span class="text-primary font-medium capitalize">{post.category.title}</span>
                  </>
                )}
                {post.readingTime && (
                  <>
                    <span>·</span>
                    <span>{Math.ceil(post.readingTime)} min read</span>
                  </>
                )}
              </div>
              <h3 class="text-xl font-bold mb-2">
                <a href={getPermalink(post.permalink, 'post')} class="hover:text-primary transition-colors">
                  {post.title}
                </a>
              </h3>
              {post.excerpt && (
                <p class="text-muted line-clamp-2">{post.excerpt}</p>
              )}
              {post.tags && post.tags.length > 0 && (
                <div class="flex flex-wrap gap-1 mt-3">
                  {post.tags.slice(0, 3).map((tag) => (
                    <span class="text-xs font-medium text-muted bg-muted/50 px-2 py-1 rounded">
                      #{tag.title}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section class="py-12 px-4 sm:px-6 border-t border-border">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-2xl font-bold mb-4">About This Blog</h2>
      <p class="text-muted max-w-2xl mx-auto mb-6">
        I'm Steven, a React Native developer by day working in fintech at a Fortune 500 company.
        By night (and weekends, and naptime), I tinker with game dev, home automation,
        developer tools, and whatever else catches my curiosity. This blog is a retrospective
        of 20 years of side projects: the wins, the abandoned repos, and everything in between.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/about" class="text-primary hover:underline font-medium">Learn more about me →</a>
      </div>
    </div>
  </section>
</PageLayout>
