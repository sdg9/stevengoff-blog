---
import PageLayout from '~/layouts/PageLayout.astro';

// import Header from '~/components/widgets/Header.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Features from '~/components/widgets/Features.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import Steps from '~/components/widgets/Steps.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Contact from '~/components/widgets/Contact.astro';
// import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Professional Counseling Services - Mental Health Support',
  description:
    'Compassionate, professional counseling services for individuals, couples, and families. Start your journey to better mental health with experienced therapists.',
  ignoreTitleTemplate: true,
};
---

<PageLayout metadata={metadata}>
  <!-- <Fragment slot="announcement"></Fragment>
  <Fragment slot="header">
    <Header
      links={[
        { text: 'Home', href: '#' },
        { text: 'About', href: '#about' },
        { text: 'Services', href: '#services' },
        { text: 'Approach', href: '#approach' },
        { text: 'Testimonials', href: '#testimonials' },
        { text: 'FAQ', href: '#faq' },
        { text: 'Contact', href: '#contact' },
      ]}
      actions={[
        {
          text: 'Book Consultation',
          href: '#contact',
          variant: 'primary',
        },
      ]}
      isSticky
      showToggleTheme
    />
  </Fragment> -->

  <!-- Hero Widget ******************* -->

  <Hero
    id="hero"
    title="Find Your Path to Healing"
    tagline="Professional Counseling Services"
    actions={[
      { variant: 'primary', text: 'Schedule Consultation', href: '#contact' },
      { text: 'Learn More', href: '#about' },
    ]}
  >
    <Fragment slot="subtitle">
      Welcome to a safe space where healing begins. Our experienced therapists provide compassionate, evidence-based
      counseling to help you navigate life's challenges and discover your inner strength.
      <br /><br />
      <span class="text-sm font-medium">✓ Licensed Professional Counselors</span> •
      <span class="text-sm font-medium">✓ Confidential & Safe Environment</span> •
      <span class="text-sm font-medium">✓ Flexible Scheduling</span>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0">
        <img
          class="w-full h-full object-cover"
          src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1920&h=1080&q=80"
          alt="Peaceful counseling environment"
        />
        <div class="absolute inset-0 bg-gray-900/60"></div>
      </div>
    </Fragment>
  </Hero>

  <!-- Content Widget **************** -->

  <Content
    id="about"
    tagline="About Our Practice"
    title="Your Mental Health Journey Starts Here"
    items={[
      {
        title: 'Compassionate Care',
        description: 'We believe in meeting you where you are with empathy and understanding.',
      },
      {
        title: 'Evidence-Based Therapy',
        description: 'Our approaches are grounded in proven therapeutic methods and research.',
      },
      {
        title: 'Personalized Treatment',
        description: 'Every treatment plan is tailored to your unique needs and goals.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1559757148-5c350d0d3c56?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1000&q=80',
      alt: 'Therapist consultation',
      loading: 'eager',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Creating a Safe Space for Healing
      </h2>
      <p>
        Our practice is built on the foundation that everyone deserves access to quality mental health care. We
        understand that taking the first step can be difficult, which is why we've created a welcoming, non-judgmental
        environment where you can feel safe to explore your thoughts and emotions.
      </p>
      <br />
      <p>
        With over 15 years of combined experience, our team of licensed therapists specializes in a wide range of mental
        health concerns, using proven therapeutic techniques to help you achieve lasting positive change.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-slate-800"></div>
    </Fragment>
  </Content>

  <!-- Features Widget *************** -->

  <Features
    id="services"
    tagline="Our Services"
    title="Comprehensive Mental Health Support"
    subtitle="We offer a full range of counseling services to meet your unique needs"
    items={[
      {
        title: 'Individual Therapy',
        description: 'One-on-one sessions focused on your personal growth and healing journey.',
        icon: 'tabler:user',
      },
      {
        title: 'Couples Counseling',
        description: 'Strengthen your relationship through improved communication and understanding.',
        icon: 'tabler:heart-handshake',
      },
      {
        title: 'Family Therapy',
        description: 'Heal family dynamics and improve relationships within your family system.',
        icon: 'tabler:home-heart',
      },
      {
        title: 'Group Therapy',
        description: 'Connect with others facing similar challenges in a supportive group setting.',
        icon: 'tabler:users',
      },
      {
        title: 'Trauma Recovery',
        description: 'Specialized care for those healing from traumatic experiences using EMDR and other methods.',
        icon: 'tabler:shield-heart',
      },
      {
        title: 'Anxiety & Depression',
        description: 'Evidence-based treatments for anxiety disorders and depression management.',
        icon: 'tabler:brain',
      },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    id="approach"
    title="Our Therapeutic Approach"
    subtitle="We integrate multiple evidence-based therapeutic modalities to provide you with the most effective treatment"
    columns={3}
    items={[
      {
        title: 'Cognitive Behavioral Therapy (CBT)',
        description: 'Transform negative thought patterns and behaviors that impact your daily life.',
        icon: 'tabler:brain',
      },
      {
        title: 'Dialectical Behavior Therapy (DBT)',
        description: 'Learn mindfulness and emotional regulation skills for better life management.',
        icon: 'tabler:leaf',
      },
      {
        title: 'EMDR Therapy',
        description: 'Process traumatic memories through guided eye movements and bilateral stimulation.',
        icon: 'tabler:eye',
      },
      {
        title: 'Solution-Focused Brief Therapy',
        description: 'Goal-oriented approach focusing on solutions rather than problems.',
        icon: 'tabler:target',
      },
      {
        title: 'Mindfulness-Based Interventions',
        description: 'Cultivate present-moment awareness and reduce stress through mindfulness practices.',
        icon: 'tabler:yin-yang',
      },
      {
        title: 'Humanistic Approach',
        description: 'Client-centered therapy that honors your inherent capacity for growth and healing.',
        icon: 'tabler:heart',
      },
    ]}
  />

  <!-- Steps Widget ****************** -->

  <Steps
    title="Getting Started is Simple"
    items={[
      {
        title: 'Step 1: <span class="font-medium">Initial Contact</span>',
        description:
          "Reach out to us via phone, email, or our online form. We'll discuss your needs and answer any questions.",
        icon: 'tabler:phone',
      },
      {
        title: 'Step 2: <span class="font-medium">Free Consultation</span>',
        description: "Schedule a brief consultation to determine if we're a good fit and discuss treatment options.",
        icon: 'tabler:calendar',
      },
      {
        title: 'Step 3: <span class="font-medium">First Appointment</span>',
        description: 'Begin your therapeutic journey with a comprehensive assessment and goal setting session.',
        icon: 'tabler:clipboard',
      },
      {
        title: 'Step 4: <span class="font-medium">Ongoing Support</span>',
        description: 'Continue with regular sessions as we work together toward your mental health goals.',
        icon: 'tabler:growth',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1516627145497-ae56461c2c94?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1000&q=80',
      alt: 'Steps to mental wellness',
    }}
  />

  <!-- Testimonials Widget *********** -->

  <Testimonials
    id="testimonials"
    title="What Our Clients Say"
    subtitle="Real stories of healing and growth from our community"
    testimonials={[
      {
        testimonial: `The support I received here changed my life. The therapist created such a safe space where I could finally open up about my anxiety. I learned practical tools that I use every day.`,
        name: 'Sarah M.',
        job: 'Marketing Professional',
        image: {
          src: 'https://images.unsplash.com/photo-1619734086067-24bf8889ea7d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1000&q=80',
          alt: 'Sarah M.',
        },
      },
      {
        testimonial: `Couples counseling saved our marriage. We learned how to communicate effectively and work through our differences. We're stronger than ever now.`,
        name: 'Mike & Lisa K.',
        job: 'Married 12 Years',
        image: {
          src: 'https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1000&q=80',
          alt: 'Mike and Lisa K.',
        },
      },
      {
        testimonial: `After years of struggling with depression, I finally found hope again. The therapist's approach was exactly what I needed. I'm grateful for this journey.`,
        name: 'David R.',
        job: 'Teacher',
        image: {
          src: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1000&q=80',
          alt: 'David R.',
        },
      },
    ]}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    id="faq"
    title="Frequently Asked Questions"
    subtitle="Common questions about our counseling services"
    tagline="FAQ"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'How do I know if counseling is right for me?',
        description:
          "If you're experiencing emotional distress, relationship difficulties, life transitions, or simply want to grow personally, counseling can be beneficial. Many people find it helpful even when they're functioning well but want additional support.",
      },
      {
        title: 'What can I expect in my first session?',
        description:
          "Your first session will focus on getting to know you and understanding your concerns. We'll discuss your goals, history, and what brought you to therapy. This helps us create a personalized treatment plan together.",
      },
      {
        title: 'How long does therapy typically take?',
        description:
          "The duration of therapy varies depending on your individual needs and goals. Some people benefit from short-term therapy (8-12 sessions), while others prefer longer-term support. We'll regularly check in about your progress.",
      },
      {
        title: 'Do you accept insurance?',
        description:
          'We accept most major insurance plans. We also offer sliding scale fees for those who qualify. Our staff can help verify your benefits and explain your coverage before your first appointment.',
      },
      {
        title: 'Is everything I share completely confidential?',
        description:
          "Yes, confidentiality is fundamental to therapy. What you share is protected by law, with very limited exceptions (such as imminent danger to self or others). We'll explain these boundaries clearly during your first visit.",
      },
      {
        title: 'Do you offer online therapy sessions?',
        description:
          'Yes, we offer secure video therapy sessions for your convenience. Online therapy can be just as effective as in-person sessions and provides flexibility for busy schedules or those who prefer meeting from home.',
      },
    ]}
  />

  <!-- Contact Widget **************** -->

  <Contact
    id="contact"
    title="Ready to Begin Your Journey?"
    subtitle="Take the first step toward better mental health today"
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Name',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email',
      },
      {
        type: 'tel',
        name: 'phone',
        label: 'Phone',
      },
    ]}
    textarea={{
      label: 'How can we help you?',
      name: 'message',
      placeholder: 'Tell us briefly about what brings you to counseling or any questions you have...',
    }}
    disclaimer={{
      label:
        'By submitting this form, you agree to our privacy policy and understand that this is not a crisis hotline. For immediate assistance, please call 988 (Suicide & Crisis Lifeline) or 911.',
    }}
    description="We'll respond to your message within 24 hours. All communications are confidential."
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    title="Don't Wait – Your Mental Health Matters"
    subtitle="Every journey begins with a single step. Let us walk alongside you toward healing and growth."
    actions={[
      {
        variant: 'primary',
        text: 'Schedule Consultation',
        href: '#contact',
      },
      {
        variant: 'secondary',
        text: 'Call Us: (555) 123-HELP',
        href: 'tel:+15551234357',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-900 dark:bg-transparent"></div>
    </Fragment>
  </CallToAction>
</PageLayout>
