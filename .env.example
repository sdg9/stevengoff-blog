# Sentry Configuration
# For error tracking and monitoring
# Get DSN from: https://sentry.io/settings/projects/
PUBLIC_SENTRY_DSN=your_sentry_dsn_here

# Sentry Auth Token (for source map uploads during builds)
# Generate at: https://sentry.io/settings/account/api/auth-tokens/
# Requires: project:releases, project:write, org:read scopes
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here
